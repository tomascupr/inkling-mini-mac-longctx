+        return
+    for entry in prompt_cache:
+        subs = getattr(entry, "caches", None)
+        for c in subs if subs is not None else [entry]:
+            if type(c) is cache.KVCache:
+                c.reserve_tokens = int(c.offset) + int(new_tokens)
