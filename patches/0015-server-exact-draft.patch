+def _full_rings(prompt_cache):
+    """Sliding-window caches left in concat layout by a multi-token prompt chunk,
+    as fixed full rings (what one-token decode leaves): same keys, temporal order."""
+    arrays = []
+    for entry in prompt_cache:
+        subs = getattr(entry, "caches", None)
+        for c in subs if subs is not None else [entry]:
+            if (
+                type(c) is cache.RotatingKVCache
+                and c.keys is not None
+                and c.keep == 0
+                and c.offset >= c.max_size
+                and c.keys.shape[2] != c.max_size
+            ):
+                keys = c._temporal_order(c.keys)[..., -c.max_size :, :]
+                values = c._temporal_order(c.values)[..., -c.max_size :, :]
+                c.keys, c.values = mx.contiguous(keys), mx.contiguous(values)
+                c._idx = c.max_size
+                arrays.extend((c.keys, c.values))
+    if arrays:
+        mx.eval(*arrays)
+
