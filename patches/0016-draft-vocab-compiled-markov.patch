+    def _markov_subset_fn(self, count, dtype, token_dtype):
+        head, cap = self.markov_head, self.config.final_logit_softcapping
+
+        def run(base, context, anchor, ids, w, fw, fb):
+            rank = head.markov_w1.weight.shape[1]
+            state = mx.zeros((1, rank), dtype)
+            previous, tokens, confs = anchor, [], []
+            for i in range(count):
+                inputs = mx.concatenate([state, head.markov_w1(previous)], axis=-1)
+                raw = (
+                    inputs.astype(mx.float32)
+                    @ head.rnn_proj.weight[:, : 2 * rank].astype(mx.float32).T
+                    + context[:, i]
+                ).astype(dtype)
+                gate, candidate, output = mx.split(raw, 3, axis=-1)
+                gate = mx.sigmoid(gate.astype(mx.float32)).astype(dtype)
+                candidate = mx.tanh(candidate.astype(mx.float32)).astype(dtype)
+                state = gate * state + (1 - gate) * candidate
+                latent = mx.tanh(output.astype(mx.float32)).astype(dtype)
+                logits = base[:, i] + mx.addmm(fb, latent, fw.T)
+                if cap:
+                    logits = (cap * mx.tanh(logits.astype(mx.float32) / cap)).astype(dtype)
+                j = mx.argmax(logits, axis=-1)
