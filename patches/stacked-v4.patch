diff -ruN a/mlx_vlm/models/inkling2/fast_decode.py b/mlx_vlm/models/inkling2/fast_decode.py
--- a/mlx_vlm/models/inkling2/fast_decode.py	1970-01-01 01:00:00
+++ b/mlx_vlm/models/inkling2/fast_decode.py	2026-11-22 03:20:34
@@ -0,0 +1,233 @@
+"""One compiled graph per single-token decode step (Inkling 2 / 2-loop).
+
+The eager decode step builds ~13k lazy nodes in Python (~5 ms) and encodes
+~7k kernels per token. Compiling the whole step removes the Python graph build
+and fuses the elementwise glue into fewer kernels. The step reads functional
+views of the caches (step_cache.py), so its shapes are constant and its trace is
+reused for every token; the caches' Python objects are updated afterwards.
+
+The step runs the model's own decode code on the same inputs, so it performs
+the same operations in the same order; it is used only where the eager path
+would take the same branches: every global cache already holds at least
+_DECODE_KERNEL_MIN_KEYS - 1 keys and has room for one more, and every sliding
+ring is full.
+"""
+
+import os
+
+import mlx.core as mx
+
+from ..cache import ArraysCache, CacheList, KVCache, RotatingKVCache
+from .step_cache import StepConvCache, StepKVCache, StepRotatingKVCache
+
+_ENABLED = os.environ.get("MLX_VLM_INKLING2_COMPILED_DECODE", "1") == "1"
+_PREP = set(
+    os.environ.get(
+        "MLX_VLM_INKLING2_DECODE_PREP", "precast,gatestack,factor,catproj"
+    ).split(",")
+)
+_FUSED = ("q_proj", "r_proj", "gate_proj", "k_proj", "v_proj")
+_MESSAGE_GATES = ("q_message_gate", "k_message_gate", "v_message_gate", "mlp_message_gate")
+
+
+def prepare_decode(lm):
+    """One-time weight layout for decode. Changes no value that is computed:
+    - FP32 copies of the router and loop-gate weights that every step casts
+      to FP32 anyway (the casts become no-ops);
+    - the q, k and v message gates of each loop layer stacked, each gate's
+      weights a view of its slice (one batched chain per decode visit);
+    - the NVFP4 experts' per-expert kernel factor, stored once;
+    - the same-input attention projections stored as one row-wise
+      concatenation, each projection's weight a view of its rows (memory is
+      unchanged; Attention._decode_projections reads them in one GEMV)."""
+    import mlx.nn as nn
+
+    if lm.__dict__.get("_decode_prepared"):
+        return
+    lm.__dict__["_decode_prepared"] = True
+    for layer in lm.model.layers:
+        attn, moe = layer.self_attn, layer.mlp
+        new = []
+        if "precast" in _PREP:
+            if moe.gate_weight.dtype != mx.float32:
+                moe.gate_weight = moe.gate_weight.astype(mx.float32)
+                new.append(moe.gate_weight)
+            for name in _MESSAGE_GATES:
+                gate = getattr(layer, name, None)
+                if gate is None:
+                    continue
+                for proj in (gate.forget_gate_proj, gate.message_gate_proj):
+                    if proj.weight.dtype != mx.float32:
+                        proj.weight = proj.weight.astype(mx.float32)
+                        new.append(proj.weight)
+        gates = [getattr(layer, n, None) for n in _MESSAGE_GATES[:3]]
+        if (
+            "gatestack" in _PREP
+            and all(g is not None for g in gates)
+            and layer.__dict__.get("_qkv_gate_stack") is None
+            and all(
+                type(p) is nn.Linear
+                and "bias" not in p
+                and (p is g.down_proj or p.weight.dtype == mx.float32)
+                for g in gates
+                for p in (g.down_proj, g.forget_gate_proj, g.message_gate_proj)
+            )
+        ):
+            # The q, k and v gates of a loop layer as stacked weights
+            # (each gate's weight a view of its slice: memory unchanged).
+            stack = []
+            for attr in ("down_proj", "forget_gate_proj", "message_gate_proj"):
+                stacked = mx.stack([g[attr].weight for g in gates])
+                mx.eval(stacked)
+                for i, g in enumerate(gates):
+                    g[attr].weight = stacked[i]
+                    new.append(g[attr].weight)
+                stack.append(stacked)
+            layer.__dict__["_qkv_gate_stack"] = tuple(stack)
+        if "factor" in _PREP:
+            for name in ("gate_proj", "up_proj", "down_proj"):
+                proj = getattr(moe.switch_mlp, name)
+                if hasattr(proj, "decode_factor"):
+                    proj.decode_factor()
+        if (
+            "catproj" in _PREP
+            and attn.sharding_group is None
+            and attn.__dict__.get("_fused_qrgkv") is None
+            and all(
+                type(attn[n]) is nn.Linear and "bias" not in attn[n] for n in _FUSED
+            )
+        ):
+            weights = [attn[n].weight for n in _FUSED]
+            if len({(w.dtype, w.shape[1]) for w in weights}) == 1:
+                fused = mx.concatenate(weights, axis=0)
+                mx.eval(fused)
+                start = 0
+                for n, w in zip(_FUSED, weights):
+                    attn[n].weight = fused[start : start + w.shape[0]]
+                    new.append(attn[n].weight)
+                    start += w.shape[0]
+                attn.__dict__["_fused_qrgkv"] = fused
+                del weights
+        mx.eval(new)
+    mx.clear_cache()
+
+
+def _layout(cache):
+    """(kind, ...) per cache entry, or None if the compiled step can't serve it."""
+    from .language import _DECODE_KERNEL_MIN_KEYS
+
+    kinds, offset, idx = [], None, None
+    for entry in cache:
+        if type(entry) is not CacheList or len(entry.caches) != 2:
+            return None
+        kv, conv = entry.caches
+        if type(conv) is not ArraysCache or any(
+            getattr(conv, a, None) is not None for a in ("left_padding", "lengths")
+        ):
+            return None
+        if getattr(conv, "_speculation", None) is not None or any(
+            s is None for s in conv.cache
+        ):
+            return None
+        if type(kv) is KVCache:
+            if kv.keys is None or kv.offset + 1 > kv.keys.shape[2]:
+                return None
+            if kv.offset + 1 < _DECODE_KERNEL_MIN_KEYS:
+                return None
+            if offset is None:
+                offset = kv.offset
+            elif kv.offset != offset:
+                return None
+            kinds.append("g")
+        elif type(kv) is RotatingKVCache:
+            if (
+                kv.keys is None
+                or kv.keep != 0
+                or kv.offset < kv.max_size
+                or kv.keys.shape[2] != kv.max_size
+            ):
+                return None
+            if idx is None:
+                idx = kv._idx
+            elif kv._idx != idx:
+                return None
+            kinds.append("r")
+        else:
+            return None
+    if offset is None or idx is None:
+        return None
+    return tuple(kinds), offset, idx
+
+
+class CompiledDecoder:
+    def __init__(self, lm):
+        self.lm = lm
+        self.kinds = None
+        prepare_decode(lm)
+        self.fn = mx.compile(self._step)
+
+    def _step(self, token, offset, idx, *states):
+        caches, n = [], 0
+        for kind in self.kinds:
+            k, v, c0, c1, c2, c3 = states[n : n + 6]
+            n += 6
+            if kind == "g":
+                kv = StepKVCache(k, v, offset)
+            else:
+                kv = StepRotatingKVCache(k, v, idx, k.shape[2])
+            caches.append((kv, StepConvCache((c0, c1, c2, c3))))
+        out = self.lm(token, cache=caches, logits_to_keep=1)
+        logits = out.logits[:, -1, :]
+        logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+        y = mx.argmax(logprobs, axis=-1)
+        new = []
+        for kv, conv in caches:
+            new += [kv.keys, kv.values, *conv.cache]
+        return (y, logprobs, *new)
+
+    def __call__(self, token, cache):
+        """(y, logprobs) for one token, updating `cache`; None if not served."""
+        layout = _layout(cache)
+        if layout is None:
+            return None
+        kinds, offset, idx = layout
+        if self.kinds is None:
+            self.kinds = kinds
+        elif self.kinds != kinds:
+            return None
+        states = []
+        for entry in cache:
+            kv, conv = entry.caches
+            states += [kv.keys, kv.values, *conv.cache]
+            # Drop the cache's references so the in-place updates can donate
+            # the old buffers instead of copying them.
+            kv.keys = kv.values = None
+        outs = self.fn(
+            token,
+            mx.array(offset, dtype=mx.int32),
+            mx.array(idx, dtype=mx.int32),
+            *states,
+        )
+        del states
+        y, logprobs, new = outs[0], outs[1], outs[2:]
+        for i, entry in enumerate(cache):
+            kv, conv = entry.caches
+            k, v, *cs = new[6 * i : 6 * i + 6]
+            kv.keys, kv.values = k, v
+            kv.offset += 1
+            if type(kv) is RotatingKVCache:
+                kv._idx = (0 if kv._idx == kv.max_size else kv._idx) + 1
+            for j, s in enumerate(cs):
+                conv.cache[j] = s
+        return y, logprobs
+
+
+def compiled_decode(lm, token, cache):
+    """Serve one greedy decode step through the compiled graph, or None."""
+    if not _ENABLED:
+        return None
+    dec = lm.__dict__.get("_compiled_decoder")
+    if dec is None:
+        dec = CompiledDecoder(lm)
+        lm.__dict__["_compiled_decoder"] = dec
+    return dec(token, cache)
