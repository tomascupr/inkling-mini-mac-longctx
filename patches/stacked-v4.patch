+        inputs=[x, x if weight is None else weight, mx.array(eps, mx.float32)],
+        template=[("I", x.dtype), ("O", dtype), ("D", d), ("HAS_W", weight is not None)],
+        grid=(rows * (d // 4), 1, 1),
+        threadgroup=(d // 4, 1, 1),
+        output_shapes=[x.shape],
+        output_dtypes=[dtype],
+    )[0]
+
