+@lru_cache(maxsize=1)
+def _short_convolution_step():
+    return mx.fast.metal_kernel(
+        name="inkling2_short_convolution_step",
+        input_names=["state", "weight", "x", "divisor"],
+        output_names=["out", "next_state"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        uint i = thread_position_in_grid.x;
+        int B = x_shape[0], C = x_shape[2];
+        if (i >= B * C) return;
+        int c = i % C, b = i / C;
+        // inkling2_virtual_short_convolution's arithmetic for one unmasked token.
+        float value = 0;
+        for (int j = 0; j < W; ++j) {
+            int p = j - W + 1;
+            float xv = p < 0
+                ? float(state[b * state_strides[0] + (p + W - 1) * state_strides[1]
+                              + c * state_strides[2]])
