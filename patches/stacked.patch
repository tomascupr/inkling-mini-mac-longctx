+"""Fused single-token MoE kernels for Inkling 2 decode (track B).
+
+One decode token's routed MLP as two kernels instead of ~9:
+  moe_gate_up: the top-k of the router (MLX's ArgPartition is a stable
+      ascending merge sort: the k smallest -(score + bias), ties by index),
+      the route weights, the gate and up projections of the k experts
+      (MLX's fp_qmv arithmetic per row) and the softcapped SwiGLU;
+  moe_down_tail: the down projection of the k experts (same qmv), the route
+      combine and the MLP short convolution with the residual add
+      (kernels.mlp_tail_step's arithmetic).
+Every value is computed with the operations, operands and order of the MLX
+kernels it replaces (verified bitwise by moe_test.py on the model's layers).
+"""
+
+import math
+from functools import lru_cache
+
+import mlx.core as mx
+
+_HEADER = r"""
+struct ink_fp4 {
+  uint8_t bits;
+  operator float16_t() thread {
+    half converted = as_type<half>(ushort((bits & 7) << 9));
+    converted *= 16384.0;
+    return bits & 8 ? -converted : converted;
+  }
+  operator float() thread { return static_cast<float>(this->operator float16_t()); }
+};
+
+struct ink_fp8 {
+  uint8_t bits;
+  operator float16_t() thread {
+    uint16_t v = bits & 127;
+    uint16_t sign_bit = ((uint16_t)((bits >> 7) & 1)) << 15;
+    uint16_t u = (v << 7) | (((v + 1) >> 7) << 14) | sign_bit;
+    half converted = as_type<half>(u);
+    return converted * 256.0;
+  }
+  operator float() thread { return static_cast<float>(this->operator float16_t()); }
+};
+
+struct ink_e8m0 {
+  uint8_t bits;
+  operator float() thread {
+    uint32_t out = (bits == 0 ? 0x400000 : (static_cast<uint16_t>(bits) << 23));
+    return as_type<float>(out);
+  }
+};
+
+template <int bits>
+struct InkDequantize {
+  float operator()(uint8_t x) thread {
+    if constexpr (bits == 8) {
+      ink_fp8 v; v.bits = x; return float(v);
+    } else {
+      ink_fp4 v; v.bits = x; return float(v);
+    }
+  }
+};
+
+template <int group_size>
+static inline float ink_dequantize_scale(uint8_t s) {
+  if constexpr (group_size == 16) {
+    ink_fp8 v; v.bits = s; return float(v);
+  } else {
+    ink_e8m0 v; v.bits = s; return float(v);
+  }
+}
+
+template <typename T, typename U, int values_per_thread>
+inline void ink_load_vector(const device T* x, thread U* x_thread) {
+#pragma unroll
+  for (int i = 0; i < values_per_thread; i++) {
+    x_thread[i] = x[i];
+  }
+}
+
+template <typename T, typename U, int values_per_thread>
+inline void ink_load_vector_safe(const device T* x, thread U* x_thread, int N) {
+  for (int i = 0; i < N; i++) {
+    x_thread[i] = x[i];
+  }
+  for (int i = N; i < values_per_thread; i++) {
+    x_thread[i] = 0;
+  }
+}
+
+// Dequantized values: DQ = 0 converts as MLX does; DQ = 1 reads the same
+// floats from tables filled with that conversion (ink_fill_luts).
+template <int bits, int DQ>
+inline float ink_dq(uint8_t x, threadgroup const float* lut) {
+  if (DQ == 2) {  // timing only: no conversion
+    return float(x & 15);
+  }
+  if (DQ == 1) {
+    return bits == 4 ? lut[x & 15] : lut[16 + x];
+  }
+  return InkDequantize<bits>{}(x);
+}
+
+template <int group_size, int DQ>
+inline float ink_dq_scale(uint8_t s, threadgroup const float* lut) {
+  if (DQ == 1 && group_size == 16) {
+    return lut[16 + s];
+  }
+  return ink_dequantize_scale<group_size>(s);
+}
+
+inline void ink_fill_luts(threadgroup float* lut, uint lid, uint nthreads) {
+  for (uint i = lid; i < 16 + 256; i += nthreads) {
+    lut[i] = i < 16 ? InkDequantize<4>{}(uint8_t(i)) : InkDequantize<8>{}(uint8_t(i - 16));
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+}
+
+template <typename U, int values_per_thread, int bits, int DQ>
+inline U ink_qdot(const device uint8_t* w, const thread U* x_thread, U scale,
+                  threadgroup const float* lut) {
+  U accum = 0;
+  if constexpr (bits == 4) {
+    const device uint16_t* ws = (const device uint16_t*)w;
+    for (int i = 0; i < (values_per_thread / 4); i++) {
+      accum +=
+          (x_thread[4 * i] * ink_dq<4, DQ>(ws[i], lut) +
+           x_thread[4 * i + 1] * ink_dq<4, DQ>(ws[i] >> 4, lut) +
+           x_thread[4 * i + 2] * ink_dq<4, DQ>(ws[i] >> 8, lut) +
+           x_thread[4 * i + 3] * ink_dq<4, DQ>(ws[i] >> 12, lut));
+    }
+  } else {
+    for (int i = 0; i < values_per_thread; i++) {
+      accum += x_thread[i] * ink_dq<8, DQ>(w[i], lut);
+    }
+  }
+  return scale * accum;
+}
+
+template <typename U, int values_per_thread, int bits, int DQ>
+inline U ink_qdot_safe(const device uint8_t* w, const thread U* x_thread, U scale, int N,
+                       threadgroup const float* lut) {
+  U accum = 0;
+  if constexpr (bits == 4) {
+    const device uint16_t* ws = (const device uint16_t*)w;
+    for (int i = 0; i < (N / 4); i++) {
+      accum +=
+          (x_thread[4 * i] * ink_dq<4, DQ>(ws[i], lut) +
+           x_thread[4 * i + 1] * ink_dq<4, DQ>(ws[i] >> 4, lut) +
+           x_thread[4 * i + 2] * ink_dq<4, DQ>(ws[i] >> 8, lut) +
+           x_thread[4 * i + 3] * ink_dq<4, DQ>(ws[i] >> 12, lut));
+    }
+  } else {
+    for (int i = 0; i < N; i++) {
+      accum += x_thread[i] * ink_dq<8, DQ>(w[i], lut);
+    }
+  }
+  return scale * accum;
+}
+
+// MLX's fp_qmv_impl (FAST = 0) / fp_qmv_fast_impl (FAST = 1) accumulation for
+// RPS consecutive rows of one matrix, for one simdgroup: per-lane partial sums
+// before the simd_sum. ws/sc point at the first row (bytes / scales).
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int DQ>
+inline void ink_qmv_rows(
+    const device uint8_t* ws, const device uint8_t* sc, const device T* x,
+    uint lane, thread float* result, threadgroup const float* lut) {
+  constexpr int packs_per_thread = FAST ? 2 : 1;
+  constexpr int pack_factor = 32 / BITS;
+  constexpr int bytes_per_pack = 4;
+  constexpr int values_per_thread = pack_factor * packs_per_thread;
+  constexpr int block_size = values_per_thread * 32;
+  constexpr int scale_step_per_thread = GS / values_per_thread;
+  constexpr int in_vec_size_w = K * bytes_per_pack / pack_factor;
+  constexpr int in_vec_size_g = K / GS;
+  typedef float U;
+  thread U x_thread[values_per_thread];
+  ws += lane * packs_per_thread * bytes_per_pack;
+  sc += lane / scale_step_per_thread;
+  x += lane * values_per_thread;
+  if (FAST) {
+    for (int k = 0; k < K; k += block_size) {
+      ink_load_vector<T, U, values_per_thread>(x, x_thread);
+      for (int row = 0; row < RPS; row++) {
+        auto wl = (const device uint8_t*)(ws + row * in_vec_size_w);
+        const device auto* sl = sc + row * in_vec_size_g;
+        U s = ink_dq_scale<GS, DQ>(sl[0], lut);
+        result[row] += ink_qdot<U, values_per_thread, BITS, DQ>(wl, x_thread, s, lut);
+      }
+      ws += block_size * bytes_per_pack / pack_factor;
+      sc += block_size / GS;
+      x += block_size;
+    }
+  } else {
+    int k = 0;
+    for (; k < K - block_size; k += block_size) {
+      ink_load_vector<T, U, values_per_thread>(x, x_thread);
+      for (int row = 0; row < RPS; row++) {
+        auto wl = (const device uint8_t*)(ws + row * in_vec_size_w);
+        const device auto* sl = sc + row * in_vec_size_g;
+        U s = ink_dq_scale<GS, DQ>(sl[0], lut);
+        result[row] += ink_qdot<U, values_per_thread, BITS, DQ>(wl, x_thread, s, lut);
+      }
+      ws += block_size * bytes_per_pack / pack_factor;
+      sc += block_size / GS;
+      x += block_size;
+    }
+    const int remaining = clamp(
+        static_cast<int>(K - k - lane * values_per_thread), 0, values_per_thread);
+    if (remaining > 0) {
+      ink_load_vector_safe<T, U, values_per_thread>(x, x_thread, remaining);
+      for (int row = 0; row < RPS; row++) {
+        auto wl = (const device uint8_t*)(ws + row * in_vec_size_w);
+        const device auto* sl = sc + row * in_vec_size_g;
+        U s = ink_dq_scale<GS, DQ>(sl[0], lut);
+        result[row] += ink_qdot_safe<U, values_per_thread, BITS, DQ>(wl, x_thread, s, remaining, lut);
+      }
+    }
+  }
+}
+
+// qdot on weight words held in registers (w0, w1: the lane's PACKS 32-bit
+// words of one block): the same values, products and accumulation as ink_qdot
+// (uint16 halves / bytes taken by shifts instead of pointer reads).
+template <int VPT, int BITS, int DQ>
+inline float ink_qdot_reg(uint w0, uint w1, const thread float* x_thread, float scale, int n,
+                          threadgroup const float* lut) {
+  float accum = 0;
+  if constexpr (BITS == 4) {
+    for (int i = 0; i < (n / 4); i++) {
+      const uint wd = (i >> 1) == 0 ? w0 : w1;
+      const uint16_t h = uint16_t(wd >> (16 * (i & 1)));
+      accum +=
+          (x_thread[4 * i] * ink_dq<4, DQ>(h, lut) +
+           x_thread[4 * i + 1] * ink_dq<4, DQ>(h >> 4, lut) +
+           x_thread[4 * i + 2] * ink_dq<4, DQ>(h >> 8, lut) +
+           x_thread[4 * i + 3] * ink_dq<4, DQ>(h >> 12, lut));
+    }
+  } else {
+    for (int i = 0; i < n; i++) {
+      const uint wd = (i >> 2) == 0 ? w0 : w1;
+      accum += x_thread[i] * ink_dq<8, DQ>(uint8_t(wd >> (8 * (i & 3))), lut);
+    }
+  }
+  return scale * accum;
+}
+
+// ink_qmv_rows with all weight words and scale bytes of the RPS rows loaded
+// first (many loads in flight per simdgroup), then the arithmetic of
+// ink_qmv_rows in its order: same lanes, values and per-row accumulation.
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int DQ>
+inline void ink_qmv_rows_pre(
+    const device uint8_t* ws, const device uint8_t* sc, const device T* x,
+    uint lane, thread float* result, threadgroup const float* lut) {
+  constexpr int PACKS = FAST ? 2 : 1;
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF * PACKS;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  // FAST: K / BS blocks. Else MLX's loop runs while k < K - BS, then one
+  // guarded block of `remaining` values per lane.
+  constexpr int NB = FAST ? K / BS : (K - 1) / BS;
+  constexpr int NT = FAST ? NB : NB + 1;
+  constexpr int BW = BS * 4 / PF;
+  constexpr int BG = BS / GS;
+  ws += lane * PACKS * 4;
+  sc += lane / SSTEP;
+  x += lane * VPT;
+  const int remaining = FAST ? VPT : clamp(int(K - NB * BS - int(lane) * VPT), 0, VPT);
+  uint w0[NT][RPS], w1[NT][RPS], sv[NT][RPS];
+#pragma unroll
+  for (int b = 0; b < NT; ++b) {
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + b * BW);
+      const bool live = b < NB || remaining > 0;
+      w0[b][r] = live ? wp[0] : 0u;
+      w1[b][r] = (PACKS == 2 && live) ? wp[1] : 0u;
+      sv[b][r] = live ? uint(sc[r * GROW + b * BG]) : 0u;
+    }
+  }
+  float x_thread[VPT];
+#pragma unroll
+  for (int b = 0; b < NT; ++b) {
+    const bool tail = !FAST && b == NB;
+    if (tail && remaining <= 0) break;
+    if (tail) {
+      ink_load_vector_safe<T, float, VPT>(x + b * BS, x_thread, remaining);
+    } else {
+      ink_load_vector<T, float, VPT>(x + b * BS, x_thread);
+    }
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(uint8_t(sv[b][r]), lut);
+      result[r] += ink_qdot_reg<VPT, BITS, DQ>(w0[b][r], w1[b][r], x_thread, s,
+                                               tail ? remaining : VPT, lut);
+    }
+  }
+}
+
+// ink_qmv_rows_pre without data-dependent control flow: the lanes that
+// hold a guarded (tail) block are known at compile time (K is a template
+// constant and the tail is a whole number of lane groups for these shapes).
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int DQ>
+inline void ink_qmv_rows_pre2(
+    const device uint8_t* ws, const device uint8_t* sc, const device T* x,
+    uint lane, thread float* result, threadgroup const float* lut) {
+  constexpr int PACKS = FAST ? 2 : 1;
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF * PACKS;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  constexpr int NB = FAST ? K / BS : (K - 1) / BS;
+  constexpr int TAILV = FAST ? 0 : K - NB * BS;
+  static_assert(TAILV % VPT == 0, "tail must be whole lane groups");
+  constexpr int TAIL_LANES = TAILV / VPT;
+  constexpr int BW = BS * 4 / PF;
+  constexpr int BG = BS / GS;
+  ws += lane * PACKS * 4;
+  sc += lane / SSTEP;
+  x += lane * VPT;
+  const bool tail_live = TAIL_LANES > 0 && int(lane) < TAIL_LANES;
+  uint w0[NB + 1][RPS], w1[NB + 1][RPS], sv[NB + 1][RPS];
+#pragma unroll
+  for (int b = 0; b < NB; ++b) {
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + b * BW);
+      w0[b][r] = wp[0];
+      w1[b][r] = PACKS == 2 ? wp[1] : 0u;
+      sv[b][r] = uint(sc[r * GROW + b * BG]);
+    }
+  }
+  if (TAIL_LANES > 0) {
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + NB * BW);
+      w0[NB][r] = tail_live ? wp[0] : 0u;
+      w1[NB][r] = (PACKS == 2 && tail_live) ? wp[1] : 0u;
+      sv[NB][r] = tail_live ? uint(sc[r * GROW + NB * BG]) : 0u;
+    }
+  }
+  float x_thread[VPT];
+#pragma unroll
+  for (int b = 0; b < NB; ++b) {
+    ink_load_vector<T, float, VPT>(x + b * BS, x_thread);
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(uint8_t(sv[b][r]), lut);
+      result[r] += ink_qdot_reg<VPT, BITS, DQ>(w0[b][r], w1[b][r], x_thread, s, VPT, lut);
+    }
+  }
+  if (tail_live) {
+    ink_load_vector<T, float, VPT>(x + NB * BS, x_thread);
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(uint8_t(sv[NB][r]), lut);
+      result[r] += ink_qdot_reg<VPT, BITS, DQ>(w0[NB][r], w1[NB][r], x_thread, s, VPT, lut);
+    }
+  }
+}
+
+// ink_qmv_rows_pre2 hoisting only the weight words (scale bytes are read in
+// the arithmetic loop, as ink_qmv_rows reads them): fewer live registers.
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int DQ>
+inline void ink_qmv_rows_pre3(
+    const device uint8_t* ws, const device uint8_t* sc, const device T* x,
+    uint lane, thread float* result, threadgroup const float* lut) {
+  constexpr int PACKS = FAST ? 2 : 1;
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF * PACKS;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  constexpr int NB = FAST ? K / BS : (K - 1) / BS;
+  constexpr int TAILV = FAST ? 0 : K - NB * BS;
+  static_assert(TAILV % VPT == 0, "tail must be whole lane groups");
+  constexpr int TAIL_LANES = TAILV / VPT;
+  constexpr int BW = BS * 4 / PF;
+  constexpr int BG = BS / GS;
+  ws += lane * PACKS * 4;
+  sc += lane / SSTEP;
+  x += lane * VPT;
+  const bool tail_live = TAIL_LANES > 0 && int(lane) < TAIL_LANES;
+  uint w0[NB + 1][RPS], w1[NB + 1][RPS];
+#pragma unroll
+  for (int b = 0; b < NB; ++b) {
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + b * BW);
+      w0[b][r] = wp[0];
+      w1[b][r] = PACKS == 2 ? wp[1] : 0u;
+    }
+  }
+  if (TAIL_LANES > 0) {
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + NB * BW);
+      w0[NB][r] = tail_live ? wp[0] : 0u;
+      w1[NB][r] = (PACKS == 2 && tail_live) ? wp[1] : 0u;
+    }
+  }
+  float x_thread[VPT];
+#pragma unroll
+  for (int b = 0; b < NB; ++b) {
+    ink_load_vector<T, float, VPT>(x + b * BS, x_thread);
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(sc[r * GROW + b * BG], lut);
+      result[r] += ink_qdot_reg<VPT, BITS, DQ>(w0[b][r], w1[b][r], x_thread, s, VPT, lut);
+    }
+  }
+  if (tail_live) {
+    ink_load_vector<T, float, VPT>(x + NB * BS, x_thread);
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(sc[r * GROW + NB * BG], lut);
+      result[r] += ink_qdot_reg<VPT, BITS, DQ>(w0[NB][r], w1[NB][r], x_thread, s, VPT, lut);
+    }
+  }
+}
+
+// Gate and up rows together with every weight word of both matrices loaded
+// before any arithmetic (like the fast pure-load pattern); the arithmetic of
+// each row is ink_qmv_rows' (same lanes, values and order).
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int DQ>
+inline void ink_qmv_gu_pre(
+    const device uint8_t* wsg, const device uint8_t* scg,
+    const device uint8_t* wsu, const device uint8_t* scu, const device T* x,
+    uint lane, thread float* rg, thread float* ru, threadgroup const float* lut) {
+  constexpr int PACKS = FAST ? 2 : 1;
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF * PACKS;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  constexpr int NB = FAST ? K / BS : (K - 1) / BS;
+  constexpr int TAILV = FAST ? 0 : K - NB * BS;
+  static_assert(TAILV % VPT == 0, "tail must be whole lane groups");
+  constexpr int TAIL_LANES = TAILV / VPT;
+  constexpr int NT = TAIL_LANES > 0 ? NB + 1 : NB;
+  constexpr int BW = BS * 4 / PF;
+  constexpr int BG = BS / GS;
+  wsg += lane * PACKS * 4;
+  wsu += lane * PACKS * 4;
+  scg += lane / SSTEP;
+  scu += lane / SSTEP;
+  x += lane * VPT;
+  const bool tail_live = TAIL_LANES > 0 && int(lane) < TAIL_LANES;
+  uint g0[NT][RPS], g1[NT][RPS], u0[NT][RPS], u1[NT][RPS];
+#pragma unroll
+  for (int b = 0; b < NT; ++b) {
+    const bool live = b < NB || tail_live;
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* gp = (const device uint*)(wsg + r * WROW + b * BW);
+      const device uint* up = (const device uint*)(wsu + r * WROW + b * BW);
+      g0[b][r] = live ? gp[0] : 0u;
+      u0[b][r] = live ? up[0] : 0u;
+      g1[b][r] = (PACKS == 2 && live) ? gp[1] : 0u;
+      u1[b][r] = (PACKS == 2 && live) ? up[1] : 0u;
+    }
+  }
+  float x_thread[VPT];
+#pragma unroll
+  for (int b = 0; b < NT; ++b) {
+    if (b == NB && !tail_live) break;
+    ink_load_vector<T, float, VPT>(x + b * BS, x_thread);
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(scg[r * GROW + b * BG], lut);
+      rg[r] += ink_qdot_reg<VPT, BITS, DQ>(g0[b][r], g1[b][r], x_thread, s, VPT, lut);
+    }
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      float s = ink_dq_scale<GS, DQ>(scu[r * GROW + b * BG], lut);
+      ru[r] += ink_qdot_reg<VPT, BITS, DQ>(u0[b][r], u1[b][r], x_thread, s, VPT, lut);
+    }
+  }
+}
+
+// ink_qmv_rows (non-fast layout) with each row read as contiguous 16-byte
+// vectors (lane j of round c holds the row's words 4 (32 c + j) .. + 3) and
+// every lane's word for block b (word 32 b + lane, MLX's mapping) fetched with
+// a simd_shuffle: the same words reach the same lanes, the arithmetic is
+// ink_qmv_rows'.
+template <typename T, int K, int BITS, int GS, int RPS, int DQ>
+inline void ink_qmv_rows_shfl(
+    const device uint8_t* ws, const device uint8_t* sc, const device T* x,
+    uint lane, thread float* result, threadgroup const float* lut) {
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  constexpr int NB = (K - 1) / BS;
+  constexpr int TAILV = K - NB * BS;
+  static_assert(TAILV % VPT == 0, "tail must be whole lane groups");
+  constexpr int TAIL_LANES = TAILV / VPT;
+  constexpr int NW = WROW / 4;
+  static_assert(NW % 4 == 0, "rows must be whole 16-byte vectors");
+  constexpr int NV4 = NW / 4;
+  constexpr int NCH = (NV4 + 31) / 32;
+  constexpr int BG = BS / GS;
+  sc += lane / SSTEP;
+  x += lane * VPT;
+  uint4 rw[RPS][NCH];
+#pragma unroll
+  for (int r = 0; r < RPS; ++r) {
+    const device uint4* rp = (const device uint4*)(ws + r * WROW);
+#pragma unroll
+    for (int c = 0; c < NCH; ++c) {
+      const int v4 = 32 * c + int(lane);
+      rw[r][c] = v4 < NV4 ? rp[v4] : uint4(0);
+    }
+  }
+  float x_thread[VPT];
+#pragma unroll
+  for (int b = 0; b < NB + (TAIL_LANES > 0 ? 1 : 0); ++b) {
+    const bool tail = b == NB;
+    const bool live = !tail || int(lane) < TAIL_LANES;
+    const int c = b / 4;
+    const ushort src = ushort(8 * (b % 4) + int(lane) / 4);
+    if (live) {
+      ink_load_vector<T, float, VPT>(x + b * BS, x_thread);
+    }
+#pragma unroll
+    for (int r = 0; r < RPS; ++r) {
+      const uint4 v = simd_shuffle(rw[r][c], src);
+      const uint wd = v[lane & 3];
+      if (live) {
+        float s = ink_dq_scale<GS, DQ>(sc[r * GROW + b * BG], lut);
+        result[r] += ink_qdot_reg<VPT, BITS, DQ>(wd, 0u, x_thread, s, VPT, lut);
+      }
+    }
+  }
+}
+
+// MLX's ArgPartition on the GPU: a stable ascending merge sort with NaNs last.
+inline bool ink_less(float a, float b) {
+  bool an = metal::isnan(a);
+  bool bn = metal::isnan(b);
+  if (an | bn) {
+    return (!an) & bn;
+  }
+  return a < b;
+}
+
+// MLX's Sigmoid (unary_ops.h).
+inline float ink_sigmoid(float x) {
+  auto y = 1 / (1 + metal::precise::exp(metal::abs(x)));
+  return (x < 0) ? y : 1 - y;
+}
+"""
