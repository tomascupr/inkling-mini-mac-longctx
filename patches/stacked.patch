diff -ruN a/mlx_vlm/models/inkling2/attn_kernels.py b/mlx_vlm/models/inkling2/attn_kernels.py
--- a/mlx_vlm/models/inkling2/attn_kernels.py	1970-01-01 01:00:00.000000000 +0100
+++ b/mlx_vlm/models/inkling2/attn_kernels.py	2026-11-22 11:11:10.493752680 +0100
@@ -0,0 +1,690 @@
+"""Single-query sliding-window attention for Inkling 2 decode (track B).
+
+MLX's sdpa_vector (sdpa_vector.h, single pass) gives each query head one
+threadgroup of 32 simdgroups; simdgroup s visits keys s, s + 32, ... with an
+online softmax (scores: 4 dims per lane, simd_sum, + the additive bias; the
+sink starts simdgroup 0), then the 32 partial states are merged with
+simd_max / simd_sum across lanes. With 24 heads that is 24 threadgroups on a
+40-core GPU, each re-reading its KV head.
+
+Here the same per-simdgroup work runs as one simdgroup per (KV head,
+simdgroup s) for all query heads of that KV head (each key and value is read
+once per GQA group), its state is written out, and a second kernel merges the
+32 states of each query head exactly as sdpa_vector does. Every value is
+computed with the same operations in the same order.
+"""
+
+from functools import lru_cache
+
+import mlx.core as mx
+
+_PARTIALS_SRC = r"""
+    constexpr int BN = 32;
+    constexpr int G = HQ / HKV;
+    constexpr int QK = D / 32;
+    const uint lane = thread_index_in_simdgroup;
+    const int vs = int(threadgroup_position_in_grid.x) * VSG + int(simdgroup_index_in_threadgroup);
+    const int kvh = vs / BN;
+    const int s = vs % BN;
+    if (kvh >= HKV) return;
+    float q[G][QK], o[G][QK], max_score[G], sum_exp_score[G];
+    for (int g = 0; g < G; ++g) {
+        const int h = kvh * G + g;
+        for (int i = 0; i < QK; i++) {
+            q[g][i] = static_cast<float>(scale) * queries[h * D + lane * QK + i];
+            o[g][i] = 0;
+        }
+        max_score[g] = Limits<float>::finite_min;
+        sum_exp_score[g] = 0;
+        if (s == 0) {
+            max_score[g] = static_cast<float>(sinks[h]);
+            sum_exp_score[g] = 1;
+        }
+    }
+    const device T* kp = keys + kvh * keys_strides[1] + s * keys_strides[2] + lane * QK;
+    const device T* vp = values + kvh * values_strides[1] + s * values_strides[2] + lane * QK;
+    for (int i = s; i < N; i += BN) {
+        float k[QK];
+        for (int j = 0; j < QK; j++) {
+            k[j] = kp[j];
+        }
+        for (int g = 0; g < G; ++g) {
+            const int h = kvh * G + g;
+            const T mv = mask[h * M_HEAD + i];
+            const bool use_key = (mv >= Limits<T>::finite_min);
+            if (use_key) {
+                float score = 0;
+                for (int j = 0; j < QK; j++) {
+                    score += q[g][j] * k[j];
+                }
+                score = simd_sum(score);
+                score += static_cast<float>(mv);
+                float new_max = max(max_score[g], score);
+                float factor = fast::exp(max_score[g] - new_max);
+                float exp_score = fast::exp(score - new_max);
+                max_score[g] = new_max;
+                sum_exp_score[g] = sum_exp_score[g] * factor + exp_score;
+                for (int j = 0; j < QK; j++) {
+                    o[g][j] = o[g][j] * factor + exp_score * vp[j];
+                }
+            }
+        }
+        kp += BN * keys_strides[2];
+        vp += BN * values_strides[2];
+    }
+    for (int g = 0; g < G; ++g) {
+        const int row = (kvh * G + g) * BN + s;
+        if (lane == 0) {
+            part_max[row] = max_score[g];
+            part_sum[row] = sum_exp_score[g];
+        }
+        for (int j = 0; j < QK; j++) part_o[row * D + lane * QK + j] = o[g][j];
+    }
+"""
+
+_COMBINE_SRC = r"""
+    // sdpa_vector's merge of the 32 simdgroup states of query head h, the
+    // state of simdgroup l held by lane l.
+    constexpr int BN = 32;
+    constexpr int BD = 32;
+    constexpr int QK = D / BD;
+    const int h = threadgroup_position_in_grid.x;
+    const uint simd_lid = thread_index_in_simdgroup;
+    const uint simd_gid = simdgroup_index_in_threadgroup;
+    threadgroup float outputs[BN * BD];
+    float max_score = part_max[h * BN + simd_lid];
+    float new_max = simd_max(max_score);
+    float factor = fast::exp(max_score - new_max);
+    float sum_exp_score = simd_sum(part_sum[h * BN + simd_lid] * factor);
+    float o[QK];
+    for (int i = 0; i < QK; i++) {
+        outputs[simd_lid * BD + simd_gid] = part_o[(h * BN + simd_gid) * D + simd_lid * QK + i];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        o[i] = simd_sum(outputs[simd_gid * BD + simd_lid] * factor);
+        o[i] = sum_exp_score == 0 ? o[i] : (o[i] / sum_exp_score);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (simd_lid == 0) {
+        for (int i = 0; i < QK; i++) {
+            out[h * D + simd_gid * QK + i] = static_cast<T>(o[i]);
+        }
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _partials():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa_partials",
+        input_names=["queries", "keys", "values", "mask", "sinks", "scale"],
+        output_names=["part_max", "part_sum", "part_o"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_PARTIALS_SRC,
+    )
+
+
+@lru_cache(maxsize=None)
+def _combine():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa_combine",
+        input_names=["part_max", "part_sum", "part_o"],
+        output_names=["out"],
+        compile_options={"math_mode": "safe"},
+        source=_COMBINE_SRC,
+    )
+
+
+def sliding_sdpa(q, k, v, scale, mask, sinks, *, vsg=2):
+    """mx.fast.scaled_dot_product_attention(q, k, v, scale=scale,
+    mask=mask[None, :, None, :], sinks=sinks) for one query (sdpa_vector's
+    single-pass path): q (1, HQ, 1, D); k, v (1, HKV, N, D) bf16; mask (HQ, N)
+    in q's dtype; sinks (HQ,) in q's dtype. Returns (1, HQ, 1, D)."""
+    _, hq, _, d = q.shape
+    hkv, n = k.shape[1], k.shape[2]
+    assert d % 32 == 0 and hq % hkv == 0 and (32 * hkv) % vsg == 0
+    pm, ps, po = _partials()(
+        inputs=[mx.contiguous(q.reshape(hq, d)), k, v, mx.contiguous(mask), sinks,
+                mx.array(scale, mx.float32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("VSG", vsg), ("M_HEAD", n)],
+        grid=(32 * hkv // vsg * vsg * 32, 1, 1),
+        threadgroup=(vsg * 32, 1, 1),
+        output_shapes=[(hq * 32,), (hq * 32,), (hq * 32, d)],
+        output_dtypes=[mx.float32, mx.float32, mx.float32],
+    )
+    out = _combine()(
+        inputs=[pm, ps, po],
+        template=[("T", q.dtype), ("D", d)],
+        grid=(hq * 1024, 1, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+    return out.reshape(1, hq, 1, d)
+
+
+# ---------------------------------------------------------------------------
+# Two-pass replica (MLX sdpa_vector_2pass_1 with mask and sinks, then
+# sdpa_vector_2pass_2). Block b of a head takes keys b, b + BLOCKS, ...; its
+# unnormalized output is rounded to the dtype; pass 2 merges the blocks.
+# Here one simdgroup computes block b for every query head of its KV head
+# (each key/value read once per GQA group); the per-head arithmetic is MLX's.
+
+_P1_SRC = r"""
+    constexpr int G = HQ / HKV;
+    constexpr int QK = D / 32;
+    const uint simd_lid = thread_index_in_simdgroup;
+    const int vs = int(threadgroup_position_in_grid.x) * SGT + int(simdgroup_index_in_threadgroup);
+    const int kvh = vs / BLOCKS;
+    const int block_idx = vs % BLOCKS;
+    if (kvh >= HKV) return;
+    float q[G][QK], o[G][QK], max_score[G], sum_exp_score[G];
+    for (int g = 0; g < G; ++g) {
+        const int h = kvh * G + g;
+        for (int i = 0; i < QK; i++) {
+            q[g][i] = static_cast<float>(scale) * queries[h * D + simd_lid * QK + i];
+            o[g][i] = 0;
+        }
+        max_score[g] = Limits<float>::finite_min;
+        sum_exp_score[g] = 0;
+        if (block_idx == 0) {
+            max_score[g] = static_cast<float>(sinks[h]);
+            sum_exp_score[g] = 1;
+        }
+    }
+    const device T* kp = keys + kvh * keys_strides[1] + block_idx * keys_strides[2] + simd_lid * QK;
+    const device T* vp = values + kvh * values_strides[1] + block_idx * values_strides[2] + simd_lid * QK;
+    for (int i = block_idx; i < N; i += BLOCKS) {
+        float kr[QK], vr[QK];
+        for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(kp[j]);
+        for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(vp[j]);
+        for (int g = 0; g < G; ++g) {
+            const int h = kvh * G + g;
+            const T mv = mask[h * N + i];
+            if (mv >= Limits<T>::finite_min) {
+                float score = 0;
+                for (int j = 0; j < QK; j++) {
+                    score += q[g][j] * kr[j];
+                }
+                score = simd_sum(score);
+                score += static_cast<float>(mv);
+                float new_max = max(max_score[g], score);
+                float factor = fast::exp(max_score[g] - new_max);
+                float exp_score = fast::exp(score - new_max);
+                max_score[g] = new_max;
+                sum_exp_score[g] = sum_exp_score[g] * factor + exp_score;
+                for (int j = 0; j < QK; j++) {
+                    o[g][j] = o[g][j] * factor + exp_score * vr[j];
+                }
+            }
+        }
+        kp += BLOCKS * keys_strides[2];
+        vp += BLOCKS * values_strides[2];
+    }
+    for (int g = 0; g < G; ++g) {
+        const int row = (kvh * G + g) * BLOCKS + block_idx;
+        if (simd_lid == 0) {
+            sums[row] = sum_exp_score[g];
+            maxs[row] = max_score[g];
+        }
+        for (int j = 0; j < QK; j++) partials[row * D + simd_lid * QK + j] = static_cast<T>(o[g][j]);
+    }
+"""
+
+_P2_SRC = r"""
+    constexpr int BN = 32;
+    constexpr int BD = 32;
+    constexpr int elem_per_thread = D / BD;
+    typedef float U;
+    const uint simd_gid = simdgroup_index_in_threadgroup;
+    const uint simd_lid = thread_index_in_simdgroup;
+    thread U o[elem_per_thread] = {0};
+    threadgroup U outputs[BN * BD];
+    const int q_offset = threadgroup_position_in_grid.x;
+    const device T* pp = partials + q_offset * BLOCKS * D + simd_gid * D + simd_lid * elem_per_thread;
+    const device float* sp = sums + q_offset * BLOCKS;
+    const device float* mp = maxs + q_offset * BLOCKS;
+    U sum_exp_score = 0.0;
+    U max_score = Limits<U>::finite_min;
+    for (int b = 0; b < BLOCKS / BN; ++b) {
+        max_score = max(max_score, mp[simd_lid + BN * b]);
+    }
+    max_score = simd_max(max_score);
+    for (int b = 0; b < BLOCKS / BN; ++b) {
+        U factor = fast::exp(mp[simd_lid + BN * b] - max_score);
+        sum_exp_score += factor * sp[simd_lid + BN * b];
+    }
+    sum_exp_score = simd_sum(sum_exp_score);
+    for (int b = 0; b < BLOCKS / BN; ++b) {
+        U factor = fast::exp(mp[simd_gid] - max_score);
+        for (int i = 0; i < elem_per_thread; i++) {
+            o[i] += factor * static_cast<U>(pp[i]);
+        }
+        mp += BN;
+        sp += BN;
+        pp += BN * D;
+    }
+    for (int i = 0; i < elem_per_thread; i++) {
+        outputs[simd_lid * BD + simd_gid] = o[i];
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        o[i] = simd_sum(outputs[simd_gid * BD + simd_lid]);
+        o[i] = sum_exp_score == 0 ? o[i] : (o[i] / sum_exp_score);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    if (simd_lid == 0) {
+        for (int i = 0; i < elem_per_thread; i++) {
+            out[q_offset * D + simd_gid * elem_per_thread + i] = static_cast<T>(o[i]);
+        }
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _p1():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p1",
+        input_names=["queries", "keys", "values", "mask", "sinks", "scale"],
+        output_names=["partials", "sums", "maxs"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_P1_SRC,
+    )
+
+
+@lru_cache(maxsize=None)
+def _p2():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p2",
+        input_names=["partials", "sums", "maxs"],
+        output_names=["out"],
+        compile_options={"math_mode": "safe"},
+        source=_P2_SRC,
+    )
+
+
+def sliding_sdpa2(q, k, v, scale, mask, sinks, *, blocks=64, sgt=4):
+    """MLX's two-pass single-query SDPA (sdpa_vector_2pass_1/2) with an
+    additive mask (HQ, N) and sinks (HQ,), for `blocks` key blocks."""
+    _, hq, _, d = q.shape
+    hkv, n = k.shape[1], k.shape[2]
+    assert d % 32 == 0 and hq % hkv == 0 and blocks % 32 == 0 and (hkv * blocks) % sgt == 0
+    part, sums, maxs = _p1()(
+        inputs=[mx.contiguous(q.reshape(hq, d)), k, v, mx.contiguous(mask), sinks,
+                mx.array(scale, mx.float32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("BLOCKS", blocks), ("SGT", sgt)],
+        grid=(hkv * blocks // sgt * sgt * 32, 1, 1),
+        threadgroup=(sgt * 32, 1, 1),
+        output_shapes=[(hq * blocks, d), (hq * blocks,), (hq * blocks,)],
+        output_dtypes=[q.dtype, mx.float32, mx.float32],
+    )
+    out = _p2()(
+        inputs=[part, sums, maxs],
+        template=[("T", q.dtype), ("D", d), ("BLOCKS", blocks)],
+        grid=(hq * 1024, 1, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+    return out.reshape(1, hq, 1, d)
+
+
+# ---------------------------------------------------------------------------
+# The decode step's sliding attention: Attention._decode_attention builds the
+# mask as take(rel, distance) over the ring slots (slots = (i - idx) mod N,
+# distance = N - 1 - slot) and calls the SDPA; here pass 1 reads rel at that
+# distance itself (the same bf16 value), and pass 2 may apply the attention
+# gate (out.astype(f32) * sigmoid(gate.astype(f32))).astype(dtype) as
+# Attention.__call__ does.
+
+_P1R_SRC = _P1_SRC.replace(
+    "const T mv = mask[h * N + i];",
+    """int slot = (i - widx) % N;
+            if (slot < 0) slot += N;
+            const int dist = (N - 1) - slot;
+            const T mv = dist < REL ? rel[h * REL + dist] : T(0);""",
+).replace(
+    "if (kvh >= HKV) return;",
+    "if (kvh >= HKV) return;\n    const int widx = ring_idx[0];",
+)
+
+_P2G_SRC = _P2_SRC.replace(
+    """            out[q_offset * D + simd_gid * elem_per_thread + i] = static_cast<T>(o[i]);""",
+    """            const int c = q_offset * D + simd_gid * elem_per_thread + i;
+            if (HAS_GATE) {
+                const float g = float(gate[c]);
+                const float y = 1 / (1 + metal::precise::exp(metal::abs(g)));
+                const float sg = (g < 0) ? y : 1 - y;
+                out[c] = static_cast<T>(float(static_cast<T>(o[i])) * sg);
+            } else {
+                out[c] = static_cast<T>(o[i]);
+            }""",
+)
+
+
+@lru_cache(maxsize=None)
+def _p1r():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p1_rel",
+        input_names=["queries", "keys", "values", "rel", "ring_idx", "sinks", "scale"],
+        output_names=["partials", "sums", "maxs"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_P1R_SRC,
+    )
+
+
+@lru_cache(maxsize=None)
+def _p2g():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p2_gate",
+        input_names=["partials", "sums", "maxs", "gate"],
+        output_names=["out"],
+        compile_options={"math_mode": "safe"},
+        source=_P2G_SRC,
+    )
+
+
+def sliding_attention(q, k, v, rel, ring_idx, sinks, scale, *, blocks, gate=None, sgt=4):
+    """One query over a full sliding ring k, v (1, HKV, N, D) whose next write
+    slot after this token's write is ring_idx (int32 array, as
+    StepRotatingKVCache._idx): the SDPA of Attention._decode_attention with
+    the mask take(rel, N - 1 - slot) read in place. rel (HQ, REL) in q's dtype,
+    sinks (HQ,) in q's dtype. With gate (HQ * D values) the output is gated."""
+    _, hq, _, d = q.shape
+    hkv, n = k.shape[1], k.shape[2]
+    rel_n = rel.shape[-1]
+    assert d % 32 == 0 and hq % hkv == 0 and blocks % 32 == 0 and (hkv * blocks) % sgt == 0
+    part, sums, maxs = _p1r()(
+        inputs=[mx.contiguous(q.reshape(hq, d)), k, v, mx.contiguous(rel),
+                ring_idx.reshape(1).astype(mx.int32), sinks, mx.array(scale, mx.float32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("BLOCKS", blocks), ("SGT", sgt), ("REL", rel_n)],
+        grid=(hkv * blocks // sgt * sgt * 32, 1, 1),
+        threadgroup=(sgt * 32, 1, 1),
+        output_shapes=[(hq * blocks, d), (hq * blocks,), (hq * blocks,)],
+        output_dtypes=[q.dtype, mx.float32, mx.float32],
+    )
+    out = _p2g()(
+        inputs=[part, sums, maxs, part if gate is None else gate.reshape(-1)],
+        template=[("T", q.dtype), ("D", d), ("BLOCKS", blocks), ("HAS_GATE", gate is not None)],
+        grid=(hq * 1024, 1, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+    return out.reshape(1, hq, 1, d)
+
+
+# ---------------------------------------------------------------------------
+# The same sliding attention reading the ring as it was before this token's
+# write, with this token's key/value row (k_new, v_new) used at its slot
+# new_slot: every value read equals the updated ring's, so the cache write can
+# follow the attention instead of preceding it.
+
+_P1N_SRC = _P1R_SRC.replace(
+    """        float kr[QK], vr[QK];
+        for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(kp[j]);
+        for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(vp[j]);""",
+    """        float kr[QK], vr[QK];
+        if (i == nslot) {
+            for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(k_new[kvh * D + simd_lid * QK + j]);
+            for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(v_new[kvh * D + simd_lid * QK + j]);
+        } else {
+            for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(kp[j]);
+            for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(vp[j]);
+        }""",
+).replace(
+    "const int widx = ring_idx[0];",
+    "const int widx = ring_idx[0];\n    const int nslot = new_slot[0];",
+)
+assert _P1N_SRC.count("nslot") == 2
+
+
+@lru_cache(maxsize=None)
+def _p1n():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p1_newrow",
+        input_names=["queries", "keys", "values", "rel", "ring_idx", "sinks", "scale",
+                     "k_new", "v_new", "new_slot"],
+        output_names=["partials", "sums", "maxs"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_P1N_SRC,
+    )
+
+
+def sliding_attention_newrow(q, k_old, v_old, k_new, v_new, new_slot, rel, sinks, scale,
+                             *, blocks, gate=None, sgt=4):
+    """sliding_attention on the ring before this token's write (k_old, v_old)
+    with the new key/value rows (1, HKV, 1, D) at slot new_slot (int32 array).
+    Returns (output, partials): write the cache after the partials."""
+    _, hq, _, d = q.shape
+    hkv, n = k_old.shape[1], k_old.shape[2]
+    rel_n = rel.shape[-1]
+    assert d % 32 == 0 and hq % hkv == 0 and blocks % 32 == 0 and (hkv * blocks) % sgt == 0
+    slot = new_slot.reshape(1).astype(mx.int32)
+    part, sums, maxs = _p1n()(
+        inputs=[mx.contiguous(q.reshape(hq, d)), k_old, v_old, mx.contiguous(rel),
+                slot + 1, sinks, mx.array(scale, mx.float32),
+                mx.contiguous(k_new.reshape(hkv, d)), mx.contiguous(v_new.reshape(hkv, d)), slot],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("BLOCKS", blocks), ("SGT", sgt), ("REL", rel_n)],
+        grid=(hkv * blocks // sgt * sgt * 32, 1, 1),
+        threadgroup=(sgt * 32, 1, 1),
+        output_shapes=[(hq * blocks, d), (hq * blocks,), (hq * blocks,)],
+        output_dtypes=[q.dtype, mx.float32, mx.float32],
+    )
+    out = _p2g()(
+        inputs=[part, sums, maxs, part if gate is None else gate.reshape(-1)],
+        template=[("T", q.dtype), ("D", d), ("BLOCKS", blocks), ("HAS_GATE", gate is not None)],
+        grid=(hq * 1024, 1, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+    return out.reshape(1, hq, 1, d), [part, sums, maxs]
+
+
+# ---------------------------------------------------------------------------
+# Pass 1 in MLX's own layout (sdpa_vector_2pass_1): a threadgroup of G
+# simdgroups per (KV head, block), simdgroup g = query head g of the group,
+# keys block, block + BLOCKS, ... with TK = 4 keys' loads issued together.
+# BIAS = 0: the additive mask (HQ, N); BIAS = 1: rel at the ring distance.
+# NEWROW: this token's key/value row used at slot new_slot (ring read before
+# its write).
+
+_P1M_SRC = r"""
+    constexpr int G = HQ / HKV;
+    constexpr int QK = D / 32;
+    constexpr int TK = TKP;  // keys whose loads are issued together (MLX: 4)
+    const uint simd_lid = thread_index_in_simdgroup;
+    const int g = int(simdgroup_index_in_threadgroup);
+    const int kvh = int(threadgroup_position_in_grid.x) / BLOCKS;
+    const int block_idx = int(threadgroup_position_in_grid.x) % BLOCKS;
+    const int h = kvh * G + g;
+    const int widx = BIAS == 1 ? ring_idx[0] : 0;
+    const int nslot = NEWROW ? new_slot[0] : -1;
+    float q[QK], o[QK];
+    for (int i = 0; i < QK; i++) {
+        q[i] = static_cast<float>(scale) * queries[h * D + simd_lid * QK + i];
+        o[i] = 0;
+    }
+    float max_score = Limits<float>::finite_min;
+    float sum_exp_score = 0;
+    if (block_idx == 0) {
+        max_score = static_cast<float>(sinks[h]);
+        sum_exp_score = 1;
+    }
+    const device T* kp = keys + kvh * keys_strides[1] + block_idx * keys_strides[2] + simd_lid * QK;
+    const device T* vp = values + kvh * values_strides[1] + block_idx * values_strides[2] + simd_lid * QK;
+    const int stride_k_tok = BLOCKS * int(keys_strides[2]);
+    const int stride_v_tok = BLOCKS * int(values_strides[2]);
+    int i = block_idx;
+    for (; i + (TK - 1) * BLOCKS < N; i += BLOCKS * TK) {
+        T k_reg[TK][QK];
+        T v_reg[TK][QK];
+        for (int t = 0; t < TK; t++) {
+            const device T* kq = kp + t * stride_k_tok;
+            for (int j = 0; j < QK; j++) k_reg[t][j] = kq[j];
+        }
+        for (int t = 0; t < TK; t++) {
+            const device T* vq = vp + t * stride_v_tok;
+            for (int j = 0; j < QK; j++) v_reg[t][j] = vq[j];
+        }
+        for (int t = 0; t < TK; t++) {
+            const int ii = i + t * BLOCKS;
+            if (NEWROW && ii == nslot) {
+                for (int j = 0; j < QK; j++) {
+                    k_reg[t][j] = k_new[kvh * D + simd_lid * QK + j];
+                    v_reg[t][j] = v_new[kvh * D + simd_lid * QK + j];
+                }
+            }
+            T mv;
+            if (BIAS == 1) {
+                int slot = (ii - widx) % N;
+                if (slot < 0) slot += N;
+                const int dist = (N - 1) - slot;
+                mv = dist < REL ? rel[h * REL + dist] : T(0);
+            } else {
+                mv = mask[h * N + ii];
+            }
+            if (mv >= Limits<T>::finite_min) {
+                float score = 0;
+                for (int j = 0; j < QK; j++) {
+                    score += q[j] * static_cast<float>(k_reg[t][j]);
+                }
+                score = simd_sum(score);
+                score += static_cast<float>(mv);
+                float new_max = max(max_score, score);
+                float factor = fast::exp(max_score - new_max);
+                float exp_score = fast::exp(score - new_max);
+                max_score = new_max;
+                sum_exp_score = sum_exp_score * factor + exp_score;
+                for (int j = 0; j < QK; j++) {
+                    o[j] = o[j] * factor + exp_score * static_cast<float>(v_reg[t][j]);
+                }
+            }
+        }
+        kp += TK * stride_k_tok;
+        vp += TK * stride_v_tok;
+    }
+    for (; i < N; i += BLOCKS) {
+        float kr[QK], vr[QK];
+        if (NEWROW && i == nslot) {
+            for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(k_new[kvh * D + simd_lid * QK + j]);
+            for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(v_new[kvh * D + simd_lid * QK + j]);
+        } else {
+            for (int j = 0; j < QK; j++) kr[j] = static_cast<float>(kp[j]);
+            for (int j = 0; j < QK; j++) vr[j] = static_cast<float>(vp[j]);
+        }
+        T mv;
+        if (BIAS == 1) {
+            int slot = (i - widx) % N;
+            if (slot < 0) slot += N;
+            const int dist = (N - 1) - slot;
+            mv = dist < REL ? rel[h * REL + dist] : T(0);
+        } else {
+            mv = mask[h * N + i];
+        }
+        if (mv >= Limits<T>::finite_min) {
+            float score = 0;
+            for (int j = 0; j < QK; j++) {
+                score += q[j] * kr[j];
+            }
+            score = simd_sum(score);
+            score += static_cast<float>(mv);
+            float new_max = max(max_score, score);
+            float factor = fast::exp(max_score - new_max);
+            float exp_score = fast::exp(score - new_max);
+            max_score = new_max;
+            sum_exp_score = sum_exp_score * factor + exp_score;
+            for (int j = 0; j < QK; j++) {
+                o[j] = o[j] * factor + exp_score * vr[j];
+            }
+        }
+        kp += stride_k_tok;
+        vp += stride_v_tok;
+    }
+    const int row = h * BLOCKS + block_idx;
+    if (simd_lid == 0) {
+        sums[row] = sum_exp_score;
+        maxs[row] = max_score;
+    }
+    for (int j = 0; j < QK; j++) partials[row * D + simd_lid * QK + j] = static_cast<T>(o[j]);
+"""
+
+
+@lru_cache(maxsize=None)
+def _p1m():
+    return mx.fast.metal_kernel(
+        name="inkling2_sliding_sdpa2_p1_mlx_layout",
+        input_names=["queries", "keys", "values", "mask", "rel", "ring_idx", "sinks", "scale",
+                     "k_new", "v_new", "new_slot"],
+        output_names=["partials", "sums", "maxs"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_P1M_SRC,
+    )
+
+
+import os as _os
+
+_SDPA_TK = int(_os.environ.get("MLX_VLM_INKLING2_SDPA_TK", "4"))
+
+
+def sliding_sdpa_m(q, k, v, scale, sinks, *, blocks=64, mask=None, rel=None, ring_idx=None,
+                   k_new=None, v_new=None, new_slot=None, gate=None, tk=None):
+    """MLX's two-pass single-query SDPA (pass 1 in MLX's layout) with either
+    an additive mask (HQ, N) or the relative bias read from rel at the ring
+    distance; optionally this token's row at new_slot and the gate.
+    Returns (output (1, HQ, 1, D), [partials, sums, maxs])."""
+    _, hq, _, d = q.shape
+    hkv, n = k.shape[1], k.shape[2]
+    assert d % 32 == 0 and hq % hkv == 0 and blocks % 32 == 0
+    qf = mx.contiguous(q.reshape(hq, d))
+    bias_mode = 0 if mask is not None else 1
+    newrow = k_new is not None
+    i32 = new_slot.reshape(1).astype(mx.int32) if newrow else None
+    part, sums, maxs = _p1m()(
+        inputs=[qf, k, v,
+                mx.contiguous(mask) if mask is not None else qf,
+                mx.contiguous(rel) if rel is not None else qf,
+                ring_idx.reshape(1).astype(mx.int32) if ring_idx is not None else sinks,
+                sinks, mx.array(scale, mx.float32),
+                mx.contiguous(k_new.reshape(hkv, d)) if newrow else qf,
+                mx.contiguous(v_new.reshape(hkv, d)) if newrow else qf,
+                i32 if newrow else sinks],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("BLOCKS", blocks), ("BIAS", bias_mode), ("NEWROW", newrow),
+                  ("REL", rel.shape[-1] if rel is not None else 1), ("TKP", tk or _SDPA_TK)],
+        grid=(hkv * blocks * 32, hq // hkv, 1),
+        threadgroup=(32, hq // hkv, 1),
+        output_shapes=[(hq * blocks, d), (hq * blocks,), (hq * blocks,)],
+        output_dtypes=[q.dtype, mx.float32, mx.float32],
+    )
+    out = _p2g()(
+        inputs=[part, sums, maxs, part if gate is None else gate.reshape(-1)],
+        template=[("T", q.dtype), ("D", d), ("BLOCKS", blocks), ("HAS_GATE", gate is not None)],
+        grid=(hq * 1024, 1, 1),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+    return out.reshape(1, hq, 1, d), [part, sums, maxs]
+
+
+def sliding_attention(q, k, v, rel, ring_idx, sinks, scale, *, blocks, gate=None, sgt=4):  # noqa: F811
+    """The decode step's sliding attention (see above), pass 1 in MLX's layout."""
+    return sliding_sdpa_m(q, k, v, scale, sinks, blocks=blocks, rel=rel, ring_idx=ring_idx,
+                          gate=gate)[0]
+
+
+def sliding_attention_newrow(q, k_old, v_old, k_new, v_new, new_slot, rel, sinks, scale,  # noqa: F811
+                             *, blocks, gate=None, sgt=4):
+    """sliding_attention on the ring before this token's write, with the new
+    rows at new_slot; returns (output, deps) (write the cache after deps)."""
+    return sliding_sdpa_m(q, k_old, v_old, scale, sinks, blocks=blocks, rel=rel,
+                          ring_idx=new_slot + 1, k_new=k_new, v_new=v_new,
+                          new_slot=new_slot, gate=gate)
diff -ruN a/mlx_vlm/models/inkling2/fast_decode.py b/mlx_vlm/models/inkling2/fast_decode.py
--- a/mlx_vlm/models/inkling2/fast_decode.py	1970-01-01 01:00:00.000000000 +0100
+++ b/mlx_vlm/models/inkling2/fast_decode.py	2026-11-22 11:11:10.493752680 +0100
@@ -0,0 +1,239 @@
+"""One compiled graph per single-token decode step (Inkling 2 / 2-loop).
+
+The eager decode step builds ~13k lazy nodes in Python (~5 ms) and encodes
+~7k kernels per token. Compiling the whole step removes the Python graph build
+and fuses the elementwise glue into fewer kernels. The step reads functional
+views of the caches (step_cache.py), so its shapes are constant and its trace is
+reused for every token; the caches' Python objects are updated afterwards.
+
+The step runs the model's own decode code on the same inputs, so it performs
+the same operations in the same order; it is used only where the eager path
+would take the same branches: every global cache already holds at least
+_DECODE_KERNEL_MIN_KEYS - 1 keys and has room for one more, and every sliding
+ring is full.
+"""
+
+import os
+
+import mlx.core as mx
+
+from ..cache import ArraysCache, CacheList, KVCache, RotatingKVCache
+from .step_cache import StepConvCache, StepKVCache, StepRotatingKVCache
+
+_ENABLED = os.environ.get("MLX_VLM_INKLING2_COMPILED_DECODE", "1") == "1"
+# "precast" (FP32 copies of the router and loop-gate weights) is only needed
+# by the unfused paths' casts; the fused kernels read the BF16 weights and
+# convert them exactly, at half the bytes.
+_PREP = set(
+    os.environ.get(
+        "MLX_VLM_INKLING2_DECODE_PREP", "gatestack,factor,catproj"
+    ).split(",")
+)
+_FUSED = ("q_proj", "r_proj", "gate_proj", "k_proj", "v_proj")
+_MESSAGE_GATES = ("q_message_gate", "k_message_gate", "v_message_gate", "mlp_message_gate")
+
+
+def prepare_decode(lm):
+    """One-time weight layout for decode. Changes no value that is computed:
+    - FP32 copies of the router and loop-gate weights that every step casts
+      to FP32 anyway (the casts become no-ops);
+    - the q, k and v message gates of each loop layer stacked, each gate's
+      weights a view of its slice (one batched chain per decode visit);
+    - the NVFP4 experts' per-expert kernel factor, stored once;
+    - the same-input attention projections stored as one row-wise
+      concatenation, each projection's weight a view of its rows (memory is
+      unchanged; Attention._decode_projections reads them in one GEMV)."""
+    import mlx.nn as nn
+
+    if lm.__dict__.get("_decode_prepared"):
+        return
+    lm.__dict__["_decode_prepared"] = True
+    for layer in lm.model.layers:
+        attn, moe = layer.self_attn, layer.mlp
+        new = []
+        if "precast" in _PREP:
+            if moe.gate_weight.dtype != mx.float32:
+                moe.gate_weight = moe.gate_weight.astype(mx.float32)
+                new.append(moe.gate_weight)
+            for name in _MESSAGE_GATES:
+                gate = getattr(layer, name, None)
+                if gate is None:
+                    continue
+                for proj in (gate.forget_gate_proj, gate.message_gate_proj):
+                    if proj.weight.dtype != mx.float32:
+                        proj.weight = proj.weight.astype(mx.float32)
+                        new.append(proj.weight)
+        gates = [getattr(layer, n, None) for n in _MESSAGE_GATES[:3]]
+        if (
+            "gatestack" in _PREP
+            and all(g is not None for g in gates)
+            and layer.__dict__.get("_qkv_gate_stack") is None
+            and all(
+                type(p) is nn.Linear
+                and "bias" not in p
+                and (
+                    p is g.down_proj
+                    or p.weight.dtype == gates[0].forget_gate_proj.weight.dtype
+                )
+                for g in gates
+                for p in (g.down_proj, g.forget_gate_proj, g.message_gate_proj)
+            )
+        ):
+            # The q, k and v gates of a loop layer as stacked weights
+            # (each gate's weight a view of its slice: memory unchanged).
+            stack = []
+            for attr in ("down_proj", "forget_gate_proj", "message_gate_proj"):
+                stacked = mx.stack([g[attr].weight for g in gates])
+                mx.eval(stacked)
+                for i, g in enumerate(gates):
+                    g[attr].weight = stacked[i]
+                    new.append(g[attr].weight)
+                stack.append(stacked)
+            layer.__dict__["_qkv_gate_stack"] = tuple(stack)
+        if "factor" in _PREP:
+            for name in ("gate_proj", "up_proj", "down_proj"):
+                proj = getattr(moe.switch_mlp, name)
+                if hasattr(proj, "decode_factor"):
+                    proj.decode_factor()
+        if (
+            "catproj" in _PREP
+            and attn.sharding_group is None
+            and attn.__dict__.get("_fused_qrgkv") is None
+            and all(
+                type(attn[n]) is nn.Linear and "bias" not in attn[n] for n in _FUSED
+            )
+        ):
+            weights = [attn[n].weight for n in _FUSED]
+            if len({(w.dtype, w.shape[1]) for w in weights}) == 1:
+                fused = mx.concatenate(weights, axis=0)
+                mx.eval(fused)
+                start = 0
+                for n, w in zip(_FUSED, weights):
+                    attn[n].weight = fused[start : start + w.shape[0]]
+                    new.append(attn[n].weight)
+                    start += w.shape[0]
+                attn.__dict__["_fused_qrgkv"] = fused
+                del weights
+        mx.eval(new)
+    mx.clear_cache()
+
+
+def _layout(cache):
+    """(kind, ...) per cache entry, or None if the compiled step can't serve it."""
+    from .language import _DECODE_KERNEL_MIN_KEYS
+
+    kinds, offset, idx = [], None, None
+    for entry in cache:
+        if type(entry) is not CacheList or len(entry.caches) != 2:
+            return None
+        kv, conv = entry.caches
+        if type(conv) is not ArraysCache or any(
+            getattr(conv, a, None) is not None for a in ("left_padding", "lengths")
+        ):
+            return None
+        if getattr(conv, "_speculation", None) is not None or any(
+            s is None for s in conv.cache
+        ):
+            return None
+        if type(kv) is KVCache:
+            if kv.keys is None or kv.offset + 1 > kv.keys.shape[2]:
+                return None
+            if kv.offset + 1 < _DECODE_KERNEL_MIN_KEYS:
+                return None
+            if offset is None:
+                offset = kv.offset
+            elif kv.offset != offset:
+                return None
+            kinds.append("g")
+        elif type(kv) is RotatingKVCache:
+            if (
+                kv.keys is None
+                or kv.keep != 0
+                or kv.offset < kv.max_size
+                or kv.keys.shape[2] != kv.max_size
+            ):
+                return None
+            if idx is None:
+                idx = kv._idx
+            elif kv._idx != idx:
+                return None
+            kinds.append("r")
+        else:
+            return None
+    if offset is None or idx is None:
+        return None
+    return tuple(kinds), offset, idx
+
+
+class CompiledDecoder:
+    def __init__(self, lm):
+        self.lm = lm
+        self.kinds = None
+        prepare_decode(lm)
+        self.fn = mx.compile(self._step)
+
+    def _step(self, token, offset, idx, *states):
+        caches, n = [], 0
+        for kind in self.kinds:
+            k, v, c0, c1, c2, c3 = states[n : n + 6]
+            n += 6
+            if kind == "g":
+                kv = StepKVCache(k, v, offset)
+            else:
+                kv = StepRotatingKVCache(k, v, idx, k.shape[2])
+            caches.append((kv, StepConvCache((c0, c1, c2, c3))))
+        out = self.lm(token, cache=caches, logits_to_keep=1)
+        logits = out.logits[:, -1, :]
+        logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+        y = mx.argmax(logprobs, axis=-1)
+        new = []
+        for kv, conv in caches:
+            new += [kv.keys, kv.values, *conv.cache]
+        return (y, logprobs, *new)
+
+    def __call__(self, token, cache):
+        """(y, logprobs) for one token, updating `cache`; None if not served."""
+        layout = _layout(cache)
+        if layout is None:
+            return None
+        kinds, offset, idx = layout
+        if self.kinds is None:
+            self.kinds = kinds
+        elif self.kinds != kinds:
+            return None
+        states = []
+        for entry in cache:
+            kv, conv = entry.caches
+            states += [kv.keys, kv.values, *conv.cache]
+            # Drop the cache's references so the in-place updates can donate
+            # the old buffers instead of copying them.
+            kv.keys = kv.values = None
+        outs = self.fn(
+            token,
+            mx.array(offset, dtype=mx.int32),
+            mx.array(idx, dtype=mx.int32),
+            *states,
+        )
+        del states
+        y, logprobs, new = outs[0], outs[1], outs[2:]
+        for i, entry in enumerate(cache):
+            kv, conv = entry.caches
+            k, v, *cs = new[6 * i : 6 * i + 6]
+            kv.keys, kv.values = k, v
+            kv.offset += 1
+            if type(kv) is RotatingKVCache:
+                kv._idx = (0 if kv._idx == kv.max_size else kv._idx) + 1
+            for j, s in enumerate(cs):
+                conv.cache[j] = s
+        return y, logprobs
+
+
+def compiled_decode(lm, token, cache):
+    """Serve one greedy decode step through the compiled graph, or None."""
+    if not _ENABLED:
+        return None
+    dec = lm.__dict__.get("_compiled_decoder")
+    if dec is None:
+        dec = CompiledDecoder(lm)
+        lm.__dict__["_compiled_decoder"] = dec
+    return dec(token, cache)
