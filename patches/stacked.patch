+                      + c * state_strides[2]];
+        }
+        next_state[(b * (W - 1) + W - 2) * C + c] = xt;
+        """,
+    )
+
+
+def short_convolution_step(state, weight, x, width):
+    """One unmasked token: the convolution (as short_convolution) and the
+    next FP32 state [state[:, 1:], x], in one kernel instead of a convolution,
+    a cast and a concatenation."""
+    b, _, c = x.shape
+    return _short_convolution_step()(
+        inputs=[state, weight, x, mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", x.dtype), ("W", width)],
+        grid=(b * c, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[x.shape, (b, width - 1, c)],
+        output_dtypes=[x.dtype, state.dtype],
+    )
+
+
+@lru_cache(maxsize=1)
+def _short_convolution_head_step():
+    # short_convolution_step for one unmasked token, one threadgroup of E
+    # threads per head row, then on the head's E bf16 outputs either
+    # l2_clip_rows (MODE 0, E == 128, no scale) or rms_norm_cast without a
+    # weight (MODE 1): the arithmetic of those kernels.
+    return mx.fast.metal_kernel(
+        name="inkling2_short_convolution_head_step",
+        input_names=["state", "weight", "x", "divisor", "param"],
+        output_names=["out", "next_state"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        const uint e = thread_position_in_threadgroup.x;
+        const uint lane = thread_index_in_simdgroup;
+        const uint sg = simdgroup_index_in_threadgroup;
+        const int c = int(threadgroup_position_in_grid.x) * E + int(e);
+        float value = 0;
+        for (int j = 0; j < W; ++j) {
+            int p = j - W + 1;
+            float xv = p < 0 ? float(state[(p + W - 1) * C + c]) : float(x[c]);
+            float w = weight[c * W + j];
+            value = value + xv * w;
+        }
+        const float xt = float(x[c]);
+        const T conv = T((value + xt) / divisor);
+        for (int j = 0; j < W - 2; ++j) next_state[j * C + c] = state[(j + 1) * C + c];
+        next_state[(W - 2) * C + c] = xt;
+        threadgroup T row[E];
+        threadgroup float shared[33];
+        row[e] = conv;
+        if (sg == 0) shared[lane] = 0;
