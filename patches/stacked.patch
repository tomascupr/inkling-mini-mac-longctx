+def _splitk_plan(m, n, k):
+    """MLX steel_gemm_splitk_axpby's partitions for (m, n, k), bk = 16:
+    (partitions, k-iterations per partition, k-iterations of the last)."""
+    tm, tn, tk = (m + 31) // 32, (n + 31) // 32, k // 16
+    q = max(1, tk // (tm * tn))
