+    )
+
+
+def short_convolution_head_step(state, weight, x, width, head_dim, mode, param):
+    """One unmasked token: short_convolution_step on x (1, 1, C), then per
+    head row of head_dim: l2_clip_rows(threshold=param) (mode 0) or
+    rms_norm_cast(None, eps=param) (mode 1). Returns (out (1, 1, C // head_dim,
+    head_dim), next_state)."""
+    b, _, c = x.shape
+    assert b == 1 and c % head_dim == 0 and head_dim == 128
