+        const int route = vtg / TG_PER_ROUTE;
+        const int row0 = (vtg % TG_PER_ROUTE) * ROWS_TG + int(sgi) * RPS;
+        const int e = sel[route];
+        constexpr int WROW = K * 4 / (32 / BITS);
+        constexpr int GROW = K / GS;
+        float rg[RPS], ru[RPS];
+        for (int r = 0; r < RPS; ++r) { rg[r] = 0.0f; ru[r] = 0.0f; }
+        const size_t wo = (size_t(e) * N + row0) * WROW;
+        const size_t so = (size_t(e) * N + row0) * GROW;
+        if (PRE == 5 && !FAST) {
+            ink_qmv_rows_shfl<T, K, BITS, GS, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, x, lane, rg, lut);
+            ink_qmv_rows_shfl<T, K, BITS, GS, RPS, DQ>(
+                (const device uint8_t*)wu + wo, su + so, x, lane, ru, lut);
+        } else if (PRE == 4) {
+            ink_qmv_gu_pre<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, (const device uint8_t*)wu + wo, su + so,
+                x, lane, rg, ru, lut);
+        } else if (PRE == 3) {
+            ink_qmv_rows_pre3<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, x, lane, rg, lut);
+            ink_qmv_rows_pre3<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wu + wo, su + so, x, lane, ru, lut);
+        } else if (PRE) {
+            ink_qmv_rows_pre<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, x, lane, rg, lut);
+            ink_qmv_rows_pre<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wu + wo, su + so, x, lane, ru, lut);
+        } else {
+            ink_qmv_rows<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, x, lane, rg, lut);
+            ink_qmv_rows<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wu + wo, su + so, x, lane, ru, lut);
+        }
+        float invg = 1.0f, invu = 1.0f;
+        if (HAS_GSCALE) {
+            invg = fg[e] / (448.0f * 6.0f);
+            invu = fu[e] / (448.0f * 6.0f);
+        }
+        for (int r = 0; r < RPS; ++r) {
+            rg[r] = simd_sum(rg[r]);
+            ru[r] = simd_sum(ru[r]);
+        }
+        if (lane == 0) {
+            for (int r = 0; r < RPS; ++r) {
+                const T gb = HAS_GSCALE ? static_cast<T>(rg[r] * invg) : static_cast<T>(rg[r]);
+                const T ub = HAS_GSCALE ? static_cast<T>(ru[r] * invu) : static_cast<T>(ru[r]);
+                // _softcapped_swiglu(up, gate, GCAP, UCAP)
+                const float g = float(gb), u = float(ub);
+                const float v = metal::precise::tanh(g / GCAP) * GCAP * ink_sigmoid(g)
+                    * metal::precise::tanh(u / UCAP) * UCAP;
+                act[route * N + row0 + r] = static_cast<T>(v);
+            }
+        }
+        }
+        """
+
+
+@lru_cache(maxsize=None)
+def _down_tail_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_moe_down_tail",
+        input_names=["act", "idx", "wts", "wd", "sd", "fd", "state", "conv_w",
+                     "residual", "divisor"],
+        output_names=["out", "next_state"],
+        header=_HEADER,
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        const uint lane = thread_index_in_simdgroup;
+        const uint sgi = simdgroup_index_in_threadgroup;
+        const uint lid = thread_position_in_threadgroup.x;
+        const int tg = threadgroup_position_in_grid.x;
+        constexpr int CH = RPS * (SG / R);
+        threadgroup float eo[R][CH];
+        threadgroup float lut[16 + 256];
+        if (DQ == 1) ink_fill_luts(lut, lid, SG * 32);
+        for (int pass = 0; pass < NP; ++pass) {
+        if (pass > 0) threadgroup_barrier(mem_flags::mem_threadgroup);
+        const int route = int(sgi) % R;
+        const int sub = int(sgi) / R;
+        const int c0 = (tg * NP + pass) * CH;
+        const int row0 = c0 + sub * RPS;
+        const int e = int(idx[route]);
+        constexpr int WROW = K * 4 / (32 / BITS);
+        constexpr int GROW = K / GS;
+        float res[RPS];
+        for (int r = 0; r < RPS; ++r) res[r] = 0.0f;
+        if (PRE == 5 && !FAST) {
+            ink_qmv_rows_shfl<T, K, BITS, GS, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * N + row0) * WROW,
+                sd + (size_t(e) * N + row0) * GROW, act + route * K, lane, res, lut);
+        } else if (PRE == 3) {
+            ink_qmv_rows_pre3<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * N + row0) * WROW,
+                sd + (size_t(e) * N + row0) * GROW, act + route * K, lane, res, lut);
+        } else if (PRE == 2) {
+            ink_qmv_rows_pre2<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * N + row0) * WROW,
+                sd + (size_t(e) * N + row0) * GROW, act + route * K, lane, res, lut);
+        } else if (PRE == 1) {
+            ink_qmv_rows_pre<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * N + row0) * WROW,
+                sd + (size_t(e) * N + row0) * GROW, act + route * K, lane, res, lut);
+        } else {
+            ink_qmv_rows<T, K, BITS, GS, FAST, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * N + row0) * WROW,
+                sd + (size_t(e) * N + row0) * GROW, act + route * K, lane, res, lut);
+        }
+        float inv = 1.0f;
+        if (HAS_GSCALE) inv = fd[e] / (448.0f * 6.0f);
+        for (int r = 0; r < RPS; ++r) res[r] = simd_sum(res[r]);
+        if (lane == 0) {
+            for (int r = 0; r < RPS; ++r)
+                eo[route][sub * RPS + r] = float(HAS_GSCALE ? static_cast<T>(res[r] * inv)
+                                                            : static_cast<T>(res[r]));
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int t = int(lid); t < CH; t += SG * 32) {
+            const int c = c0 + t;
+            // kernels.mlp_tail_step: the route combine (products rounded, summed
+            // in route order), the short convolution with its next state, and
+            // the residual add.
+            float total = 0.0f;
+            {
+                #pragma clang fp contract(off)
+                for (int r = 0; r < R; ++r) {
+                    const float p = eo[r][t] * wts[r];
+                    total = p + total;
+                }
+            }
+            const T hidden = static_cast<T>(total);
+            float value = 0;
+            for (int j = 0; j < W; ++j) {
+                int p = j - W + 1;
+                float xv = p < 0 ? float(state[(p + W - 1) * N + c]) : float(hidden);
+                float w = conv_w[c * W + j];
+                value = value + xv * w;
+            }
+            const float xt = float(hidden);
+            const T conv = T((value + xt) / divisor);
+            for (int j = 0; j < W - 2; ++j) next_state[j * N + c] = state[(j + 1) * N + c];
+            next_state[(W - 2) * N + c] = xt;
+            out[c] = static_cast<T>(residual[c] + float(conv));
+        }
+        }
+        """,
+    )
+
+
+def _proj_params(proj):
+    """(weight, scales, factor or None, bits, group_size) of a switch projection."""
+    factor = None
+    if proj.__dict__.get("_factor_cache") is not None:
+        factor = proj.decode_factor()
+    elif hasattr(proj, "global_scale"):
+        factor = proj.decode_factor()
+    return proj["weight"], proj["scales"], factor, proj.bits, proj.group_size
+
+
+SUM_ORDERS = {
+    # candidate orders for the sum of the k route weights (MLX reduce)
+    "seq": "for (int i = 0; i < TOPK; ++i) total = total + w[i];",
+    "seq_rev": "for (int i = 0; i < TOPK; ++i) total = w[i] + total;",
+    "two4": "float a = 0.0f, b = 0.0f; for (int i = 0; i < 4; ++i) a = w[i] + a; "
+            "for (int i = 4; i < 8; ++i) b = w[i] + b; total = a + b;",
+    "pair": "total = ((w[0] + w[1]) + (w[2] + w[3])) + ((w[4] + w[5]) + (w[6] + w[7]));",
+}
+
+
+def _fast(k, bits):
+    """MLX dispatches fp_qmv_fast when K is a multiple of its block (two
+    32-bit packs per lane), else fp_qmv."""
+    return int(k % (2048 // bits) == 0)
+
+
+def supported(moe, x):
+    """Whether the fused kernels reproduce this SparseMoE's decode path."""
+    sw = getattr(moe, "switch_mlp", None)
+    act = getattr(sw, "activation", None)
+    if sw is None or act is None or not hasattr(act, "gate_cap"):
+        return False
+    if type(sw).__name__ != "SwitchGLU" or type(act).__name__ != "SoftcappedSwiGLU":
+        return False
+    if x.dtype != mx.bfloat16 or x.shape[:2] != (1, 1) or moe.top_k != 8:
+        return False
+    k = x.shape[-1]
+    shapes = []
+    for name in ("gate_proj", "up_proj", "down_proj"):
+        proj = getattr(sw, name)
+        if type(proj).__name__ not in ("QuantizedSwitchLinear", "ScaledQuantizedSwitchLinear"):
+            return False
+        if "bias" in proj or proj.get("biases") is not None:
+            return False
+        if (proj.mode, proj.bits, proj.group_size) not in (("nvfp4", 4, 16), ("mxfp8", 8, 32)):
+            return False
+        if type(proj).__name__ == "ScaledQuantizedSwitchLinear":
+            if "pre_quant_scale" in proj or proj.global_scale.size not in (1, proj.num_experts):
+                return False
+        shapes.append((proj.weight.shape[0], proj.weight.shape[1], proj.input_dims, proj.bits))
+    (eg, ng, kg, bg), (eu, nu, ku, bu), (ed, nd, kd, bd) = shapes
+    return (
+        eg == eu == ed and ng == nu == kd and kg == ku == nd == k and bg == bu
+        and ng % 32 == 0 and nd % 4 == 0
+    )
+
+
+def moe_gate_up(neg, scores, x, gate_proj, up_proj, top_k, route_scale,
+                gate_cap, up_cap, *, fast=None, rps=4, sg=8, sum_order="seq", dq=0, pre=0, topkm=0,
+                np_=1, idx_in=None):
+    """(act (top_k, N) in x's dtype, idx (top_k,) uint32, wts (top_k,) f32)."""
+    wg, sgs, fg, bits, gs = _proj_params(gate_proj)
+    wu, sus, fu, _, _ = _proj_params(up_proj)
+    ne, n = wg.shape[0], wg.shape[1]
+    k = x.shape[-1]
+    if fast is None:
+        fast = _fast(k, bits)
+    has_gs = fg is not None
+    dummy = neg.reshape(-1)  # an unused input (no new array in the graph)
+    rows_tg = (sg // 2) * rps if pre == 2 else sg * rps
+    assert n % rows_tg == 0 and (top_k * (n // rows_tg)) % np_ == 0 and (np_ == 1 or pre != 2)
+    kern = _gate_up_kernel_for(sum_order, route_scale, gate_cap, up_cap)
+    return kern(
+        inputs=[neg.reshape(-1), scores.reshape(-1), x.reshape(-1), wg, sgs,
+                fg if has_gs else dummy, wu, sus, fu if has_gs else dummy,
+                idx_in if idx_in is not None else dummy],
+        template=[("T", x.dtype), ("K", k), ("N", n), ("BITS", bits), ("GS", gs),
+                  ("HAS_GSCALE", has_gs), ("FAST", fast), ("RPS", rps), ("SG", sg),
+                  ("NE", ne), ("TOPK", top_k), ("DQ", dq), ("PRE", pre), ("TOPKM", topkm),
+                  ("NP", np_)],
+        grid=(top_k * (n // rows_tg) // np_ * sg * 32, 1, 1),
+        threadgroup=(sg * 32, 1, 1),
+        output_shapes=[(top_k, n), (top_k,), (top_k,)],
+        output_dtypes=[x.dtype, mx.uint32, mx.float32],
+    )
+
+
+_GU_KERNELS = {}
+
+
+def _flit(v):
+    """An exact float32 literal for a Python float."""
+    import numpy as np
+
+    f = float(np.float32(v))
+    assert np.float32(float(f"{f!r}")) == np.float32(f)
+    return f"{f!r}f"
+
+
+def _gate_up_kernel_for(sum_order, route_scale, gate_cap, up_cap):
+    key = (sum_order, route_scale, gate_cap, up_cap)
+    k = _GU_KERNELS.get(key)
+    if k is None:
+        src = (
+            _GATE_UP_SOURCE.replace("SUM_EXPR", SUM_ORDERS[sum_order])
+            .replace("ROUTE_SCALE", _flit(route_scale))
+            .replace("GCAP", _flit(gate_cap))
+            .replace("UCAP", _flit(up_cap))
+        )
+        k = mx.fast.metal_kernel(
+            name=f"inkling2_moe_gate_up_{len(_GU_KERNELS)}",
+            input_names=["neg", "scores", "x", "wg", "sg", "fg", "wu", "su", "fu", "idx_in"],
+            output_names=["act", "idx", "wts"],
+            header=_HEADER,
+            ensure_row_contiguous=True,
+            compile_options={"math_mode": "safe"},
+            source=src,
+        )
+        _GU_KERNELS[key] = k
+    return k
+
+
+def moe_down_tail(act, idx, wts, down_proj, state, conv_weight, residual, width,
+                  *, fast=None, rps=4, sg=8, dq=0, pre=0, np_=1):
+    """(out (1, 1, C) in act's dtype, next_state (1, width - 1, C) f32)."""
+    wd, sds, fd, bits, gs = _proj_params(down_proj)
+    n, k = wd.shape[1], act.shape[-1]
+    if fast is None:
+        fast = _fast(k, bits)
+    r = act.shape[0]
+    has_gs = fd is not None
+    ch = rps * (sg // r)
+    assert sg % r == 0 and n % ch == 0 and (n // ch) % np_ == 0
+    dummy = wts  # an unused input (no new array in the graph)
+    return _down_tail_kernel()(
+        inputs=[act, idx, wts, wd, sds, fd if has_gs else dummy, state,
+                conv_weight, residual, mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", act.dtype), ("K", k), ("N", n), ("BITS", bits), ("GS", gs),
+                  ("HAS_GSCALE", has_gs), ("FAST", fast), ("RPS", rps), ("SG", sg),
+                  ("R", r), ("W", width), ("DQ", dq), ("PRE", pre), ("NP", np_)],
+        grid=((n // ch) // np_ * sg * 32, 1, 1),
+        threadgroup=(sg * 32, 1, 1),
+        output_shapes=[(1, 1, n), (1, width - 1, n)],
+        output_dtypes=[act.dtype, mx.float32],
+    )
+
+
+# ---------------------------------------------------------------------------
+# Persistent MoE: the router, the gate/up + SwiGLU and the down + combine +
+# MLP tail of one decode token in ONE dispatch of NT co-resident threadgroups,
+# separated by two grid-wide barriers (device atomic counter, device-scope
+# fences; a timed-out wait sets a failure flag instead of hanging). Every
+# value is computed by the same code as router_scores / moe_gate_up /
+# moe_down_tail (same rows, lanes and order); only the work distribution over
+# threadgroups and the kernel boundaries change.
+
+_PERSIST_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sgi = simdgroup_index_in_threadgroup;
+    const uint lid = thread_position_in_threadgroup.x;
+    const int tg = threadgroup_position_in_grid.x;
+    device atomic_uint* bar = (device atomic_uint*)ctr;
+    threadgroup bool tg_fail;
+    threadgroup int sel[TOPK];
+    threadgroup float lut[16 + 256];
+    threadgroup float rtgp[8 * 8];
+    threadgroup int q_next[2];
+    // DYN: work items taken from device queues (ctr[2], ctr[3]), the next
+    // index fetched while the current item is processed.
+    #define Q_FIRST(Q, FIRST) { if (lid == 0) q_next[Q] = DYN ? int(atomic_fetch_add_explicit(bar + 2 + (Q), 1u, memory_order_relaxed)) : (FIRST); threadgroup_barrier(mem_flags::mem_threadgroup); }
+    #define Q_TAKE(Q, VAR, STEP) { VAR = q_next[Q]; threadgroup_barrier(mem_flags::mem_threadgroup); if (lid == 0) q_next[Q] = DYN ? int(atomic_fetch_add_explicit(bar + 2 + (Q), 1u, memory_order_relaxed)) : VAR + (STEP); }
+    constexpr int CH = 4;                    // down: 4 channels x 8 routes per virtual group
+    threadgroup float eo[TOPK][CH];
+    if (lid == 0) tg_fail = false;
+    if (DQ == 1) ink_fill_luts(lut, lid, 256);
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+
+    #define GRID_BARRIER(TARGET) {                                                        \
+        threadgroup_barrier(mem_flags::mem_device);                                       \
+        if (lid == 0) {                                                                    \
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device); \
+            atomic_fetch_add_explicit(bar, 1u, memory_order_relaxed);                      \
+            uint spins = 0;                                                                \
+            while (!tg_fail && atomic_load_explicit(bar, memory_order_relaxed) < (TARGET)) { \
+                if (++spins > (1u << 22)) {                                                \
+                    tg_fail = true;                                                        \
+                    atomic_store_explicit(bar + 1, 1u, memory_order_relaxed);              \
+                }                                                                          \
+            }                                                                              \
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device); \
+        }                                                                                  \
+        threadgroup_barrier(mem_flags::mem_device);                                       \
+    }
+
+    // ---- phase 1: router rows 4 tg .. 4 tg + 3 (router_scores' arithmetic)
+    if (tg < NE / 4) {
+        constexpr int BN = 8, TM = 4, TN = 4, blockN = BN * 32 * TN;
+        float result[TM] = {0, 0, 0, 0};
+        float inter[TN];
+        float v_coeff[TN];
+        int bn = (32 * int(sgi) + int(lane)) * TN;
+        const int out_row = tg * TM;
+        const device auto* m = rw + size_t(out_row) * K;
+        for (int i = 0; i < K / blockN; ++i) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = float(x[bn + tn]);
+            int mat_offset = 0;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = m[mat_offset + bn + tn];
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+                mat_offset += K;
+            }
+            bn += blockN;
+        }
+        if (K % blockN) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = bn + tn < K ? float(x[bn + tn]) : 0.0f;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = bn + tn < K ? m[tm * K + bn + tn] : 0.0f;
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+            }
+        }
+        for (int tm = 0; tm < TM; tm++)
+            for (ushort sn = 16; sn >= 1; sn >>= 1)
+                result[tm] += simd_shuffle_down(result[tm], sn);
+        threadgroup float* tgp_results = rtgp + sgi * (TM + TM);
+        if (lane == 0) {
+            for (int tm = 0; tm < TM; tm++) tgp_results[tm] = result[tm];
+            threadgroup_barrier(mem_flags::mem_none);
+            if (sgi == 0) {
+                for (int sgn = 1; sgn < BN; sgn++)
+                    for (int tm = 0; tm < TM; tm++) result[tm] += rtgp[sgn * (TM + TM) + tm];
+                for (int tm = 0; tm < TM; tm++) {
+                    const float s = result[tm];
+                    const float y = 1 / (1 + metal::precise::exp(metal::abs(s)));
+                    const float sig = (s < 0) ? y : 1 - y;
+                    scr[out_row + tm] = sig;
+                    scr[NE + out_row + tm] = -(sig + rbias[out_row + tm]);
+                }
+            }
+        }
+    }
+    GRID_BARRIER(uint(NT))
+
+    // ---- phase 2: top-k (each threadgroup), route weights (threadgroup 0),
+    //      gate/up rows + SwiGLU (moe_gate_up's arithmetic)
+    for (int t = int(lid); t < NE; t += 256) {
+        const float a = scr[NE + t];
+        int rank = 0;
+        for (int j = 0; j < NE; ++j) {
+            const float b = scr[NE + j];
+            rank += (ink_less(b, a) || (j < t && !ink_less(a, b))) ? 1 : 0;
+        }
+        if (rank < TOPK) sel[rank] = t;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (tg == 0 && lid == 0) {
+        float w[TOPK];
+        for (int i = 0; i < TOPK; ++i) w[i] = scr[sel[i]];
+        float total = 0.0f;
+        {
+            #pragma clang fp contract(off)
+            for (int i = 0; i < TOPK; ++i) total = total + w[i];
+        }
+        const float denom = total + 1e-20f;
+        for (int i = 0; i < TOPK; ++i) scr[2 * NE + i] = (w[i] / denom) * ROUTE_SCALE;
+    }
+    {
+        constexpr int RPS = 4, SG = 8, ROWS_TG = SG * RPS;
+        constexpr int TG_PER_ROUTE = N / ROWS_TG;
+        constexpr int VGU = TOPK * TG_PER_ROUTE;
+        constexpr int WROW = K * 4 / (32 / BITS);
+        constexpr int GROW = K / GS;
+        Q_FIRST(0, tg)
+        for (;;) {
+            int vtg;
+            Q_TAKE(0, vtg, NT)
+            if (vtg >= VGU) break;
+            const int route = vtg / TG_PER_ROUTE;
+            const int row0 = (vtg % TG_PER_ROUTE) * ROWS_TG + int(sgi) * RPS;
+            const int e = sel[route];
+            float rg[RPS], ru[RPS];
+            for (int r = 0; r < RPS; ++r) { rg[r] = 0.0f; ru[r] = 0.0f; }
+            const size_t wo = (size_t(e) * N + row0) * WROW;
+            const size_t so = (size_t(e) * N + row0) * GROW;
+            ink_qmv_rows<T, K, BITS, GS, FAST_GU, RPS, DQ>(
+                (const device uint8_t*)wg + wo, sg + so, x, lane, rg, lut);
+            ink_qmv_rows<T, K, BITS, GS, FAST_GU, RPS, DQ>(
+                (const device uint8_t*)wu + wo, su + so, x, lane, ru, lut);
+            float invg = 1.0f, invu = 1.0f;
+            if (HAS_GSCALE) {
+                invg = fg[e] / (448.0f * 6.0f);
+                invu = fu[e] / (448.0f * 6.0f);
+            }
+            for (int r = 0; r < RPS; ++r) {
+                rg[r] = simd_sum(rg[r]);
+                ru[r] = simd_sum(ru[r]);
+            }
+            if (lane == 0) {
+                for (int r = 0; r < RPS; ++r) {
+                    const T gb = HAS_GSCALE ? static_cast<T>(rg[r] * invg) : static_cast<T>(rg[r]);
+                    const T ub = HAS_GSCALE ? static_cast<T>(ru[r] * invu) : static_cast<T>(ru[r]);
+                    const float g = float(gb), u = float(ub);
+                    const float v = metal::precise::tanh(g / GCAP) * GCAP * ink_sigmoid(g)
+                        * metal::precise::tanh(u / UCAP) * UCAP;
+                    act[route * N + row0 + r] = static_cast<T>(v);
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+    }
+    GRID_BARRIER(uint(2 * NT))
+
+    // ---- phase 3: down rows (all routes) + combine + MLP tail
+    //      (moe_down_tail's arithmetic), CH channels per virtual group
+    {
+        constexpr int RPS = 4, SG = 8;
+        constexpr int WROW = N * 4 / (32 / BITS);
+        constexpr int GROW = N / GS;
+        constexpr int VD = K / CH;
+        const int route = int(sgi) % TOPK;
+        const int e = sel[route];
+        float inv = 1.0f;
+        if (HAS_GSCALE) inv = fd[e] / (448.0f * 6.0f);
