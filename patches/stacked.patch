+        output_shapes=[(1, 1, k), (1, width - 1, k), (top_k, n), (2 * ne + top_k,), (4,)],
+        output_dtypes=[x.dtype, mx.float32, x.dtype, mx.float32, mx.uint32],
+        init_value=0,
+    )
