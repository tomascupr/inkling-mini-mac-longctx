+"""bf16 GEMV for one decode row with MLX's per-row arithmetic (track B).
+
+MLX's gemv (gemv.h, `x @ W.T` with W row-major (N, K), N >= 16 K / 16... i.e.
+the non-split dispatch: BN = 1, SN = 32, TN = 4): lane l of the simdgroup
+that owns a row accumulates, for every 128-wide block i of K, the products
+float(W[row, 128 i + 4 l + t]) * float(x[128 i + 4 l + t]) for t = 0..3 into
+one FP32 value (result += w * v), then the 32 lanes are reduced with
+simd_shuffle_down (16, 8, 4, 2, 1) and the sum is rounded to bf16.
+Which simdgroup and threadgroup own a row does not change its value, so the
+rows per simdgroup and the threadgroup shape are free (tuned for chained
+decode); the per-row arithmetic is MLX's.
+"""
+
+from functools import lru_cache
+
+import mlx.core as mx
+
+_HEADER = r"""
+// One row block of RS rows for one simdgroup: MLX GEMVKernel::run's per-row
+// accumulation (TN = 4, blockN = 128) for K % 128 == 0.
+template <typename T, int K, int RS>
+inline void ink_gemv_rows(const device T* w, const device T* x, uint lane, thread float* result) {
+  constexpr int NI = K / 128;
+  const device T* xp = x + lane * 4;
+  const device T* wp = w + lane * 4;
+  for (int i = 0; i < NI; ++i) {
+    float v_coeff[4];
+    for (int tn = 0; tn < 4; tn++) v_coeff[tn] = static_cast<float>(xp[i * 128 + tn]);
+    for (int tm = 0; tm < RS; tm++) {
+      T inter[4];
+      for (int tn = 0; tn < 4; tn++) inter[tn] = wp[tm * K + i * 128 + tn];
+      for (int tn = 0; tn < 4; tn++) result[tm] += inter[tn] * v_coeff[tn];
+    }
+  }
+}
+"""
+
+_HOIST_HEADER = r"""
+// ink_gemv_rows with each lane's weights for HB blocks loaded (as 8-byte
+// vectors) before their products are accumulated: the same values in the same
+// order, more loads in flight.
+template <typename T, int K, int RS, int HB>
+inline void ink_gemv_rows_hoist(const device T* w, const device T* x, uint lane, thread float* result) {
+  constexpr int NI = K / 128;
+  const device T* xp = x + lane * 4;
+  const device T* wp = w + lane * 4;
+  for (int i0 = 0; i0 < NI; i0 += HB) {
+    vec<T, 4> wv[HB][RS];
+#pragma unroll
+    for (int h = 0; h < HB; ++h)
+#pragma unroll
+      for (int tm = 0; tm < RS; ++tm)
+        wv[h][tm] = (i0 + h < NI) ? *(const device vec<T, 4>*)(wp + tm * K + (i0 + h) * 128) : vec<T, 4>(0);
+#pragma unroll
+    for (int h = 0; h < HB; ++h) {
+      if (i0 + h >= NI) break;
+      float v_coeff[4];
+      for (int tn = 0; tn < 4; tn++) v_coeff[tn] = static_cast<float>(xp[(i0 + h) * 128 + tn]);
+      for (int tm = 0; tm < RS; tm++) {
+        T inter[4];
+        for (int tn = 0; tn < 4; tn++) inter[tn] = wv[h][tm][tn];
+        for (int tn = 0; tn < 4; tn++) result[tm] += inter[tn] * v_coeff[tn];
+      }
+    }
+  }
+}
+"""
+
+_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const int row0 = (int(threadgroup_position_in_grid.x) * SGS + int(sg)) * RS;
+    if (row0 >= N) return;
+    float result[RS];
+    for (int r = 0; r < RS; ++r) result[r] = 0.0f;
+    if (HB > 0) {
+        ink_gemv_rows_hoist<T, K, RS, (HB > 0 ? HB : 1)>(w + size_t(row0) * K, x, lane, result);
+    } else {
+        ink_gemv_rows<T, K, RS>(w + size_t(row0) * K, x, lane, result);
+    }
+    for (int r = 0; r < RS; ++r)
+        for (ushort sn = 16; sn >= 1; sn >>= 1) result[r] += simd_shuffle_down(result[r], sn);
+    if (lane == 0)
+        for (int r = 0; r < RS; ++r)
+            if (row0 + r < N) y[row0 + r] = static_cast<T>(result[r]);
+"""
+
+
+@lru_cache(maxsize=None)
+def _kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_gemv_rows",
+        input_names=["w", "x"],
+        output_names=["y"],
+        header=_HEADER + _HOIST_HEADER,
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_SRC,
+    )
+
+
+def gemv(x, w, *, rs=4, sgs=8, hb=0):
+    """x (..., K) one row, w (N, K) bf16 -> (..., N): x @ w.T as MLX computes it
+    for the non-split GEMV dispatch (K < 16 N)."""
+    n, k = w.shape
+    assert k % 128 == 0 and n % rs == 0
+    tgs = (n // rs + sgs - 1) // sgs
+    return _kernel()(
+        inputs=[w, x.reshape(-1)],
+        template=[("T", w.dtype), ("K", k), ("N", n), ("RS", rs), ("SGS", sgs), ("HB", hb)],
+        grid=(tgs * sgs * 32, 1, 1),
+        threadgroup=(sgs * 32, 1, 1),
+        output_shapes=[(*x.shape[:-1], n)],
+        output_dtypes=[w.dtype],
+    )[0]
+
+
+_O_TAIL_SRC = r"""
+    // Attention.__call__ after the attention for one decode token, then
+    // DecoderLayer._attn_residual: h = (attn * sigmoid(gate)).astype(bf16)
+    // (MLX's compiled AsType/Sigmoid/Multiply/AsType), y = h @ Wo.T (MLX gemv
+    // per-row arithmetic), then kernels.short_convolution_residual_step on y.
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const uint lid = thread_position_in_threadgroup.x;
+    threadgroup T h[GATED ? K : 1];
+    if (GATED) {
+        for (int k = int(lid); k < K; k += SGS * 32) {
+            const float g = float(gate[k]);
+            const float y = 1 / (1 + metal::precise::exp(metal::abs(g)));
+            const float s = (g < 0) ? y : 1 - y;
+            h[k] = static_cast<T>(float(attn[k]) * s);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+    }
+    const int row0 = (int(threadgroup_position_in_grid.x) * SGS + int(sg)) * RS;
+    if (row0 >= N) return;
+    float result[RS];
+    for (int r = 0; r < RS; ++r) result[r] = 0.0f;
+    {
+        constexpr int NI = K / 128;
+        // The gated input: staged in threadgroup memory, or (already gated by
+        // the attention kernel) read in place.
+        const threadgroup T* xh = h + (GATED ? lane * 4 : 0);
+        const device T* xa = attn + lane * 4;
+        const device T* wp = w + size_t(row0) * K + lane * 4;
+        constexpr int HBB = HB > 0 ? HB : 1;
+        for (int i0 = 0; i0 < NI; i0 += HBB) {
+            // HB > 0: the weights of HB blocks loaded first (same values and
+            // order of the arithmetic below).
+            vec<T, 4> wv[HBB][RS];
+            if (HB > 0) {
+                for (int hb = 0; hb < HBB; ++hb)
+                    for (int tm = 0; tm < RS; ++tm)
+                        wv[hb][tm] = (i0 + hb < NI)
+                            ? *(const device vec<T, 4>*)(wp + tm * K + (i0 + hb) * 128)
+                            : vec<T, 4>(0);
+            }
+            for (int hb = 0; hb < HBB; ++hb) {
+                const int i = i0 + hb;
+                if (i >= NI) break;
+                float v_coeff[4];
+                for (int tn = 0; tn < 4; tn++)
+                    v_coeff[tn] = static_cast<float>(GATED ? xh[i * 128 + tn] : xa[i * 128 + tn]);
+                for (int tm = 0; tm < RS; tm++) {
+                    T inter[4];
+                    for (int tn = 0; tn < 4; tn++)
+                        inter[tn] = HB > 0 ? wv[hb][tm][tn] : wp[tm * K + i * 128 + tn];
+                    for (int tn = 0; tn < 4; tn++) result[tm] += inter[tn] * v_coeff[tn];
+                }
+            }
+        }
+    }
+    for (int r = 0; r < RS; ++r)
+        for (ushort sn = 16; sn >= 1; sn >>= 1) result[r] += simd_shuffle_down(result[r], sn);
+    if (lane != 0) return;
+    for (int r = 0; r < RS; ++r) {
+        const int c = row0 + r;
+        const T xo = static_cast<T>(result[r]);
+        // short_convolution_residual_step for channel c
+        float value = 0;
+        for (int j = 0; j < W; ++j) {
+            int p = j - W + 1;
+            float xv = p < 0 ? float(state[(p + W - 1) * N + c]) : float(xo);
+            float wj = conv_w[c * W + j];
+            value = value + xv * wj;
+        }
+        const float xt = float(xo);
+        const T conv = T((value + xt) / divisor);
+        for (int j = 0; j < W - 2; ++j) next_state[j * N + c] = state[(j + 1) * N + c];
+        next_state[(W - 2) * N + c] = xt;
+        residual[c] = HAS_SKIP ? float(conv) + float(skip[c]) : float(conv);
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _o_tail_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_o_proj_tail",
+        input_names=["attn", "gate", "w", "state", "conv_w", "skip", "divisor"],
+        output_names=["residual", "next_state"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_O_TAIL_SRC,
+    )
+
+
+import os as _os
+
+_OTAIL_CFG = tuple(int(v) for v in _os.environ.get("MLX_VLM_INKLING2_OTAIL_CFG", "1:8:0").split(":"))
+
+
+def o_proj_tail(attn, gate, w, state, conv_weight, skip, width, *, rs=None, sgs=None):
+    """gate None: attn is already gated (the attention kernel applied it)."""
+    """One decode token: the gated attention output projected by w (N, K) and
+    the attention short convolution with its next state and the FP32 residual
+    (conv + skip unless skip is None). attn, gate: K values (bf16)."""
+    import math
+
+    rs = rs or _OTAIL_CFG[0]
+    sgs = sgs or _OTAIL_CFG[1]
+    hb = _OTAIL_CFG[2] if len(_OTAIL_CFG) > 2 else 0
+    n, k = w.shape
+    assert k % 128 == 0 and n % rs == 0
+    tgs = (n // rs + sgs - 1) // sgs
+    return tuple(_o_tail_kernel()(
+        inputs=[attn.reshape(-1), attn.reshape(-1) if gate is None else gate.reshape(-1), w,
+                state, conv_weight,
+                attn if skip is None else skip.reshape(-1),
+                mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", w.dtype), ("K", k), ("N", n), ("RS", rs), ("SGS", sgs),
+                  ("W", width), ("HAS_SKIP", skip is not None), ("GATED", gate is not None),
+                  ("HB", hb)],
+        grid=(tgs * sgs * 32, 1, 1),
+        threadgroup=(sgs * 32, 1, 1),
+        output_shapes=[(1, 1, n), (1, width - 1, n)],
+        output_dtypes=[mx.float32, mx.float32],
+    ))
