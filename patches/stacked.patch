--- a/mlx_vlm/models/inkling2_loop/msg_kernels.py	1970-01-01 01:00:00.000000000 +0100
+++ b/mlx_vlm/models/inkling2_loop/msg_kernels.py	2026-11-22 11:11:10.469752743 +0100
@@ -0,0 +1,224 @@
+"""Fused MessageGate kernels for one decode token (Inkling 2 loop, track B).
+
+MessageGate(hidden, message) =
+    gi = down(cat(rms_norm(h), rms_norm(m)).astype(bf16)).astype(f32)   # 64
+    (1 - tanh(gi @ Wf.T)) * h + tanh(gi @ Wg.T) * m                      # 2304
+for G gates at once (the batched q/k/v gates, or the MLP gate), as two
+kernels instead of ~10:
+  gate_down: per threadgroup, both RMS norms (MLX rms_single_row: D/4 virtual
+      threads of 4 elements, simd_sum, threadgroup sum, precise rsqrt), the bf16
+      cast, and 4 rows of the down GEMV with MLX's split-K gemv arithmetic
+      (K >= 16 N: BN = 8 simdgroups over K, TN = 4 per lane, shuffle-down tree,
+      sequential threadgroup sum);
+  gate_up_combine: the forget and gain GEMVs with MLX's K <= 64 gemv arithmetic
+      (4 lanes per row, TN = 4, blocks of 16, shuffle-down by 2 then 1), tanh
+      (metal::precise::tanh) and the combine.
+"""
+
+from functools import lru_cache
+
+import mlx.core as mx
+
+_DOWN_SRC = r"""
+    // grid: G * (R / 4) threadgroups of 256 threads (8 simdgroups split K).
+    constexpr int D = H;                 // hidden size
+    constexpr int NT = D / 4;            // MLX rms_single_row threads per row
+    constexpr int NVS = (NT + 31) / 32;  // their simdgroups
+    constexpr int K = 2 * D;
+    constexpr int BN = 8, TM = 4, TN = 4, blockN = BN * 32 * TN;
+    const uint lane = thread_index_in_simdgroup;
+    const uint sgN = simdgroup_index_in_threadgroup;
+    const uint lid = thread_position_in_threadgroup.x;
+    const int tg = threadgroup_position_in_grid.x;
+    const int g = tg / (R / TM);
+    const int out_row = (tg % (R / TM)) * TM;
+    const device float* hp = g == 0 ? h0 : (g == 1 ? h1 : h2);
+    const device float* mp = g == 0 ? m0 : (g == 1 ? m1 : m2);
+    threadgroup float local_sums[2][32];
+    threadgroup float inv_mean[2];
+    threadgroup bfloat16_t xin[K];
+    // rms_norm(h) and rms_norm(m): virtual thread t sums the squares of
+    // elements 4t..4t+3; virtual simdgroups NVS; same lanes as MLX.
+    if (lid < 64) local_sums[lid / 32][lid % 32] = 0;
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int v = 0; v < 2; ++v) {
+        const device float* xp = v == 0 ? hp : mp;
+        for (int vs = int(sgN); vs < NVS; vs += 8) {
+            const int t = vs * 32 + int(lane);
+            float acc = 0;
+            if (t < NT) {
+                for (int i = 0; i < 4; i++) { float xi = xp[t * 4 + i]; acc += xi * xi; }
+            }
+            acc = simd_sum(acc);
+            if (lane == 0) local_sums[v][vs] = acc;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (sgN < 2) {
+        float acc = simd_sum(local_sums[sgN][lane]);
+        if (lane == 0) inv_mean[sgN] = metal::precise::rsqrt(acc / D + eps);
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int k = int(lid); k < K; k += 256) {
+        const int v = k / D, j = k % D;
+        const float xv = (v == 0 ? hp : mp)[j];
+        xin[k] = static_cast<bfloat16_t>(1.0f * static_cast<float>(xv * inv_mean[v]));
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // down GEMV rows out_row .. out_row + 3 (MLX gemv, BM = 1, BN = 8).
+    float result[TM] = {0, 0, 0, 0};
+    bfloat16_t inter[TN];
+    float v_coeff[TN];
+    int bn = (32 * int(sgN) + int(lane)) * TN;
+    const device bfloat16_t* mat = w + size_t(g) * R * K + size_t(out_row) * K;
+    for (int i = 0; i < K / blockN; ++i) {
+        for (int tn = 0; tn < TN; tn++) v_coeff[tn] = static_cast<float>(xin[bn + tn]);
+        int mat_offset = 0;
+        for (int tm = 0; tm < TM; tm++) {
+            for (int tn = 0; tn < TN; tn++) inter[tn] = mat[mat_offset + bn + tn];
+            for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+            mat_offset += K;
+        }
+        bn += blockN;
+    }
+    if (K % blockN) {
+        // MLX load_safe: whole TN chunk when it fits, else element-guarded zeros.
+        for (int tn = 0; tn < TN; tn++)
+            v_coeff[tn] = bn + tn < K ? static_cast<float>(xin[bn + tn]) : 0.0f;
+        for (int tm = 0; tm < TM; tm++) {
+            for (int tn = 0; tn < TN; tn++)
+                inter[tn] = bn + tn < K ? mat[tm * K + bn + tn] : bfloat16_t(0);
+            for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+        }
+    }
+    for (int tm = 0; tm < TM; tm++)
+        for (ushort sn = 16; sn >= 1; sn >>= 1)
+            result[tm] += simd_shuffle_down(result[tm], sn);
+    threadgroup float tgp_memory[BN * (TM + TM)];
+    threadgroup float* tgp_results = tgp_memory + sgN * (TM + TM);
+    if (lane == 0) {
+        for (int tm = 0; tm < TM; tm++) tgp_results[tm] = result[tm];
+        threadgroup_barrier(mem_flags::mem_none);
+        if (sgN == 0) {
+            for (int sgn = 1; sgn < BN; sgn++)
+                for (int tm = 0; tm < TM; tm++) result[tm] += tgp_memory[sgn * (TM + TM) + tm];
+            for (int tm = 0; tm < TM; tm++)
+                gi[g * R + out_row + tm] = float(static_cast<bfloat16_t>(result[tm]));
+        }
+    }
+"""
+
+_UP_SRC = r"""
+    // grid: G * (H / 32 / SGT) threadgroups of SGT simdgroups; each simdgroup
+    // 32 rows (MLX gemv K <= 64: SM = 8 row groups of TM = 4, SN = 4 lanes).
+    constexpr int SM = 8, SN = 4, TM = 4, TN = 4, blockN = SN * TN;
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const int blk = int(threadgroup_position_in_grid.x) * SGT + int(sg);
+    const int g = blk / (H / 32);
+    const int row_base = (blk % (H / 32)) * 32;
+    const int thrM = int(lane) / SN, thrN = int(lane) % SN;
+    const int bm = thrM * TM;
+    const device float* x = gi + g * R;
+    const device auto* fm = wf + size_t(g) * H * R + size_t(row_base + bm) * R;
+    const device auto* gm = wg + size_t(g) * H * R + size_t(row_base + bm) * R;
+    float rf[TM] = {0, 0, 0, 0}, rg[TM] = {0, 0, 0, 0};
+    float inter[TN], v_coeff[TN];
+    int bn = thrN * TN;
+    for (int i = 0; i < R / blockN; ++i) {
+        for (int tn = 0; tn < TN; tn++) v_coeff[tn] = x[bn + tn];
+        for (int tm = 0; tm < TM; tm++) {
+            for (int tn = 0; tn < TN; tn++) inter[tn] = fm[tm * R + bn + tn];
+            for (int tn = 0; tn < TN; tn++) rf[tm] += inter[tn] * v_coeff[tn];
+        }
+        for (int tm = 0; tm < TM; tm++) {
+            for (int tn = 0; tn < TN; tn++) inter[tn] = gm[tm * R + bn + tn];
+            for (int tn = 0; tn < TN; tn++) rg[tm] += inter[tn] * v_coeff[tn];
+        }
+        bn += blockN;
+    }
+    for (int tm = 0; tm < TM; tm++) {
+        for (ushort sn = SN / 2; sn >= 1; sn >>= 1) {
+            rf[tm] += simd_shuffle_down(rf[tm], sn);
+            rg[tm] += simd_shuffle_down(rg[tm], sn);
+        }
+    }
+    if (thrN != 0) return;
+    const device float* hp = g == 0 ? h0 : (g == 1 ? h1 : h2);
+    const device float* mp = g == 0 ? m0 : (g == 1 ? m1 : m2);
+    for (int tm = 0; tm < TM; tm++) {
+        const int c = row_base + bm + tm;
+        const float tf = metal::precise::tanh(rf[tm]);
+        const float om = 1 - tf;
+        const float tg = metal::precise::tanh(rg[tm]);
+        const float hv = hp[c], mv = mp[c];
+        float r;
+        if (COMBINE == 0) {
+            #pragma clang fp contract(off)
+            const float a = om * hv;
+            const float b = tg * mv;
+            r = a + b;
+        } else if (COMBINE == 1) {
+            #pragma clang fp contract(off)
+            const float b = tg * mv;
+            r = metal::fma(om, hv, b);
+        } else {
+            #pragma clang fp contract(off)
+            const float a = om * hv;
+            r = metal::fma(tg, mv, a);
+        }
+        out[g * H + c] = r;
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _down_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_msg_gate_down",
+        input_names=["h0", "h1", "h2", "m0", "m1", "m2", "w", "eps"],
+        output_names=["gi"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_DOWN_SRC,
+    )
+
+
+@lru_cache(maxsize=None)
+def _up_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_msg_gate_up",
+        input_names=["gi", "wf", "wg", "h0", "h1", "h2", "m0", "m1", "m2"],
+        output_names=["out"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_UP_SRC,
+    )
+
+
+def message_gates(hiddens, messages, down, forget, gain, eps, *, combine=0, sgt=4):
+    """G = len(hiddens) <= 3 MessageGates of one token. hiddens, messages: G
+    FP32 arrays of H values; down (G, R, 2H) bf16; forget, gain (G, H, R) FP32.
+    Returns (G, H) FP32."""
+    g = len(hiddens)
+    r, k = down.shape[-2:]
+    h = forget.shape[-2]
+    assert k == 2 * h and r % 16 == 0 and r <= 64 and h % (32 * sgt) == 0 and h % 4 == 0
+    hs = [a.reshape(-1) for a in hiddens] + [hiddens[0].reshape(-1)] * (3 - g)
+    ms = [a.reshape(-1) for a in messages] + [messages[0].reshape(-1)] * (3 - g)
+    gi = _down_kernel()(
+        inputs=[*hs, *ms, down, mx.array(eps, mx.float32)],
+        template=[("H", h), ("R", r)],
+        grid=(g * (r // 4) * 256, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[(g * r,)],
+        output_dtypes=[mx.float32],
+    )[0]
+    return _up_kernel()(
+        inputs=[gi, forget, gain, *hs, *ms],
+        template=[("H", h), ("R", r), ("SGT", sgt), ("COMBINE", combine)],
+        grid=(g * (h // 32) * 32, 1, 1),
+        threadgroup=(sgt * 32, 1, 1),
+        output_shapes=[(g, h)],
+        output_dtypes=[mx.float32],
+    )[0]
