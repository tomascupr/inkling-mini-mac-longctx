diff -ruN -x __pycache__ a/mlx_vlm/models/inkling2/step_cache.py b/mlx_vlm/models/inkling2/step_cache.py
--- a/mlx_vlm/models/inkling2/step_cache.py	1970-01-01 01:00:00
+++ b/mlx_vlm/models/inkling2/step_cache.py	2026-11-22 02:07:20
@@ -0,0 +1,69 @@
+"""Functional views of Inkling 2 decode caches for a compiled decode step.
+
+Inside one `mx.compile` graph per decode step every step-varying quantity is an
+array: the global caches are written into their reserved buffers at an array
+offset and read whole with the true length as an array; the full sliding rings
+are written at an array index. Shapes therefore stay constant across steps and
+the trace is reused. The arithmetic is the eager decode path's: the same
+offsets, slots, biases and kernels (see Attention._decode_attention).
+"""
+
+import mlx.core as mx
+
+from ..cache import KVCache, RotatingKVCache
+
+
+class StepKVCache(KVCache):
+    """A reserved global cache: keys/values hold capacity >= offset + 1."""
+
+    def __init__(self, keys, values, offset):
+        self.keys, self.values = keys, values
+        self.offset = offset  # (,) int32: keys before this token
+        self.length = None
+
+    def update_and_fetch(self, keys, values):
+        start = self.offset.reshape(1)
+        self.keys = mx.slice_update(self.keys, keys, start, axes=(2,))
+        self.values = mx.slice_update(self.values, values, start, axes=(2,))
+        self.length = self.offset + 1
+        return self.keys, self.values
+
+
+class StepRotatingKVCache(RotatingKVCache):
+    """A full sliding ring (keep=0); `_idx` is the next write slot (array)."""
+
+    def __init__(self, keys, values, idx, max_size):
+        self.keys, self.values = keys, values
+        self._idx = idx
+        self.max_size = max_size
+        self.keep = 0
+        self.offset = max_size
+
+    def update_and_fetch(self, keys, values):
+        # RotatingKVCache._update_in_place on a full ring: wrap, write, advance.
+        slot = mx.where(self._idx == self.max_size, 0, self._idx)
+        start = slot.reshape(1)
+        self.keys = mx.slice_update(self.keys, keys, start, axes=(2,))
+        self.values = mx.slice_update(self.values, values, start, axes=(2,))
+        self._idx = slot + 1
+        return self.keys, self.values
+
+
+class StepConvCache:
+    """The four short-convolution states of one layer visit (no padding)."""
+
+    left_padding = None
+    lengths = None
+    is_speculating = False
+
+    def __init__(self, states):
+        self.cache = list(states)
+
+    def __getitem__(self, idx):
+        return self.cache[idx]
+
+    def __setitem__(self, idx, value):
+        self.cache[idx] = value
+
+    def advance(self, n):
+        pass
