+           .replace("GCAP", _flit(gate_cap)).replace("UCAP", _flit(up_cap)))
+    return mx.fast.metal_kernel(
+        name=f"inkling2_moe_persistent_{abs(hash((route_scale, gate_cap, up_cap))) % 100000}",
+        input_names=["x", "rw", "rbias", "wg", "sg", "fg", "wu", "su", "fu", "wd", "sd", "fd",
+                     "state", "conv_w", "residual", "divisor"],
+        output_names=["out", "next_state", "act", "scr", "ctr"],
+        header=_HEADER,
