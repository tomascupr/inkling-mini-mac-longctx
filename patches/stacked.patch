+
+_GATE_UP_SOURCE = r"""
+        const uint lane = thread_index_in_simdgroup;
+        const uint sgi = simdgroup_index_in_threadgroup;
+        const uint lid = thread_position_in_threadgroup.x;
+        const int tg = threadgroup_position_in_grid.x;
+        constexpr int ROWS_TG = SG * RPS;
+        constexpr int TG_PER_ROUTE = N / ROWS_TG;
+        threadgroup int sel[TOPK];
+        threadgroup float lut[16 + 256];
+        threadgroup float tneg[NE];
+        if (DQ == 1) ink_fill_luts(lut, lid, SG * 32);
+        if (TOPKM == 3) {  // the router's last threadgroup chose the experts
+            if (lid < TOPK) sel[lid] = int(idx_in[lid]);
+        } else if (TOPKM == 2) {  // timing only: fixed experts
+            if (lid < TOPK) sel[lid] = int(lid) * 13 + (neg[0] > 1e30f ? 1 : 0);
+        } else if (TOPKM == 1) {
+            // Top-k from a threadgroup copy of the router values.
+            for (int t = int(lid); t < NE; t += SG * 32) tneg[t] = neg[t];
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            for (int t = int(lid); t < NE; t += SG * 32) {
+                const float a = tneg[t];
