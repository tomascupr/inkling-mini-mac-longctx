+            ink_qmv_rows<T, N, BITS, GS, FAST_D, RPS, DQ>(
+                (const device uint8_t*)wd + (size_t(e) * K + row0) * WROW,
+                sd + (size_t(e) * K + row0) * GROW, act + route * N, lane, res, lut);
+            for (int r = 0; r < RPS; ++r) res[r] = simd_sum(res[r]);
+            if (lane == 0) {
+                for (int r = 0; r < RPS; ++r)
+                    eo[route][r] = float(HAS_GSCALE ? static_cast<T>(res[r] * inv)
+                                                    : static_cast<T>(res[r]));
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (lid < uint(CH)) {
+                const int t = lid;
+                const int c = c0 + t;
+                float total = 0.0f;
+                {
+                    #pragma clang fp contract(off)
+                    for (int r = 0; r < TOPK; ++r) {
