+        inputs=[state, weight, x, mx.array(math.sqrt(width + 1), mx.float32),
+                mx.array(param, mx.float32)],
+        template=[("T", x.dtype), ("C", c), ("E", head_dim), ("W", width), ("MODE", mode)],
+        grid=(c, 1, 1),
+        threadgroup=(head_dim, 1, 1),
+        output_shapes=[(1, 1, c // head_dim, head_dim), (1, width - 1, c)],
+        output_dtypes=[x.dtype, state.dtype],
+    )
+    return out, nxt
+
+
+@lru_cache(maxsize=1)
+def _short_convolution_residual_step():
+    return mx.fast.metal_kernel(
+        name="inkling2_short_convolution_residual_step",
+        input_names=["state", "weight", "x", "skip", "divisor"],
+        output_names=["residual", "next_state"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        uint c = thread_position_in_grid.x;
+        if (c >= C) return;
+        // short_convolution_step's arithmetic for one unmasked token ...
+        float value = 0;
+        for (int j = 0; j < W; ++j) {
+            int p = j - W + 1;
+            float xv = p < 0 ? float(state[(p + W - 1) * C + c]) : float(x[c]);
+            float w = weight[c * W + j];
+            value = value + xv * w;
+        }
+        const float xt = float(x[c]);
+        const T conv = T((value + xt) / divisor);
+        for (int j = 0; j < W - 2; ++j) next_state[j * C + c] = state[(j + 1) * C + c];
+        next_state[(W - 2) * C + c] = xt;
+        // ... then the FP32 residual: conv (+ the skip input unless at a block boundary).
+        residual[c] = HAS_SKIP ? float(conv) + float(skip[c]) : float(conv);
+        """,
+    )
+
+
+def short_convolution_residual_step(state, weight, x, skip, width):
+    """short_convolution_step for one unmasked token, returning the FP32
+    residual conv.astype(f32) (+ skip.astype(f32) if skip is given) and the
+    next state, in one kernel."""
+    c = x.shape[-1]
+    return _short_convolution_residual_step()(
+        inputs=[state, weight, x, x if skip is None else skip,
+                mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", x.dtype), ("C", c), ("W", width), ("HAS_SKIP", skip is not None)],
+        grid=(c, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[x.shape, (1, width - 1, c)],
+        output_dtypes=[mx.float32, mx.float32],
+    )
+
+
+@lru_cache(maxsize=1)
+def _rms_norm_cast():
+    # MLX rms_norm (rms_single_row, verified bitwise: 4 elements per thread,
+    # simd_sum, threadgroup sum, precise rsqrt) with an FP32 input and the
+    # weight promoted to FP32, then the result cast to the output dtype: the
+    # rms_norm and the astype as one kernel. One threadgroup of D / 4 per row.
+    return mx.fast.metal_kernel(
+        name="inkling2_rms_norm_cast",
+        input_names=["x", "w", "eps"],
+        output_names=["out"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        const uint lid = thread_position_in_threadgroup.x;
+        const uint row = threadgroup_position_in_grid.x;
+        const uint lane = thread_index_in_simdgroup;
+        const uint sg = simdgroup_index_in_threadgroup;
+        threadgroup float local_sums[32];
+        threadgroup float inv_mean[1];
+        const device I* xr = x + row * D + lid * 4;
+        float acc = 0;
+        for (int k = 0; k < 4; ++k) { float xi = xr[k]; acc += xi * xi; }
+        acc = simd_sum(acc);
+        if (sg == 0) local_sums[lane] = 0;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lane == 0) local_sums[sg] = acc;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (sg == 0) {
+            acc = simd_sum(local_sums[lane]);
+            if (lane == 0) inv_mean[0] = metal::precise::rsqrt(acc / D + eps);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int k = 0; k < 4; ++k) {
+            const float wk = HAS_W ? float(w[lid * 4 + k]) : 1.0f;
+            out[row * D + lid * 4 + k] = static_cast<O>(wk * static_cast<float>(float(xr[k]) * inv_mean[0]));
+        }
+        """,
+    )
+
+
+def rms_norm_cast(x, weight, eps, dtype):
+    """mx.fast.rms_norm(x.astype(f32), weight, eps).astype(dtype) for rows
+    x (..., D) (FP32 or BF16; weight BF16 or None) with D / 4 threads per row,
+    a multiple of 32 and at most 1024."""
+    d = x.shape[-1]
+    rows = x.size // d
+    return _rms_norm_cast()(
+        inputs=[x, x if weight is None else weight, mx.array(eps, mx.float32)],
+        template=[("I", x.dtype), ("O", dtype), ("D", d), ("HAS_W", weight is not None)],
+        grid=(rows * (d // 4), 1, 1),
+        threadgroup=(d // 4, 1, 1),
+        output_shapes=[x.shape],
+        output_dtypes=[dtype],
+    )[0]
+
+
+@lru_cache(maxsize=1)
+def _l2_clip_rows():
+    # language.l2_clip for a few rows in one kernel (one simdgroup per row):
+    # FP32 x (times the FP32 scale), the squares rounded (MLX's Square kernel:
+    # no fused multiply-add), MLX's row sum order (rows of 128: lane l adds its
+    # 4 consecutive squares, then simd_sum; rows of at most 32: sequential),
+    # precise sqrt, then x * min(threshold / (norm + 1e-6), 1) in the input dtype.
+    return mx.fast.metal_kernel(
+        name="inkling2_l2_clip_rows",
+        input_names=["x", "scale", "threshold"],
+        output_names=["out"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        const uint lane = thread_index_in_simdgroup;
+        const int row = int(threadgroup_position_in_grid.x * (threads_per_threadgroup.x / 32)
+                            + simdgroup_index_in_threadgroup);
+        if (row >= ROWS) return;
+        const int h = row % H;
+        float total = 0;
+        {
+            #pragma clang fp contract(off)
+            if (E == 128) {
+                for (int i = int(lane) * 4; i < int(lane) * 4 + 4; ++i) {
+                    float xi = float(x[row * E + i]);
+                    if (HAS_SCALE) xi = xi * float(scale[h * E + i]);
+                    const float sq = xi * xi;
+                    total = sq + total;
+                }
+                total = simd_sum(total);
+            } else {
+                if (lane == 0) {
+                    for (int i = 0; i < E; ++i) {
+                        float xi = float(x[row * E + i]);
+                        if (HAS_SCALE) xi = xi * float(scale[h * E + i]);
+                        const float sq = xi * xi;
+                        total = sq + total;
+                    }
+                }
+                total = simd_broadcast(total, 0);
+            }
+        }
+        const float factor = metal::min(threshold / (metal::precise::sqrt(total) + 1e-6f), 1.0f);
+        for (int i = int(lane); i < E; i += 32) {
+            float xi = float(x[row * E + i]);
+            if (HAS_SCALE) xi = xi * float(scale[h * E + i]);
+            out[row * E + i] = static_cast<T>(xi * factor);
+        }
+        """,
+    )
+
+
+def l2_clip_rows(x, threshold, scale=None):
+    """language.l2_clip(x, threshold, scale) for x (..., H, E) holding a few
+    rows, E == 128 or E <= 32, scale (H, E) or None."""
+    h, e = x.shape[-2:]
+    rows = x.size // e
+    return _l2_clip_rows()(
+        inputs=[x, x if scale is None else scale, mx.array(threshold, mx.float32)],
+        template=[("T", x.dtype), ("ROWS", rows), ("H", h), ("E", e),
+                  ("HAS_SCALE", scale is not None)],
+        grid=(rows * 32, 1, 1),
+        threadgroup=(32 * min(rows, 8), 1, 1),
+        output_shapes=[x.shape],
+        output_dtypes=[x.dtype],
+    )[0]
+
+
+@lru_cache(maxsize=1)
+def _router_scores():
+    # The router of one token: x.astype(f32) @ W.T as MLX's GEMV dispatches it
+    # for K >= 16 N (8 simdgroups split K, TN = 4 per lane, TM = 4 rows per
+    # threadgroup, simd_shuffle_down tree, sequential threadgroup sum), then
+    # MLX's sigmoid and -(scores + bias), in one kernel.
+    return mx.fast.metal_kernel(
+        name="inkling2_router_scores",
+        input_names=["x", "w", "bias"],
+        output_names=["scores", "neg"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        constexpr int BN = 8, TM = 4, TN = 4, blockN = BN * 32 * TN;
+        threadgroup float tgp_memory[BN * (TM + TM)];
+        const uint lane = thread_index_in_simdgroup;
+        const uint sgN = simdgroup_index_in_threadgroup;
+        float result[TM] = {0, 0, 0, 0};
+        float inter[TN];
+        float v_coeff[TN];
+        int bn = (32 * int(sgN) + int(lane)) * TN;
+        const int out_row = threadgroup_position_in_grid.x * TM;
+        const device auto* m = w + size_t(out_row) * K;  // FP32 or BF16 (exact in FP32)
+        for (int i = 0; i < K / blockN; ++i) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = float(x[bn + tn]);
+            int mat_offset = 0;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = m[mat_offset + bn + tn];
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+                mat_offset += K;
+            }
+            bn += blockN;
+        }
+        if (K % blockN) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = bn + tn < K ? float(x[bn + tn]) : 0.0f;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = bn + tn < K ? m[tm * K + bn + tn] : 0.0f;
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+            }
+        }
+        for (int tm = 0; tm < TM; tm++)
+            for (ushort sn = 16; sn >= 1; sn >>= 1)
+                result[tm] += simd_shuffle_down(result[tm], sn);
+        threadgroup float* tgp_results = tgp_memory + sgN * (TM + TM);
+        if (lane == 0) {
+            for (int tm = 0; tm < TM; tm++) tgp_results[tm] = result[tm];
+            threadgroup_barrier(mem_flags::mem_none);
+            if (sgN == 0) {
+                for (int sgn = 1; sgn < BN; sgn++)
+                    for (int tm = 0; tm < TM; tm++) result[tm] += tgp_memory[sgn * (TM + TM) + tm];
+                for (int tm = 0; tm < TM; tm++) {
+                    const float s = result[tm];
+                    const float y = 1 / (1 + metal::precise::exp(metal::abs(s)));
+                    const float sig = (s < 0) ? y : 1 - y;
+                    scores[out_row + tm] = sig;
+                    neg[out_row + tm] = -(sig + bias[out_row + tm]);
+                }
+            }
+        }
+        """,
+    )
+
+
+def router_scores(x, weight, bias):
+    """(sigmoid(x.astype(f32) @ weight.T), -(scores + bias)) for one token x
+    (..., K) and an FP32 router weight (E, K) with E % 4 == 0."""
+    e, k = weight.shape
+    shape = (*x.shape[:-1], e)
+    return _router_scores()(
+        inputs=[x.reshape(-1), weight, bias],
+        template=[("K", k)],
+        grid=(e // 4 * 256, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[shape, shape],
+        output_dtypes=[mx.float32, mx.float32],
+    )
+
+
+@lru_cache(maxsize=None)
+def _router_topk(route_scale_lit):
+    # router_scores, then the threadgroup that finishes last (device atomic
+    # counter, device-scope fences; the scores pass through atomics) computes
+    # the top-k as MLX's ArgPartition (stable ascending sort of -(s + bias))
+    # and _route_select's weights, once for the token.
+    return mx.fast.metal_kernel(
+        name=f"inkling2_router_topk_{abs(hash(route_scale_lit)) % 100000}",
+        input_names=["x", "w", "bias"],
+        output_names=["scores", "neg", "idx", "wts", "counter"],
+        ensure_row_contiguous=True,
+        atomic_outputs=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        constexpr int BN = 8, TM = 4, TN = 4, blockN = BN * 32 * TN;
+        threadgroup float tgp_memory[BN * (TM + TM)];
+        threadgroup bool tg_last;
+        threadgroup float tneg[NE];
+        threadgroup int sel[TOPK];
+        const uint lane = thread_index_in_simdgroup;
+        const uint sgN = simdgroup_index_in_threadgroup;
+        const uint lid = thread_position_in_threadgroup.x;
+        float result[TM] = {0, 0, 0, 0};
+        float inter[TN];
+        float v_coeff[TN];
+        int bn = (32 * int(sgN) + int(lane)) * TN;
+        const int out_row = threadgroup_position_in_grid.x * TM;
+        const device auto* m = w + size_t(out_row) * K;  // FP32 or BF16 (exact in FP32)
+        for (int i = 0; i < K / blockN; ++i) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = float(x[bn + tn]);
+            int mat_offset = 0;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = m[mat_offset + bn + tn];
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+                mat_offset += K;
+            }
+            bn += blockN;
+        }
+        if (K % blockN) {
+            for (int tn = 0; tn < TN; tn++) v_coeff[tn] = bn + tn < K ? float(x[bn + tn]) : 0.0f;
+            for (int tm = 0; tm < TM; tm++) {
+                for (int tn = 0; tn < TN; tn++) inter[tn] = bn + tn < K ? m[tm * K + bn + tn] : 0.0f;
+                for (int tn = 0; tn < TN; tn++) result[tm] += inter[tn] * v_coeff[tn];
+            }
+        }
+        for (int tm = 0; tm < TM; tm++)
+            for (ushort sn = 16; sn >= 1; sn >>= 1)
+                result[tm] += simd_shuffle_down(result[tm], sn);
+        threadgroup float* tgp_results = tgp_memory + sgN * (TM + TM);
+        if (lane == 0) {
+            for (int tm = 0; tm < TM; tm++) tgp_results[tm] = result[tm];
+            threadgroup_barrier(mem_flags::mem_none);
+            if (sgN == 0) {
+                for (int sgn = 1; sgn < BN; sgn++)
+                    for (int tm = 0; tm < TM; tm++) result[tm] += tgp_memory[sgn * (TM + TM) + tm];
+                for (int tm = 0; tm < TM; tm++) {
+                    const float s = result[tm];
+                    const float y = 1 / (1 + metal::precise::exp(metal::abs(s)));
+                    const float sig = (s < 0) ? y : 1 - y;
+                    atomic_store_explicit(&scores[out_row + tm], sig, memory_order_relaxed);
+                    atomic_store_explicit(&neg[out_row + tm], -(sig + bias[out_row + tm]), memory_order_relaxed);
+                }
+            }
+        }
+        threadgroup_barrier(mem_flags::mem_device);
+        if (lid == 0) {
+            atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+            const uint prev = atomic_fetch_add_explicit(&counter[0], 1u, memory_order_relaxed);
+            tg_last = (prev == uint(threadgroups_per_grid.x) - 1u);
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (!tg_last) return;
+        atomic_thread_fence(mem_flags::mem_device, memory_order_seq_cst, thread_scope_device);
+        for (int t = int(lid); t < NE; t += 256)
+            tneg[t] = atomic_load_explicit(&neg[t], memory_order_relaxed);
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        for (int t = int(lid); t < NE; t += 256) {
+            const float a = tneg[t];
+            int rank = 0;
+            for (int j = 0; j < NE; ++j) {
+                const float b = tneg[j];
+                bool lt_ba, lt_ab;
+                { bool an = metal::isnan(b), bn2 = metal::isnan(a); lt_ba = (an | bn2) ? ((!an) & bn2) : (b < a); }
+                { bool an = metal::isnan(a), bn2 = metal::isnan(b); lt_ab = (an | bn2) ? ((!an) & bn2) : (a < b); }
+                rank += (lt_ba || (j < t && !lt_ab)) ? 1 : 0;
+            }
+            if (rank < TOPK) sel[rank] = t;
+        }
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lid == 0) {
+            float wv[TOPK];
+            for (int i = 0; i < TOPK; ++i) wv[i] = atomic_load_explicit(&scores[sel[i]], memory_order_relaxed);
+            float total = 0.0f;
+            {
+                #pragma clang fp contract(off)
+                for (int i = 0; i < TOPK; ++i) total = total + wv[i];
+            }
+            const float denom = total + 1e-20f;
+            for (int i = 0; i < TOPK; ++i) {
+                atomic_store_explicit(&idx[i], uint(sel[i]), memory_order_relaxed);
+                atomic_store_explicit(&wts[i], (wv[i] / denom) * ROUTE_SCALE, memory_order_relaxed);
+            }
+        }
+        """.replace("ROUTE_SCALE", route_scale_lit),
+    )
+
+
+def router_topk(x, weight, bias, top_k, route_scale):
+    """router_scores plus the top-k routes and their weights (as
+    _route_select computes them) from the last threadgroup:
+    (scores, neg, idx (top_k,) uint32, wts (top_k,) f32)."""
+    import numpy as np
+
+    e, k = weight.shape
+    f = float(np.float32(route_scale))
+    lit = f"{f!r}f"
+    shape = (*x.shape[:-1], e)
+    scores, neg, idx, wts, _ = _router_topk(lit)(
+        inputs=[x.reshape(-1), weight, bias],
+        template=[("K", k), ("NE", e), ("TOPK", top_k)],
+        grid=(e // 4 * 256, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[shape, shape, (top_k,), (top_k,), (1,)],
+        output_dtypes=[mx.float32, mx.float32, mx.uint32, mx.float32, mx.uint32],
+        init_value=0,
+    )
+    return scores, neg, idx, wts
+
+
+@lru_cache(maxsize=1)
+def _mlp_tail_step():
+    return mx.fast.metal_kernel(
+        name="inkling2_mlp_tail_step",
+        input_names=["experts", "weights", "state", "conv_w", "residual", "divisor"],
+        output_names=["out", "next_state"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        uint c = thread_position_in_grid.x;
+        if (c >= C) return;
+        // _combine_routes: FP32 products (each rounded, as MLX's separate
+        // multiply kernel: no fused multiply-add) summed over the routes in
+        // order (as MLX's column reduction), rounded to the experts' dtype.
+        float total = 0.0f;
+        {
+            #pragma clang fp contract(off)
+            for (int r = 0; r < R; ++r) {
+                const float p = float(experts[r * C + c]) * weights[r];
+                total = p + total;
+            }
+        }
+        const T hidden = static_cast<T>(total);
+        // mlp_sconv on the one unmasked token (short_convolution_step).
+        float value = 0;
+        for (int j = 0; j < W; ++j) {
+            int p = j - W + 1;
+            float xv = p < 0 ? float(state[(p + W - 1) * C + c]) : float(hidden);
+            float w = conv_w[c * W + j];
+            value = value + xv * w;
+        }
+        const float xt = float(hidden);
+        const T conv = T((value + xt) / divisor);
+        for (int j = 0; j < W - 2; ++j) next_state[j * C + c] = state[(j + 1) * C + c];
+        next_state[(W - 2) * C + c] = xt;
+        // The layer output: (residual + conv as FP32) in the layer's dtype.
+        out[c] = static_cast<T>(residual[c] + float(conv));
+        """,
+    )
+
+
+def mlp_tail_step(experts, weights, state, conv_weight, residual, width):
+    """One unmasked decode token: _combine_routes(experts, weights), then the
+    short convolution (with its next FP32 state) and the residual add, in one
+    kernel. experts (1, 1, R, C); weights (1, 1, R) FP32; state (1, W-1, C) FP32;
+    conv_weight (C, W, 1); residual (1, 1, C) FP32. Returns (out, next_state)."""
+    r, c = experts.shape[-2:]
+    return _mlp_tail_step()(
+        inputs=[experts.reshape(r, c), weights.reshape(r), state, conv_weight,
+                residual, mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", experts.dtype), ("C", c), ("R", r), ("W", width)],
+        grid=(c, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[(1, 1, c), (1, width - 1, c)],
+        output_dtypes=[experts.dtype, mx.float32],
+    )
+
+
+@lru_cache(maxsize=1)
+def _attention_residual_q1():
+    # One threadgroup of D / 4 threads computes, for n <= 8 states, exactly the
+    # kernels that _attention_residual(states, query (D,), True) dispatches,
+    # in their arithmetic order (verified bitwise against MLX):
+    #  rms_norm per row (rms_single_row: 4 elements per thread, simd_sum,
+    #  threadgroup sum, precise rsqrt), the scores GEMV (gemv split over 8
+    #  simdgroups: TN = 4 per lane, simd_shuffle_down tree, sequential
+    #  threadgroup sum), the scale, the softmax over the states as max,
+    #  precise exp, sequential sum, division, and the GEMV_T over the states
+    #  (rows in groups of 4, groups combined by the shuffle tree).
+    return mx.fast.metal_kernel(
+        name="inkling2_attention_residual_q1",
+        input_names=["states", "query", "scale"],
+        output_names=["out", "keys"],
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        // Rows are processed in parallel; each row's reductions keep MLX's
+        // lane assignment and order (thread t: elements 4t..4t+3 of the row).
+        const uint lid = thread_position_in_threadgroup.x;
+        const uint lane = thread_index_in_simdgroup;
+        const uint sg = simdgroup_index_in_threadgroup;
+        constexpr int NT = D / 4;
+        threadgroup float local_sums[NS][32];
+        threadgroup float inv_mean[NS];
+        threadgroup float partial[NS][8];
+        threadgroup float scores[NS];
+        if (lid < uint(NS * 32)) local_sums[lid / 32][lid % 32] = 0;
+        threadgroup_barrier(mem_flags::mem_threadgroup);
+        if (lid < uint(NT)) {
+            for (int i = 0; i < NS; ++i) {
+                const device T* xr = states + i * D + lid * 4;
+                float acc = 0;
+                for (int k = 0; k < 4; ++k) { float xi = xr[k]; acc += xi * xi; }
+                acc = simd_sum(acc);
+                if (lane == 0) local_sums[i][sg] = acc;
+            }
+        }
