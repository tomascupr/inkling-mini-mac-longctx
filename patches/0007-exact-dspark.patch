+++ b/mlx_vlm/models/inkling2/verify_kernels.py
@@ -0,0 +1,1445 @@
+"""Multi-row attention kernels for the exact k-row verifier (track B3).
+
+Every row r of a verify block is computed as the compiled single-token decode
+step computes position offset + r: the kernels below are derived from the
+decode kernels by text substitution (asserted), so every arithmetic line is
+the decode kernel's own. Only the indexing changes:
+- a row index (grid z) selects the row's query, bias, sink, gate and output;
+- the block's new K/V rows come from a side buffer (R, HKV, D) instead of the
+  cache buffer: global keys at positions >= base, sliding keys at the ring
+  slots s0 .. s0 + r. They hold the same values the decode step would have
+  written into the cache before its attention, so each row reads exactly the
+  keys and values of its decode step.
+"""
+
+from functools import lru_cache
+
+import mlx.core as mx
+
+from . import attn_kernels as _ak
+from . import kernels as _k
+
+
+def _sub(src, old, new, count=1):
+    n = src.count(old)
+    if n != count:
+        raise RuntimeError(f"verify_kernels: expected {count} x {old!r}, found {n}")
+    return src.replace(old, new)
+
+
+# Block counts are run-time inputs and the combine's threadgroup arrays have a
+# fixed size, so the kernels do not depend on the cache capacity (one Metal
+# compile for every request length; arithmetic unchanged).
+_NBMAX = 3072
+
+# --------------------------------------------------------------------------
+# Global layers: kernels._DECODE_PARTIALS_SRC / _DECODE_COMBINE2_SRC per row.
+
+_GP = _k._DECODE_PARTIALS_SRC
+_GP = _sub(_GP, "const int S = sizes[0];",
+           "const int vrow = threadgroup_position_in_grid.z;\n"
+           "        const int S = sizes[vrow];\n"
+           "        const int base = new_base[0];")
+_GP = _sub(_GP, "qv[h][e] = float(q[(g * G + h) * D + lane * E + e]) * sc;",
+           "qv[h][e] = float(q[(vrow * HQ + g * G + h) * D + lane * E + e]) * sc;")
+_GP = _sub(_GP, "if (NEWROW && j == S - 1) {", "if (NEWROW && j >= base) {")
+_GP = _sub(_GP, "kv[e] = float(k_new[g * D + lane * E + e]);",
+           "kv[e] = float(k_new[((j - base) * HKV + g) * D + lane * E + e]);")
+_GP = _sub(_GP, "vv[e] = float(v_new[g * D + lane * E + e]);",
+           "vv[e] = float(v_new[((j - base) * HKV + g) * D + lane * E + e]);")
+_GP = _sub(_GP, "if (dist < REL) s += float(rel[(g * G + h) * REL + dist]);",
+           "if (dist < REL) s += float(rel[(vrow * HQ + g * G + h) * REL + dist]);")
+_GP = _sub(_GP, "const int row = block * HQ + g * G + h;",
+           "const int row = (vrow * nbk[0] + block) * HQ + g * G + h;")
+
+_GC = _k._DECODE_COMBINE2_SRC
+_GC = _sub(_GC, "const int lid = thread_position_in_threadgroup.x;",
+           "const int lid = thread_position_in_threadgroup.x;\n"
+           "        const int vrow = threadgroup_position_in_grid.z;")
+_GC = _sub(_GC, "const int nblocks = sizes[1];", "const int nblocks = sizes[vrow * 2 + 1];")
+_GC = _sub(_GC, "part_max[b * HQ + h]", "part_max[(vrow * nbk[0] + b) * HQ + h]", count=2)
+_GC = _sub(_GC, "tsum[b] = part_sum[b * HQ + h];", "tsum[b] = part_sum[(vrow * nbk[0] + b) * HQ + h];")
+_GC = _sub(_GC, "part_acc[size_t((b0 + i) * HQ + h) * D + d]",
+           "part_acc[size_t((vrow * nbk[0] + b0 + i) * HQ + h) * D + d]")
+_GC = _sub(_GC, "float(sinks[h])", "float(sinks[vrow * HQ + h])", count=2)
+_GC = _sub(_GC, "const float g = float(gate[h * D + d]);",
+           "const float g = float(gate[(vrow * HQ + h) * D + d]);")
+_GC = _sub(_GC, "out[h * D + d] =", "out[(vrow * HQ + h) * D + d] =", count=2)
+
+
+@lru_cache(maxsize=None)
+def _global_partials():
+    # Same (default) compile options as kernels._decode_partials.
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_global_partials",
+        input_names=["q", "k", "v", "rel", "key_start", "sizes", "scale", "k_new", "v_new",
+                     "new_base", "nbk"],
+        output_names=["part_max", "part_sum", "part_acc"],
+        ensure_row_contiguous=False,
+        source=_GP,
+    )
+
+
+@lru_cache(maxsize=None)
+def _global_combine():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_global_combine2",
+        input_names=["part_max", "part_sum", "part_acc", "sinks", "sizes", "gate", "nbk"],
+        output_names=["out"],
+        source=_GC,
+    )
+
+
+def global_rows(q, k, v, k_new, v_new, base, rel, sinks, gate, *, scale):
+    """R decode rows of a global layer at positions base .. base + R - 1.
+
+    q (R, HQ, D); k, v (1, HKV, cap, D) the cache buffers (rows >= base not
+    read); k_new, v_new (R, HKV, D) the block's rows; base () int32; rel
+    (R, HQ, REL); sinks (R, HQ); gate (R, HQ * D). Returns (R, HQ, D): row r
+    is kernels.decode_attention(q[r], ..., length=base + r + 1, gate=gate[r])
+    on the cache with rows 0..r written."""
+    R, hq, d = q.shape
+    hkv, cap = k.shape[1], k.shape[2]
+    nb = (cap + _k._DECODE_BLOCK - 1) // _k._DECODE_BLOCK
+    assert d % 32 == 0 and nb <= 3072 and _k._COMBINE2
+    base = base.reshape(1).astype(mx.int32)
+    lengths = base + 1 + mx.arange(R, dtype=mx.int32)
+    zero = mx.zeros((1,), mx.int32)
+    part_max, part_sum, part_acc = _global_partials()(
+        inputs=[mx.contiguous(q), k, v, mx.contiguous(rel), zero, lengths,
+                mx.array(scale, dtype=mx.float32), mx.contiguous(k_new), mx.contiguous(v_new),
+                base, mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("REL", rel.shape[-1]),
+                  ("BS", _k._DECODE_BLOCK), ("SG", _k._DECODE_SIMDGROUPS), ("NEWROW", True)],
+        grid=(nb * 32 * _k._DECODE_SIMDGROUPS, hkv, R),
+        threadgroup=(32 * _k._DECODE_SIMDGROUPS, 1, 1),
+        output_shapes=[(R * nb * hq,), (R * nb * hq,), (R * nb * hq, d)],
+        output_dtypes=[mx.float32, mx.float32, mx.float32],
+    )
+    csizes = mx.stack([lengths, (lengths + (_k._DECODE_BLOCK - 1)) // _k._DECODE_BLOCK], axis=1)
+    return _global_combine()(
+        inputs=[part_max, part_sum, part_acc, sinks.astype(mx.float32), csizes,
+                mx.contiguous(gate), mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("DT", 32),
+                  ("NBMAX", _NBMAX), ("HAS_GATE", True)],
+        grid=(hq * d, 1, R),
+        threadgroup=(32, 1, 1),
+        output_shapes=[(R, hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+
+
+# --------------------------------------------------------------------------
+# Sliding layers: attn_kernels' MLX-layout two-pass SDPA (_P1M_SRC, _P2G_SRC).
+# Row r: ring slots s0 .. s0 + r (mod N) hold the block's rows 0..r, every
+# other slot the ring as it was before the block; ring_idx[r] = next write
+# slot after row r (StepRotatingKVCache._idx).
+
+_SP = _ak._P1M_SRC
+_SP = _sub(_SP, "const int h = kvh * G + g;",
+           "const int h = kvh * G + g;\n    const int vrow = int(threadgroup_position_in_grid.z);")
+_SP = _sub(_SP, "const int widx = BIAS == 1 ? ring_idx[0] : 0;",
+           "const int widx = BIAS == 1 ? ring_idx[vrow] : 0;")
+_SP = _sub(_SP, "q[i] = static_cast<float>(scale) * queries[h * D + simd_lid * QK + i];",
+           "q[i] = static_cast<float>(scale) * queries[(vrow * HQ + h) * D + simd_lid * QK + i];")
+_SP = _sub(_SP, "max_score = static_cast<float>(sinks[h]);",
+           "max_score = static_cast<float>(sinks[vrow * HQ + h]);")
+_SP = _sub(_SP, "if (NEWROW && ii == nslot) {",
+           "int dp = (ii - nslot) % N;\n"
+           "            if (dp < 0) dp += N;\n"
+           "            if (NEWROW && dp <= vrow) {")
+_SP = _sub(_SP, "k_reg[t][j] = k_new[kvh * D + simd_lid * QK + j];",
+           "k_reg[t][j] = k_new[(dp * HKV + kvh) * D + simd_lid * QK + j];")
+_SP = _sub(_SP, "v_reg[t][j] = v_new[kvh * D + simd_lid * QK + j];",
+           "v_reg[t][j] = v_new[(dp * HKV + kvh) * D + simd_lid * QK + j];")
+_SP = _sub(_SP, "if (NEWROW && i == nslot) {",
+           "int dp = (i - nslot) % N;\n"
+           "        if (dp < 0) dp += N;\n"
+           "        if (NEWROW && dp <= vrow) {")
+_SP = _sub(_SP, "kr[j] = static_cast<float>(k_new[kvh * D + simd_lid * QK + j]);",
+           "kr[j] = static_cast<float>(k_new[(dp * HKV + kvh) * D + simd_lid * QK + j]);")
+_SP = _sub(_SP, "vr[j] = static_cast<float>(v_new[kvh * D + simd_lid * QK + j]);",
+           "vr[j] = static_cast<float>(v_new[(dp * HKV + kvh) * D + simd_lid * QK + j]);")
+_SP = _sub(_SP, "mv = dist < REL ? rel[h * REL + dist] : T(0);",
+           "mv = dist < REL ? rel[(vrow * HQ + h) * REL + dist] : T(0);", count=2)
+_SP = _sub(_SP, "const int row = h * BLOCKS + block_idx;",
+           "const int row = (vrow * HQ + h) * BLOCKS + block_idx;")
+
+_SC = _ak._P2G_SRC
+_SC = _sub(_SC, "const int q_offset = threadgroup_position_in_grid.x;",
+           "const int q_offset = int(threadgroup_position_in_grid.z) * HQ"
+           " + int(threadgroup_position_in_grid.x);")
+
+
+@lru_cache(maxsize=None)
+def _sliding_p1():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_sliding_p1",
+        input_names=["queries", "keys", "values", "mask", "rel", "ring_idx", "sinks", "scale",
+                     "k_new", "v_new", "new_slot"],
+        output_names=["partials", "sums", "maxs"],
+        ensure_row_contiguous=False,
+        compile_options={"math_mode": "safe"},
+        source=_SP,
+    )
+
+
+@lru_cache(maxsize=None)
+def _sliding_p2():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_sliding_p2",
+        input_names=["partials", "sums", "maxs", "gate"],
+        output_names=["out"],
+        compile_options={"math_mode": "safe"},
+        source=_SC,
+    )
+
+
+def sliding_rows(q, k, v, k_new, v_new, s0, rel, sinks, gate, *, scale, blocks=64, tk=None):
+    """R decode rows of a sliding layer. q (R, HQ, D); k, v (1, HKV, N, D) the
+    full ring before the block; k_new, v_new (R, HKV, D); s0 () int32 the
+    slot of row 0; rel (R, HQ, REL); sinks (R, HQ) in q's dtype; gate
+    (R, HQ * D). Row r is attn_kernels.sliding_attention on the ring with
+    rows 0..r written (ring_idx = slot of row r + 1), gated."""
+    R, hq, d = q.shape
+    hkv, n = k.shape[1], k.shape[2]
+    assert d % 32 == 0 and hq % hkv == 0 and blocks % 32 == 0
+    s0 = s0.reshape(1).astype(mx.int32)
+    ring_idx = (s0 + mx.arange(R, dtype=mx.int32)) % n + 1
+    part, sums, maxs = _sliding_p1()(
+        inputs=[mx.contiguous(q), k, v, q, mx.contiguous(rel), ring_idx, mx.contiguous(sinks),
+                mx.array(scale, mx.float32), mx.contiguous(k_new), mx.contiguous(v_new), s0],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("N", n),
+                  ("BLOCKS", blocks), ("BIAS", 1), ("NEWROW", True),
+                  ("REL", rel.shape[-1]), ("TKP", tk or _ak._SDPA_TK)],
+        grid=(hkv * blocks * 32, hq // hkv, R),
+        threadgroup=(32, hq // hkv, 1),
+        output_shapes=[(R * hq * blocks, d), (R * hq * blocks,), (R * hq * blocks,)],
+        output_dtypes=[q.dtype, mx.float32, mx.float32],
+    )
+    return _sliding_p2()(
+        inputs=[part, sums, maxs, mx.contiguous(gate)],
+        template=[("T", q.dtype), ("D", d), ("BLOCKS", blocks), ("HAS_GATE", True), ("HQ", hq)],
+        grid=(hq * 1024, 1, R),
+        threadgroup=(1024, 1, 1),
+        output_shapes=[(R, hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+
+
+# --------------------------------------------------------------------------
+# Global layers, shared reads: one threadgroup per (key block, KV head) for
+# ALL rows. Simdgroup (sg, rg) walks the keys of decode simdgroup sg
+# (start + sg, + SG, ...) for the RPS rows of row group rg, so the RG
+# simdgroups of one sg read the same K/V rows (L1) and the block is read from
+# DRAM once. Per row the arithmetic is the decode kernel's line for line
+# (kernels._DECODE_PARTIALS_SRC): the same keys per simdgroup in the same
+# order, the same per-key update, the same cross-simdgroup combine (one row
+# per round through threadgroup memory).
+
+_GPS = r"""
+        constexpr int G = HQ / HKV;
+        constexpr int E = D / 32;
+        const uint lane = thread_index_in_simdgroup;
+        const int sidx = int(simdgroup_index_in_threadgroup);
+        const int sg = sidx % SG;
+        const int rg = sidx / SG;
+        const int block = threadgroup_position_in_grid.x;
+        const int g = threadgroup_position_in_grid.y;
+        const int base = new_base[0];
+        const int start = block * BS;
+        const int Smax = base + R;
+        if (start >= Smax) return;
+        const int end_max = min(start + BS, Smax);
+        const float sc = scale;
+
+        float qv[RPS][G][E];
+        float m[RPS][G], l[RPS][G], acc[RPS][G][E];
+        for (int i = 0; i < RPS; ++i) {
+            const int r = min(rg * RPS + i, R - 1);
+            for (int h = 0; h < G; ++h) {
+                for (int e = 0; e < E; ++e)
+                    qv[i][h][e] = float(q[(r * HQ + g * G + h) * D + lane * E + e]) * sc;
+                m[i][h] = -INFINITY;
+                l[i][h] = 0.0f;
+                for (int e = 0; e < E; ++e) acc[i][h][e] = 0.0f;
+            }
+        }
+        const device T* k_head = k + g * k_strides[1];
+        const device T* v_head = v + g * v_strides[1];
+        int j = start + sg;
+        vec<T, E> k_next = vec<T, E>(0), v_next = vec<T, E>(0);
+        if (j < end_max) {
+            k_next = *(const device vec<T, E>*)(k_head + size_t(j) * k_strides[2] + lane * E);
+            v_next = *(const device vec<T, E>*)(v_head + size_t(j) * v_strides[2] + lane * E);
+        }
+        for (; j < end_max; j += SG) {
+            float kv[E], vv[E];
+            for (int e = 0; e < E; ++e) {
+                kv[e] = float(k_next[e]);
+                vv[e] = float(v_next[e]);
+            }
+            if (j >= base) {
+                // A block row: the value its decode step wrote at position j.
+                for (int e = 0; e < E; ++e) {
+                    kv[e] = float(k_new[((j - base) * HKV + g) * D + lane * E + e]);
+                    vv[e] = float(v_new[((j - base) * HKV + g) * D + lane * E + e]);
+                }
+            }
+            if (j + SG < end_max) {
+                const size_t jn = size_t(j + SG);
+                k_next = *(const device vec<T, E>*)(k_head + jn * k_strides[2] + lane * E);
+                v_next = *(const device vec<T, E>*)(v_head + jn * v_strides[2] + lane * E);
+            }
+            for (int i = 0; i < RPS; ++i) {
+                const int r = rg * RPS + i;
+                const int S = base + r + 1;
+                if (r >= R || j >= S) continue;
+                const int dist = S - 1 - j;
+                for (int h = 0; h < G; ++h) {
+                    float s = 0.0f;
+                    for (int e = 0; e < E; ++e) s += qv[i][h][e] * kv[e];
+                    s = simd_sum(s);
+                    if (dist < REL) s += float(rel[(r * HQ + g * G + h) * REL + dist]);
+                    const float mn = max(m[i][h], s);
+                    const float f = metal::exp(m[i][h] - mn);
+                    const float p = metal::exp(s - mn);
+                    l[i][h] = l[i][h] * f + p;
+                    for (int e = 0; e < E; ++e) acc[i][h][e] = acc[i][h][e] * f + p * vv[e];
+                    m[i][h] = mn;
+                }
+            }
+        }
+
+        threadgroup float tm[SG][G];
+        threadgroup float tl[SG][G];
+        threadgroup float ta[SG][G][D];
+        for (int rr = 0; rr < R; ++rr) {
+            const int owner = rr / RPS;
+            const int i = rr % RPS;
+            const bool live = start < base + rr + 1;  // the decode step writes this block
+            if (rg == owner) {
+                for (int h = 0; h < G; ++h) {
+                    if (lane == 0) {
+                        tm[sg][h] = m[i][h];
+                        tl[sg][h] = l[i][h];
+                    }
+                    for (int e = 0; e < E; ++e) ta[sg][h][lane * E + e] = acc[i][h][e];
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (live) {
+                for (uint t = thread_position_in_threadgroup.x; t < uint(G * D); t += SG * RG * 32) {
+                    const int h = t / D, d = t % D;
+                    float M = -INFINITY;
+                    for (int s = 0; s < SG; ++s) M = max(M, tm[s][h]);
+                    float L = 0.0f, A = 0.0f;
+                    if (M > -INFINITY) {
+                        for (int s = 0; s < SG; ++s) {
+                            const float w = metal::exp(tm[s][h] - M);
+                            L += tl[s][h] * w;
+                            A += ta[s][h][d] * w;
+                        }
+                    }
+                    const int row = (rr * nbk[0] + block) * HQ + g * G + h;
+                    part_acc[size_t(row) * D + d] = A;
+                    if (d == 0) {
+                        part_max[row] = M;
+                        part_sum[row] = L;
+                    }
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+"""
+
+
+@lru_cache(maxsize=None)
+def _global_partials_shared():
+    # Same (default) compile options as kernels._decode_partials.
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_global_partials_shared",
+        input_names=["q", "k", "v", "rel", "scale", "k_new", "v_new", "new_base", "nbk"],
+        output_names=["part_max", "part_sum", "part_acc"],
+        ensure_row_contiguous=False,
+        source=_GPS,
+    )
+
+
+def global_rows_shared(q, k, v, k_new, v_new, base, rel, sinks, gate, *, scale, rps=1):
+    """global_rows with each K/V block read once for all rows."""
+    R, hq, d = q.shape
+    hkv, cap = k.shape[1], k.shape[2]
+    nb = (cap + _k._DECODE_BLOCK - 1) // _k._DECODE_BLOCK
+    assert d % 32 == 0 and nb <= 3072 and _k._COMBINE2 and hq // hkv == 3
+    rps = max(1, min(int(rps), R))
+    rg = (R + rps - 1) // rps
+    sg = _k._DECODE_SIMDGROUPS
+    assert sg * rg * 32 <= 1024
+    base = base.reshape(1).astype(mx.int32)
+    lengths = base + 1 + mx.arange(R, dtype=mx.int32)
+    part_max, part_sum, part_acc = _global_partials_shared()(
+        inputs=[mx.contiguous(q), k, v, mx.contiguous(rel), mx.array(scale, dtype=mx.float32),
+                mx.contiguous(k_new), mx.contiguous(v_new), base, mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("REL", rel.shape[-1]),
+                  ("BS", _k._DECODE_BLOCK), ("SG", sg), ("R", R), ("RPS", rps), ("RG", rg)],
+        grid=(nb * 32 * sg * rg, hkv, 1),
+        threadgroup=(32 * sg * rg, 1, 1),
+        output_shapes=[(R * nb * hq,), (R * nb * hq,), (R * nb * hq, d)],
+        output_dtypes=[mx.float32, mx.float32, mx.float32],
+    )
+    csizes = mx.stack([lengths, (lengths + (_k._DECODE_BLOCK - 1)) // _k._DECODE_BLOCK], axis=1)
+    return _global_combine()(
+        inputs=[part_max, part_sum, part_acc, sinks.astype(mx.float32), csizes,
+                mx.contiguous(gate), mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("DT", 32),
+                  ("NBMAX", _NBMAX), ("HAS_GATE", True)],
+        grid=(hq * d, 1, R),
+        threadgroup=(32, 1, 1),
+        output_shapes=[(R, hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+
+
+# --------------------------------------------------------------------------
+# bf16 GEMV for M rows with gemv_kernels' per-row arithmetic (the decode
+# step's projections: rs, sgs, hb = 1, 8, 18): each weight block is loaded
+# once and accumulated into every row's result in the decode order.
+
+_GEMV_M_HEADER = r"""
+template <typename T, int K, int RS, int HB, int M>
+inline void ink_gemv_rows_hoist_m(const device T* w, const device T* x, uint lane,
+                                  thread float (*result)[M]) {
+  constexpr int NI = K / 128;
+  const device T* xp = x + lane * 4;
+  const device T* wp = w + lane * 4;
+  for (int i0 = 0; i0 < NI; i0 += HB) {
+    vec<T, 4> wv[HB][RS];
+#pragma unroll
+    for (int h = 0; h < HB; ++h)
+#pragma unroll
+      for (int tm = 0; tm < RS; ++tm)
+        wv[h][tm] = (i0 + h < NI) ? *(const device vec<T, 4>*)(wp + tm * K + (i0 + h) * 128) : vec<T, 4>(0);
+#pragma unroll
+    for (int h = 0; h < HB; ++h) {
+      if (i0 + h >= NI) break;
+      for (int mm = 0; mm < M; ++mm) {
+        float v_coeff[4];
+        for (int tn = 0; tn < 4; tn++) v_coeff[tn] = static_cast<float>(xp[mm * K + (i0 + h) * 128 + tn]);
+        for (int tm = 0; tm < RS; tm++) {
+          T inter[4];
+          for (int tn = 0; tn < 4; tn++) inter[tn] = wv[h][tm][tn];
+          for (int tn = 0; tn < 4; tn++) result[tm][mm] += inter[tn] * v_coeff[tn];
+        }
+      }
+    }
+  }
+}
+"""
+
+_GEMV_M_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const int row0 = (int(threadgroup_position_in_grid.x) * SGS + int(sg)) * RS;
+    if (row0 >= N) return;
+    float result[RS][M];
+    for (int r = 0; r < RS; ++r)
+        for (int mm = 0; mm < M; ++mm) result[r][mm] = 0.0f;
+    ink_gemv_rows_hoist_m<T, K, RS, HB, M>(w + size_t(row0) * K, x, lane, result);
+    for (int r = 0; r < RS; ++r)
+        for (int mm = 0; mm < M; ++mm)
+            for (ushort sn = 16; sn >= 1; sn >>= 1) result[r][mm] += simd_shuffle_down(result[r][mm], sn);
+    if (lane == 0)
+        for (int r = 0; r < RS; ++r)
+            if (row0 + r < N)
+                for (int mm = 0; mm < M; ++mm) y[mm * N + row0 + r] = static_cast<T>(result[r][mm]);
+"""
+
+
+@lru_cache(maxsize=None)
+def _gemv_m_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_gemv_m",
+        input_names=["w", "x"],
+        output_names=["y"],
+        header=_GEMV_M_HEADER,
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_GEMV_M_SRC,
+    )
+
+
+def gemv_m(x, w, *, rs=1, sgs=8, hb=18):
+    """x (M, K) bf16 rows, w (N, K) -> (M, N): row m is gemv_kernels.gemv(x[m], w,
+    rs=rs, sgs=sgs, hb=hb) (hb > 0 path), the weights read once."""
+    m, k = x.shape
+    n = w.shape[0]
+    assert k % 128 == 0 and n % rs == 0 and hb > 0
+    tgs = (n // rs + sgs - 1) // sgs
+    return _gemv_m_kernel()(
+        inputs=[w, x],
+        template=[("T", w.dtype), ("K", k), ("N", n), ("RS", rs), ("SGS", sgs), ("HB", hb),
+                  ("M", m)],
+        grid=(tgs * sgs * 32, 1, 1),
+        threadgroup=(sgs * 32, 1, 1),
+        output_shapes=[(m, n)],
+        output_dtypes=[w.dtype],
+    )[0]
+
+
+# --------------------------------------------------------------------------
+# gemv_kernels.o_proj_tail for M rows (the attention output already gated;
+# the decode configuration rs, sgs, hb = 1, 8, 0): o_proj per row with the
+# decode GEMV's arithmetic (weights loaded once), then per channel the
+# attention short convolution row after row (row m starts from the state
+# after row m - 1) with the residual add. Returns the FP32 residuals (M, N)
+# and the state after every row (M, W - 1, N).
+
+_O_TAIL_M_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sg = simdgroup_index_in_threadgroup;
+    const int row0 = (int(threadgroup_position_in_grid.x) * SGS + int(sg)) * RS;
+    if (row0 >= N) return;
+    float result[RS][M];
+    for (int r = 0; r < RS; ++r)
+        for (int mm = 0; mm < M; ++mm) result[r][mm] = 0.0f;
+    {
+        constexpr int NI = K / 128;
+        const device T* xa = attn + lane * 4;
+        const device T* wp = w + size_t(row0) * K + lane * 4;
+        for (int i = 0; i < NI; ++i) {
+            T inter[RS][4];
+            for (int tm = 0; tm < RS; tm++)
+                for (int tn = 0; tn < 4; tn++) inter[tm][tn] = wp[tm * K + i * 128 + tn];
+            for (int mm = 0; mm < M; ++mm) {
+                float v_coeff[4];
+                for (int tn = 0; tn < 4; tn++)
+                    v_coeff[tn] = static_cast<float>(xa[mm * K + i * 128 + tn]);
+                for (int tm = 0; tm < RS; tm++)
+                    for (int tn = 0; tn < 4; tn++) result[tm][mm] += inter[tm][tn] * v_coeff[tn];
+            }
+        }
+    }
+    for (int r = 0; r < RS; ++r)
+        for (int mm = 0; mm < M; ++mm)
+            for (ushort sn = 16; sn >= 1; sn >>= 1) result[r][mm] += simd_shuffle_down(result[r][mm], sn);
+    if (lane != 0) return;
+    for (int r = 0; r < RS; ++r) {
+        const int c = row0 + r;
+        float win[W - 1];
+        for (int j = 0; j < W - 1; ++j) win[j] = state[j * N + c];
+        for (int mm = 0; mm < M; ++mm) {
+            const T xo = static_cast<T>(result[r][mm]);
+            // short_convolution_residual_step for channel c
+            float value = 0;
+            for (int j = 0; j < W; ++j) {
+                int p = j - W + 1;
+                float xv = p < 0 ? float(win[p + W - 1]) : float(xo);
+                float wj = conv_w[c * W + j];
+                value = value + xv * wj;
+            }
+            const float xt = float(xo);
+            const T conv = T((value + xt) / divisor);
+            for (int j = 0; j < W - 2; ++j) win[j] = win[j + 1];
+            win[W - 2] = xt;
+            for (int j = 0; j < W - 1; ++j) states[(mm * (W - 1) + j) * N + c] = win[j];
+            residual[mm * N + c] = HAS_SKIP ? float(conv) + float(skip[mm * N + c]) : float(conv);
+        }
+    }
+"""
+
+
+@lru_cache(maxsize=None)
+def _o_tail_m_kernel():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_o_proj_tail_m",
+        input_names=["attn", "w", "state", "conv_w", "skip", "divisor"],
+        output_names=["residual", "states"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=_O_TAIL_M_SRC,
+    )
+
+
+def o_proj_tail_m(attn, w, state, conv_weight, skip, width, *, rs=1, sgs=8):
+    """attn (M, K) gated attention rows; state (1, W - 1, N) FP32; skip (M, N)
+    or None. Returns (residual (M, N) FP32, states (M, W - 1, N) FP32)."""
+    import math
+
+    m, k = attn.shape
+    n = w.shape[0]
+    assert k % 128 == 0 and n % rs == 0
+    tgs = (n // rs + sgs - 1) // sgs
+    return tuple(_o_tail_m_kernel()(
+        inputs=[attn, w, state, conv_weight, attn if skip is None else skip,
+                mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", w.dtype), ("K", k), ("N", n), ("RS", rs), ("SGS", sgs), ("M", m),
+                  ("W", width), ("HAS_SKIP", skip is not None)],
+        grid=(tgs * sgs * 32, 1, 1),
+        threadgroup=(sgs * 32, 1, 1),
+        output_shapes=[(m, n), (m, width - 1, n)],
+        output_dtypes=[mx.float32, mx.float32],
+    ))
+
+
+# --------------------------------------------------------------------------
+# MoE for M rows with each routed expert read once (moe_kernels' decode
+# kernels per row: the same top-k, the same per-lane qmv accumulation (the
+# register-word qdot of moe_kernels, equal to MLX's qdot), the same SwiGLU,
+# route combine and MLP short convolution, chained row after row).
+
+_MOE_M_HEADER = r"""
+template <typename T, int K, int BITS, int GS, int FAST, int RPS, int MP, int DQ>
+inline void ink_qmv_rows_multi(const device uint8_t* ws, const device uint8_t* sc,
+    const device T* xbase, const thread int* xoff, int np, uint lane,
+    thread float (*result)[MP], threadgroup const float* lut) {
+  constexpr int PACKS = FAST ? 2 : 1;
+  constexpr int PF = 32 / BITS;
+  constexpr int VPT = PF * PACKS;
+  constexpr int BS = VPT * 32;
+  constexpr int SSTEP = GS / VPT;
+  constexpr int WROW = K * 4 / PF;
+  constexpr int GROW = K / GS;
+  constexpr int NB = FAST ? K / BS : (K - 1) / BS;
+  constexpr int BW = BS * 4 / PF;
+  constexpr int BG = BS / GS;
+  ws += lane * PACKS * 4;
+  sc += lane / SSTEP;
+  const int xl = int(lane) * VPT;
+  float x_thread[VPT];
+  for (int b = 0; b < NB; ++b) {
+    uint w0[RPS], w1[RPS];
+    float s[RPS];
+    for (int r = 0; r < RPS; ++r) {
+      const device uint* wp = (const device uint*)(ws + r * WROW + b * BW);
+      w0[r] = wp[0];
+      w1[r] = PACKS == 2 ? wp[1] : 0u;
+      s[r] = ink_dq_scale<GS, DQ>(sc[r * GROW + b * BG], lut);
+    }
+    for (int p = 0; p < MP; ++p) {
+      if (p >= np) break;
+      ink_load_vector<T, float, VPT>(xbase + xoff[p] + b * BS + xl, x_thread);
+      for (int r = 0; r < RPS; ++r)
+        result[r][p] += ink_qdot_reg<VPT, BITS, DQ>(w0[r], w1[r], x_thread, s[r], VPT, lut);
+    }
+  }
+  if (!FAST) {
+    const int remaining = clamp(int(K - NB * BS - int(lane) * VPT), 0, VPT);
+    if (remaining > 0) {
+      uint w0[RPS], w1[RPS];
+      float s[RPS];
+      for (int r = 0; r < RPS; ++r) {
+        const device uint* wp = (const device uint*)(ws + r * WROW + NB * BW);
+        w0[r] = wp[0];
+        w1[r] = 0u;
+        s[r] = ink_dq_scale<GS, DQ>(sc[r * GROW + NB * BG], lut);
+      }
+      for (int p = 0; p < MP; ++p) {
+        if (p >= np) break;
+        ink_load_vector_safe<T, float, VPT>(xbase + xoff[p] + NB * BS + xl, x_thread, remaining);
+        for (int r = 0; r < RPS; ++r)
+          result[r][p] += ink_qdot_reg<VPT, BITS, DQ>(w0[r], w1[r], x_thread, s[r], remaining, lut);
+      }
+    }
+  }
+}
+"""
+
+_MOE_ROUTE_SRC = r"""
+    const int m = threadgroup_position_in_grid.x;
+    const uint lid = thread_position_in_threadgroup.x;
+    threadgroup int sel[TOPK];
+    const device float* ng = neg + m * NE;
+    for (int t = int(lid); t < NE; t += TGS) {
+        const float a = ng[t];
+        int rank = 0;
+        for (int j = 0; j < NE; ++j) {
+            const float b = ng[j];
+            rank += (ink_less(b, a) || (j < t && !ink_less(a, b))) ? 1 : 0;
+        }
+        if (rank < TOPK) sel[rank] = t;
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    if (lid == 0) {
+        float w[TOPK];
+        for (int i = 0; i < TOPK; ++i) w[i] = scores[m * NE + sel[i]];
+        float total = 0.0f;
+        {
+            #pragma clang fp contract(off)
+            SUM_EXPR
+        }
+        const float denom = total + 1e-20f;
+        for (int i = 0; i < TOPK; ++i) {
+            idx[m * TOPK + i] = uint(sel[i]);
+            wts[m * TOPK + i] = (w[i] / denom) * ROUTE_SCALE;
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    // The rows using each expert (row-major (m, route) order), one thread per expert.
+    if (m == 0) {
+        // (computed by the union kernel)
+    }
+"""
+
+_MOE_UNION_SRC = r"""
+    const int e = int(thread_position_in_grid.x);
+    if (e >= NE) return;
+    int cnt = 0;
+    for (int m = 0; m < M; ++m)
+        for (int i = 0; i < TOPK; ++i)
+            if (int(idx[m * TOPK + i]) == e) {
+                ulist[e * M + cnt] = m * TOPK + i;
+                cnt++;
+            }
+    ucount[e] = cnt;
+"""
+
+_MOE_GU_M_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sgi = simdgroup_index_in_threadgroup;
+    const int tg = threadgroup_position_in_grid.x;
+    constexpr int ROWS_TG = SG * RPS;
+    constexpr int CHUNKS = N / ROWS_TG;
+    const int e = tg / CHUNKS;
+    const int cnt = ucount[e];
+    if (cnt == 0) return;
+    threadgroup float lut[16 + 256];
+    const int row0 = (tg % CHUNKS) * ROWS_TG + int(sgi) * RPS;
+    int xoff[M];
+    for (int p = 0; p < M; ++p) xoff[p] = p < cnt ? (ulist[e * M + p] / TOPK) * K : 0;
+    constexpr int WROW = K * 4 / (32 / BITS);
+    constexpr int GROW = K / GS;
+    float rg[RPS][M], ru[RPS][M];
+    for (int r = 0; r < RPS; ++r)
+        for (int p = 0; p < M; ++p) { rg[r][p] = 0.0f; ru[r][p] = 0.0f; }
+    const size_t wo = (size_t(e) * N + row0) * WROW;
+    const size_t so = (size_t(e) * N + row0) * GROW;
+    ink_qmv_rows_multi<T, K, BITS, GS, FAST, RPS, M, 0>(
+        (const device uint8_t*)wg + wo, sg + so, x, xoff, cnt, lane, rg, lut);
+    ink_qmv_rows_multi<T, K, BITS, GS, FAST, RPS, M, 0>(
+        (const device uint8_t*)wu + wo, su + so, x, xoff, cnt, lane, ru, lut);
+    float invg = 1.0f, invu = 1.0f;
+    if (HAS_GSCALE) {
+        invg = fg[e] / (448.0f * 6.0f);
+        invu = fu[e] / (448.0f * 6.0f);
+    }
+    for (int p = 0; p < M; ++p) {
+        if (p >= cnt) break;
+        for (int r = 0; r < RPS; ++r) {
+            rg[r][p] = simd_sum(rg[r][p]);
+            ru[r][p] = simd_sum(ru[r][p]);
+        }
+    }
+    if (lane == 0) {
+        for (int p = 0; p < M; ++p) {
+            if (p >= cnt) break;
+            const int slot = ulist[e * M + p];
+            for (int r = 0; r < RPS; ++r) {
+                const T gb = HAS_GSCALE ? static_cast<T>(rg[r][p] * invg) : static_cast<T>(rg[r][p]);
+                const T ub = HAS_GSCALE ? static_cast<T>(ru[r][p] * invu) : static_cast<T>(ru[r][p]);
+                // _softcapped_swiglu(up, gate, GCAP, UCAP)
+                const float g = float(gb), u = float(ub);
+                const float v = metal::precise::tanh(g / GCAP) * GCAP * ink_sigmoid(g)
+                    * metal::precise::tanh(u / UCAP) * UCAP;
+                act[slot * N + row0 + r] = static_cast<T>(v);
+            }
+        }
+    }
+"""
+
+_MOE_DT_M_SRC = r"""
+    const uint lane = thread_index_in_simdgroup;
+    const uint sgi = simdgroup_index_in_threadgroup;
+    const uint lid = thread_position_in_threadgroup.x;
+    const int tg = threadgroup_position_in_grid.x;
+    constexpr int CH = RPS;
+    threadgroup float eo[M * TOPK][CH];
+    threadgroup float lut[16 + 256];
+    const int c0 = tg * CH;
+    constexpr int WROW = K * 4 / (32 / BITS);
+    constexpr int GROW = K / GS;
+    int used = 0;
+    for (int e = 0; e < NE; ++e) {
+        const int cnt = ucount[e];
+        if (cnt == 0) continue;
+        if ((used++ % SG) != int(sgi)) continue;
+        int xoff[M];
+        for (int p = 0; p < M; ++p) xoff[p] = p < cnt ? ulist[e * M + p] * K : 0;
+        float res[RPS][M];
+        for (int r = 0; r < RPS; ++r)
+            for (int p = 0; p < M; ++p) res[r][p] = 0.0f;
+        ink_qmv_rows_multi<T, K, BITS, GS, FAST, RPS, M, 0>(
+            (const device uint8_t*)wd + (size_t(e) * N + c0) * WROW,
+            sd + (size_t(e) * N + c0) * GROW, act, xoff, cnt, lane, res, lut);
+        float inv = 1.0f;
+        if (HAS_GSCALE) inv = fd[e] / (448.0f * 6.0f);
+        for (int p = 0; p < M; ++p) {
+            if (p >= cnt) break;
+            for (int r = 0; r < RPS; ++r) res[r][p] = simd_sum(res[r][p]);
+        }
+        if (lane == 0) {
+            for (int p = 0; p < M; ++p) {
+                if (p >= cnt) break;
+                const int slot = ulist[e * M + p];
+                for (int r = 0; r < RPS; ++r)
+                    eo[slot][r] = float(HAS_GSCALE ? static_cast<T>(res[r][p] * inv)
+                                                   : static_cast<T>(res[r][p]));
+            }
+        }
+    }
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+    for (int t = int(lid); t < CH; t += SG * 32) {
+        const int c = c0 + t;
+        float win[W - 1];
+        for (int j = 0; j < W - 1; ++j) win[j] = state[j * N + c];
+        for (int m = 0; m < M; ++m) {
+            // kernels.mlp_tail_step: the route combine (products rounded, summed
+            // in route order), the short convolution with its next state, and
+            // the residual add.
+            float total = 0.0f;
+            {
+                #pragma clang fp contract(off)
+                for (int r = 0; r < TOPK; ++r) {
+                    const float p = eo[m * TOPK + r][t] * wts[m * TOPK + r];
+                    total = p + total;
+                }
+            }
+            const T hidden = static_cast<T>(total);
+            float value = 0;
+            for (int j = 0; j < W; ++j) {
+                int p = j - W + 1;
+                float xv = p < 0 ? float(win[p + W - 1]) : float(hidden);
+                float w = conv_w[c * W + j];
+                value = value + xv * w;
+            }
+            const float xt = float(hidden);
+            const T conv = T((value + xt) / divisor);
+            for (int j = 0; j < W - 2; ++j) win[j] = win[j + 1];
+            win[W - 2] = xt;
+            for (int j = 0; j < W - 1; ++j) states[(m * (W - 1) + j) * N + c] = win[j];
+            out[m * N + c] = static_cast<T>(residual[m * N + c] + float(conv));
+        }
+    }
+"""
+
+_MOE_M = {}
+
+
+def _moe_kernel(name, src, inputs, outputs, route_scale=None, gate_cap=None, up_cap=None):
+    from . import moe_kernels as mk
+
+    key = (name, route_scale, gate_cap, up_cap)
+    k = _MOE_M.get(key)
+    if k is None:
+        s = src
+        if route_scale is not None:
+            s = (s.replace("SUM_EXPR", mk.SUM_ORDERS["seq"])
+                 .replace("ROUTE_SCALE", mk._flit(route_scale)))
+        if gate_cap is not None:
+            s = s.replace("GCAP", mk._flit(gate_cap)).replace("UCAP", mk._flit(up_cap))
+        k = mx.fast.metal_kernel(
+            name=f"inkling2_verify_{name}_{len(_MOE_M)}",
+            input_names=inputs,
+            output_names=outputs,
+            header=mk._HEADER + _MOE_M_HEADER,
+            ensure_row_contiguous=True,
+            compile_options={"math_mode": "safe"},
+            source=s,
+        )
+        _MOE_M[key] = k
+    return k
+
+
+def moe_rows(x, neg, scores, moe, states, conv_weight, residual, width):
+    """M decode rows of SparseMoE.fused_decode + the MLP tail.
+    x (M, K) bf16 MoE inputs; neg, scores (M, E) the router outputs per row;
+    states (1, W - 1, C) FP32 the MLP conv state before row 0; residual (M, C)
+    FP32. Returns (out (M, C) bf16, states after each row (M, W - 1, C))."""
+    import math
+    from . import moe_kernels as mk
+
+    sw = moe.switch_mlp
+    m, k = x.shape
+    top_k = moe.top_k
+    ne = neg.shape[-1]
+    wg, sgs, fg, bits, gs = mk._proj_params(sw.gate_proj)
+    wu, sus, fu, _, _ = mk._proj_params(sw.up_proj)
+    wd, sds, fd, bits_d, gs_d = mk._proj_params(sw.down_proj)
+    n = wg.shape[1]
+    c = wd.shape[1]
+    has_gs = fg is not None
+    idx, wts = _moe_kernel("moe_route", _MOE_ROUTE_SRC, ["neg", "scores"], ["idx", "wts"],
+                           route_scale=moe.route_scale)(
+        inputs=[neg, scores],
+        template=[("NE", ne), ("TOPK", top_k), ("TGS", 128)],
+        grid=(m * 128, 1, 1), threadgroup=(128, 1, 1),
+        output_shapes=[(m, top_k), (m, top_k)], output_dtypes=[mx.uint32, mx.float32],
+    )
+    ulist, ucount = _moe_kernel("moe_union", _MOE_UNION_SRC, ["idx"], ["ulist", "ucount"])(
+        inputs=[idx],
+        template=[("NE", ne), ("TOPK", top_k), ("M", m)],
+        grid=(ne, 1, 1), threadgroup=(ne, 1, 1),
+        output_shapes=[(ne, m), (ne,)], output_dtypes=[mx.int32, mx.int32],
+    )
+    rps, sg = 4, 8
+    rows_tg = sg * rps
+    assert n % rows_tg == 0 and c % rps == 0
+    dummy = wts
+    act = _moe_kernel("moe_gate_up_m", _MOE_GU_M_SRC,
+                      ["x", "ulist", "ucount", "wg", "sg", "fg", "wu", "su", "fu"], ["act"],
+                      gate_cap=sw.activation.gate_cap, up_cap=sw.activation.up_cap)(
+        inputs=[x, ulist, ucount, wg, sgs, fg if has_gs else dummy, wu, sus,
+                fu if has_gs else dummy],
+        template=[("T", x.dtype), ("K", k), ("N", n), ("BITS", bits), ("GS", gs),
+                  ("HAS_GSCALE", has_gs), ("FAST", mk._fast(k, bits)), ("RPS", rps),
+                  ("SG", sg), ("NE", ne), ("TOPK", top_k), ("M", m)],
+        grid=(ne * (n // rows_tg) * sg * 32, 1, 1), threadgroup=(sg * 32, 1, 1),
+        output_shapes=[(m * top_k, n)], output_dtypes=[x.dtype],
+    )[0]
+    has_gs_d = fd is not None
+    out, st = _moe_kernel("moe_down_tail_m", _MOE_DT_M_SRC,
+                          ["act", "ulist", "ucount", "wts", "wd", "sd", "fd", "state",
+                           "conv_w", "residual", "divisor"], ["out", "states"])(
+        inputs=[act, ulist, ucount, wts, wd, sds, fd if has_gs_d else dummy, states,
+                conv_weight, residual, mx.array(math.sqrt(width + 1), mx.float32)],
+        template=[("T", x.dtype), ("K", n), ("N", c), ("BITS", bits_d), ("GS", gs_d),
+                  ("HAS_GSCALE", has_gs_d), ("FAST", mk._fast(n, bits_d)), ("RPS", rps),
+                  ("SG", sg), ("NE", ne), ("TOPK", top_k), ("M", m), ("W", width)],
+        grid=((c // rps) * sg * 32, 1, 1), threadgroup=(sg * 32, 1, 1),
+        output_shapes=[(m, c), (m, width - 1, c)], output_dtypes=[x.dtype, mx.float32],
+    )
+    return out, st
+
+
+# --------------------------------------------------------------------------
+# global_rows_shared with lane-parallel scalars: a simdgroup owns NP = RPS * G
+# (row, head) pairs. Per key the NP per-lane partial dot products (the decode
+# kernel's 4 FMAs per lane) are reduced with a reduce-scatter whose butterfly
+# order is simd_sum's (XOR_DESC: distances 16, 8, 4, 2, 1; else 1 .. 16), so
+# each pair's score is bitwise the decode kernel's simd_sum, held by its owner
+# lane. The owner lane runs the decode kernel's online-softmax update for its
+# pair; f and p are broadcast and every lane updates acc with the decode
+# kernel's expression. Only the work distribution over lanes changes.
+
+_GPS2 = r"""
+        constexpr int G = HQ / HKV;
+        constexpr int E = D / 32;
+        constexpr int NP = RPS * G;
+        const uint lane = thread_index_in_simdgroup;
+        const int sidx = int(simdgroup_index_in_threadgroup);
+        const int sg = sidx % SG;
+        const int rg = sidx / SG;
+        const int block = threadgroup_position_in_grid.x;
+        const int g = threadgroup_position_in_grid.y;
+        const int base = new_base[0];
+        const int start = block * BS;
+        const int Smax = base + R;
+        if (start >= Smax) return;
+        const int end_max = min(start + BS, Smax);
+        const float sc = scale;
+
+        // Which pair the reduce-scatter leaves in this lane.
+        int my = 0;
+        {
+            int lo = 0, len = P2;
+            for (int st = 0; st < 5; ++st) {
+                const ushort d = XOR_DESC ? ushort(16 >> st) : ushort(1 << st);
+                if (len > 1) {
+                    len >>= 1;
+                    if (lane & d) lo += len;
+                }
+            }
+            my = lo;
+        }
+        const int my_r = rg * RPS + my / G;
+        const int my_h = my % G;
+        const bool owner = my < NP && my_r < R;
+        float qv[NP][E];
+        float acc[NP][E];
+        for (int i = 0; i < NP; ++i) {
+            const int r = min(rg * RPS + i / G, R - 1);
+            const int h = i % G;
+            for (int e = 0; e < E; ++e) {
+                qv[i][e] = float(q[(r * HQ + g * G + h) * D + lane * E + e]) * sc;
+                acc[i][e] = 0.0f;
+            }
+        }
+        float m_own = -INFINITY, l_own = 0.0f;
+        const device T* k_head = k + g * k_strides[1];
+        const device T* v_head = v + g * v_strides[1];
+        int j = start + sg;
+        vec<T, E> k_next = vec<T, E>(0), v_next = vec<T, E>(0);
+        if (j < end_max) {
+            k_next = *(const device vec<T, E>*)(k_head + size_t(j) * k_strides[2] + lane * E);
+            v_next = *(const device vec<T, E>*)(v_head + size_t(j) * v_strides[2] + lane * E);
+        }
+        for (; j < end_max; j += SG) {
+            float kv[E], vv[E];
+            for (int e = 0; e < E; ++e) {
+                kv[e] = float(k_next[e]);
+                vv[e] = float(v_next[e]);
+            }
+            if (j >= base) {
+                for (int e = 0; e < E; ++e) {
+                    kv[e] = float(k_new[((j - base) * HKV + g) * D + lane * E + e]);
+                    vv[e] = float(v_new[((j - base) * HKV + g) * D + lane * E + e]);
+                }
+            }
+            if (j + SG < end_max) {
+                const size_t jn = size_t(j + SG);
+                k_next = *(const device vec<T, E>*)(k_head + jn * k_strides[2] + lane * E);
+                v_next = *(const device vec<T, E>*)(v_head + jn * v_strides[2] + lane * E);
+            }
+            float part[P2];
+            for (int i = 0; i < P2; ++i) {
+                float s = 0.0f;
+                if (i < NP)
+                    for (int e = 0; e < E; ++e) s += qv[i][e] * kv[e];
+                part[i] = s;
+            }
+            // reduce-scatter (simd_sum's butterfly per pair), stage lengths
+            // known at compile time so part[] stays in registers.
+#define RS_STAGE(ST) {                                                          \
+                constexpr ushort d = XOR_DESC ? ushort(16 >> (ST)) : ushort(1 << (ST)); \
+                constexpr int LEN = (P2 >> (ST)) > 0 ? (P2 >> (ST)) : 1;        \
+                constexpr int HL = LEN > 1 ? LEN / 2 : 1;                        \
+                const bool up = (lane & d) != 0;                                 \
+                if (LEN > 1) {                                                   \
+                    for (int t = 0; t < HL; ++t) {                               \
+                        const float keep = up ? part[t + HL] : part[t];          \
+                        const float send = up ? part[t] : part[t + HL];          \
+                        part[t] = keep + simd_shuffle_xor(send, d);              \
+                    }                                                            \
+                } else {                                                         \
+                    part[0] = part[0] + simd_shuffle_xor(part[0], d);            \
+                }                                                                \
+            }
+            RS_STAGE(0) RS_STAGE(1) RS_STAGE(2) RS_STAGE(3) RS_STAGE(4)
+#undef RS_STAGE
+            float f = 1.0f, p = 0.0f;
+            bool live = false;
+            if (owner) {
+                const int S = base + my_r + 1;
+                if (j < S) {
+                    live = true;
+                    float s = part[0];
+                    const int dist = S - 1 - j;
+                    if (dist < REL) s += float(rel[(my_r * HQ + g * G + my_h) * REL + dist]);
+                    const float mn = max(m_own, s);
+                    f = metal::exp(m_own - mn);
+                    p = metal::exp(s - mn);
+                    l_own = l_own * f + p;
+                    m_own = mn;
+                }
+            }
+            for (int i = 0; i < NP; ++i) {
+                const int r = rg * RPS + i / G;
+                if (r >= R || j >= base + r + 1) continue;
+                const ushort src = ushort(LANE_OF(i));
+                const float fi = simd_shuffle(f, src);
+                const float pi = simd_shuffle(p, src);
+                for (int e = 0; e < E; ++e) acc[i][e] = acc[i][e] * fi + pi * vv[e];
+            }
+            (void)live;
+        }
+
+        threadgroup float tm[SG][G];
+        threadgroup float tl[SG][G];
+        threadgroup float ta[SG][G][D];
+        for (int rr = 0; rr < R; ++rr) {
+            const int owner_rg = rr / RPS;
+            const int ii = rr % RPS;
+            const bool live_blk = start < base + rr + 1;
+            if (rg == owner_rg) {
+                if (owner && my / G == ii) {
+                    tm[sg][my_h] = m_own;
+                    tl[sg][my_h] = l_own;
+                }
+                for (int h = 0; h < G; ++h)
+                    for (int e = 0; e < E; ++e) ta[sg][h][lane * E + e] = acc[ii * G + h][e];
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+            if (live_blk) {
+                for (uint t = thread_position_in_threadgroup.x; t < uint(G * D); t += SG * RG * 32) {
+                    const int h = t / D, d = t % D;
+                    float M = -INFINITY;
+                    for (int s = 0; s < SG; ++s) M = max(M, tm[s][h]);
+                    float L = 0.0f, A = 0.0f;
+                    if (M > -INFINITY) {
+                        for (int s = 0; s < SG; ++s) {
+                            const float w = metal::exp(tm[s][h] - M);
+                            L += tl[s][h] * w;
+                            A += ta[s][h][d] * w;
+                        }
+                    }
+                    const int row = (rr * nbk[0] + block) * HQ + g * G + h;
+                    part_acc[size_t(row) * D + d] = A;
+                    if (d == 0) {
+                        part_max[row] = M;
+                        part_sum[row] = L;
+                    }
+                }
+            }
+            threadgroup_barrier(mem_flags::mem_threadgroup);
+        }
+"""
+
+
+def _lane_of_expr(p2, desc):
+    """C expression: the lane whose reduce-scatter result is pair i."""
+    # Emulate the halving: lane bit for distance d selects the upper half.
+    lanes = {}
+    for lane in range(32):
+        lo, ln = 0, p2
+        for st in range(5):
+            d = (16 >> st) if desc else (1 << st)
+            if ln > 1:
+                ln >>= 1
+                if lane & d:
+                    lo += ln
+        lanes.setdefault(lo, lane)
+    table = ",".join(str(lanes[i]) for i in range(p2))
+    return table
+
+
+@lru_cache(maxsize=None)
+def _global_partials_shared2(p2, desc):
+    table = _lane_of_expr(p2, desc)
+    src = _GPS2.replace(
+        "LANE_OF(i)", f"lane_of_tab[i]"
+    ).replace(
+        "        constexpr int NP = RPS * G;",
+        "        constexpr int NP = RPS * G;\n"
+        f"        constexpr ushort lane_of_tab[{p2}] = {{{table}}};",
+    )
+    return mx.fast.metal_kernel(
+        name=f"inkling2_verify_global_partials_shared2_{p2}_{int(desc)}",
+        input_names=["q", "k", "v", "rel", "scale", "k_new", "v_new", "new_base", "nbk"],
+        output_names=["part_max", "part_sum", "part_acc"],
+        ensure_row_contiguous=False,
+        source=src,
+    )
+
+
+def global_rows_shared2(q, k, v, k_new, v_new, base, rel, sinks, gate, *, scale, rps=2,
+                        desc=True):
+    """global_rows_shared with lane-parallel per-pair scalars (see _GPS2)."""
+    R, hq, d = q.shape
+    hkv, cap = k.shape[1], k.shape[2]
+    nb = (cap + _k._DECODE_BLOCK - 1) // _k._DECODE_BLOCK
+    assert d % 32 == 0 and nb <= 3072 and _k._COMBINE2 and hq // hkv == 3
+    rps = max(1, min(int(rps), R))
+    rg = (R + rps - 1) // rps
+    np_ = rps * (hq // hkv)
+    p2 = 1
+    while p2 < np_:
+        p2 *= 2
+    assert p2 <= 32
+    sg = _k._DECODE_SIMDGROUPS
+    assert sg * rg * 32 <= 1024
+    base = base.reshape(1).astype(mx.int32)
+    lengths = base + 1 + mx.arange(R, dtype=mx.int32)
+    part_max, part_sum, part_acc = _global_partials_shared2(p2, bool(desc))(
+        inputs=[mx.contiguous(q), k, v, mx.contiguous(rel), mx.array(scale, dtype=mx.float32),
+                mx.contiguous(k_new), mx.contiguous(v_new), base, mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("REL", rel.shape[-1]),
+                  ("BS", _k._DECODE_BLOCK), ("SG", sg), ("R", R), ("RPS", rps), ("RG", rg),
+                  ("P2", p2), ("XOR_DESC", bool(desc))],
+        grid=(nb * 32 * sg * rg, hkv, 1),
+        threadgroup=(32 * sg * rg, 1, 1),
+        output_shapes=[(R * nb * hq,), (R * nb * hq,), (R * nb * hq, d)],
+        output_dtypes=[mx.float32, mx.float32, mx.float32],
+    )
+    csizes = mx.stack([lengths, (lengths + (_k._DECODE_BLOCK - 1)) // _k._DECODE_BLOCK], axis=1)
+    return _global_combine()(
+        inputs=[part_max, part_sum, part_acc, sinks.astype(mx.float32), csizes,
+                mx.contiguous(gate), mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("DT", 32),
+                  ("NBMAX", _NBMAX), ("HAS_GATE", True)],
+        grid=(hq * d, 1, R),
+        threadgroup=(32, 1, 1),
+        output_shapes=[(R, hq, d)],
+        output_dtypes=[q.dtype],
+    )[0]
+
+
+# global_rows with the rows adjacent in the grid (threadgroup x = block * R +
+# row): the R threadgroups of one key block are dispatched together, so the
+# block's K/V is fetched from DRAM once and re-read from cache. Same kernel
+# body (only the block/row indices are taken from x).
+_GPX = _sub(_GP, "const int vrow = threadgroup_position_in_grid.z;",
+            "const int vrow = int(threadgroup_position_in_grid.x) % RR;")
+_GPX = _sub(_GPX, "const int block = threadgroup_position_in_grid.x;",
+            "const int block = int(threadgroup_position_in_grid.x) / RR;")
+
+
+@lru_cache(maxsize=None)
+def _global_partials_x():
+    return mx.fast.metal_kernel(
+        name="inkling2_verify_global_partials_x",
+        input_names=["q", "k", "v", "rel", "key_start", "sizes", "scale", "k_new", "v_new",
+                     "new_base", "nbk"],
+        output_names=["part_max", "part_sum", "part_acc"],
+        ensure_row_contiguous=False,
+        source=_GPX,
+    )
+
+
+def global_rows_x(q, k, v, k_new, v_new, base, rel, sinks, gate, *, scale):
+    """global_rows with the rows of a key block adjacent in the dispatch."""
+    R, hq, d = q.shape
+    hkv, cap = k.shape[1], k.shape[2]
+    nb = (cap + _k._DECODE_BLOCK - 1) // _k._DECODE_BLOCK
+    assert d % 32 == 0 and nb <= 3072 and _k._COMBINE2
+    base = base.reshape(1).astype(mx.int32)
+    lengths = base + 1 + mx.arange(R, dtype=mx.int32)
+    zero = mx.zeros((1,), mx.int32)
+    part_max, part_sum, part_acc = _global_partials_x()(
+        inputs=[mx.contiguous(q), k, v, mx.contiguous(rel), zero, lengths,
+                mx.array(scale, dtype=mx.float32), mx.contiguous(k_new), mx.contiguous(v_new),
+                base, mx.array([nb], dtype=mx.int32)],
+        template=[("T", q.dtype), ("D", d), ("HQ", hq), ("HKV", hkv), ("REL", rel.shape[-1]),
+                  ("BS", _k._DECODE_BLOCK), ("SG", _k._DECODE_SIMDGROUPS), ("NEWROW", True),
