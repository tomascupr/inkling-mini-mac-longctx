+class _PromptLookup:
+    """Prompt-lookup proposals (MLX_VLM_INKLING2_NGRAM=n): the continuation of
+    the most recent earlier occurrence of the last n..NMAX emitted tokens in
+    the prompt or the output. Used for a round when an occurrence of at least
+    n tokens exists; the DSpark draft fills the rest of the block. Proposals
+    only change speed (the verifier decides every token)."""
+
+    NMAX = 12
+
+    def __init__(self, prompt_ids, nmin):
+        import numpy as np
+
+        self.np = np
+        self.prompt = np.asarray(prompt_ids, dtype=np.int32).reshape(-1)
+        self.gen = []
+        self.nmin = int(nmin)
+        self.used = 0
+
+    def _matches(self, seq, tail, limit):
+        """(length, position after the match) of the longest (then latest)
+        occurrence in seq[:limit] of a suffix of tail of length >= nmin."""
+        np = self.np
+        n0 = self.nmin
+        if limit <= n0 or len(tail) < n0:
+            return None
+        pat = np.asarray(tail[-n0:], dtype=np.int32)
+        cand = np.flatnonzero(seq[: limit - n0 + 1] == pat[0])
+        for t in range(1, n0):
+            if cand.size == 0:
+                return None
+            cand = cand[seq[cand + t] == pat[t]]
+        if cand.size == 0:
+            return None
+        length = np.full(cand.shape, n0)
+        alive = np.ones(cand.shape, dtype=bool)
+        for t in range(len(tail) - n0):
+            idx = cand - 1 - t
+            ok = alive & (idx >= 0)
+            ok[ok] = seq[idx[ok]] == tail[-n0 - 1 - t]
+            alive = ok
+            length += alive
+        best = int(np.max(length))
+        i = int(cand[np.flatnonzero(length == best)[-1]])
+        return best, i + n0
+
+    def propose(self, count):
+        np = self.np
+        tail = (self.prompt[-self.NMAX :].tolist() + self.gen)[-self.NMAX :]
+        gen = np.asarray(self.gen, dtype=np.int32)
+        # the output (not its own tail) first, then the prompt
+        best = None
+        g = self._matches(gen, tail, len(gen) - 1) if len(gen) > self.nmin else None
+        if g is not None:
+            best = (g[0], gen[g[1] : g[1] + count].tolist())
+        p = self._matches(self.prompt, tail, len(self.prompt) - 1)
+        if p is not None and (best is None or p[0] > best[0]):
+            out = self.prompt[p[1] : p[1] + count].tolist()
+            if len(out) < count:
+                out += self.gen[: count - len(out)]
+            best = (p[0], out)
+        return best[1][:count] if best is not None and best[1] else None
+
+
+class _AdaptiveBlock:
+    """Block size per round from candidates (MLX_VLM_INKLING2_ADAPT_K="4,6,8"):
+    maximize (1 + sum_j P(accepted run >= j)) / round time over the
+    candidates, with the conditional acceptance of each proposal position
+    counted over the rounds that reached it and each candidate's round time
+    measured (EMA; the first round of a candidate, which may compile, is not
+    timed; untried candidates use the fastest measured time). Every block size
+    is exact under greedy verification: this only changes speed."""
+
+    def __init__(self, cands, prior=0.75, weight=2.0):
+        self.cands = sorted(set(int(c) for c in cands if int(c) >= 2))
+        self.reach = [0.0] * (max(self.cands) + 1)
+        self.acc = [0.0] * (max(self.cands) + 1)
+        self.prior, self.weight = prior, weight
+        self.time = {}
+        self.seen = set()
+        self.history = []
+
+    def choose(self, limit):
+        cands = [c for c in self.cands if c <= limit] or [min(self.cands[0], limit)]
+        if not self.time:
+            return max(cands)
+        fallback = min(self.time.values())
+        best, best_rate = cands[0], -1.0
+        for k in cands:
+            p, e = 1.0, 1.0
+            for j in range(1, k):
+                p *= (self.acc[j] + self.prior * self.weight) / (self.reach[j] + self.weight)
+                e += p
+            rate = e / self.time.get(k, fallback)
+            if rate > best_rate:
+                best, best_rate = k, rate
+        return best
+
+    def record(self, k, accepted, seconds):
+        for j in range(1, k):
+            self.reach[j] += 1
+            if accepted >= j:
+                self.acc[j] += 1
+            else:
+                break
+        if k in self.seen and seconds is not None:
+            t = self.time.get(k)
+            self.time[k] = seconds if t is None else 0.7 * t + 0.3 * seconds
+        self.seen.add(k)
+        self.history.append(k)
+
