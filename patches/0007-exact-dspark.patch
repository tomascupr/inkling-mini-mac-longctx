+class VerifyKVCache(KVCache):
+    """A fixed-capacity global cache updated by a k-token verifier graph."""
+
+    def __init__(self, keys, values, offset):
+        self.keys, self.values = keys, values
+        self.offset = offset
+        self.length = None
+        self.new_keys = self.new_values = None
+
+    def update_and_fetch(self, keys, values):
+        self.new_keys, self.new_values = keys, values
+        start = self.offset.reshape(1)
+        self.keys = mx.slice_update(self.keys, keys, start, axes=(2,))
+        self.values = mx.slice_update(self.values, values, start, axes=(2,))
+        self.length = self.offset + keys.shape[2]
+        return self.keys, self.values
+
+
+class VerifyRotatingKVCache(RotatingKVCache):
+    """Read a serving ring without mutating it and append verifier rows aside.
+
+    Attention consumes the chronological ``window-1+k`` view used by the native
+    RotatingKVCache block path. Only ``new_keys/new_values`` leave the compiled
+    graph; the transaction commits their accepted prefix to the serving ring.
+    """
+
+    def __init__(self, keys, values, idx, max_size):
+        self.keys, self.values = keys, values
+        self._idx = idx
+        self.max_size = max_size
+        self.keep = 0
+        self.offset = max_size
+        self.new_keys = self.new_values = None
+
+    def update_and_fetch(self, keys, values):
+        self.new_keys, self.new_values = keys, values
+        idx = mx.where(self._idx == self.max_size, 0, self._idx)
+        order = (mx.arange(self.max_size, dtype=mx.int32) + idx) % self.max_size
+        old_keys = mx.take(self.keys, order, axis=2)
+        old_values = mx.take(self.values, order, axis=2)
+        self.keys = mx.concatenate([old_keys[..., 1:, :], keys], axis=2)
+        self.values = mx.concatenate([old_values[..., 1:, :], values], axis=2)
+        return self.keys, self.values
+
+    def _temporal_order(self, value):
+        return value
+
+
