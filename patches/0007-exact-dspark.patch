+# The global draft layer's context as a fixed ring of the last W target
+# positions (MLX_VLM_INKLING2_DRAFT_CTX_WINDOW; 0 = the whole context in a
+# growing KVCache). The draft attention has no mask, so the key order does not
+# matter: the block's keys go to the slots after the ring and the attention
+# reads the buffer in place (no per-round copy of the context). Only the
+# proposals change (they never enter the target), so output stays exact.
+_CTX_WINDOW = int(os.environ.get("MLX_VLM_INKLING2_DRAFT_CTX_WINDOW", "0"))
+
+
+class DraftWindowCache(KVCache):
+    def __init__(self, window, block):
+        super().__init__()
+        self.window, self.block = int(window), int(block)
+
+    def _alloc(self, like_k, like_v):
+        if self.keys is None:
+            B, H, _, Dk = like_k.shape
+            n = self.window + self.block
+            self.keys = mx.zeros((B, H, n, Dk), like_k.dtype)
+            self.values = mx.zeros((B, H, n, like_v.shape[3]), like_v.dtype)
+
+    def _write(self, start, keys, values):
+        start = mx.array([start], dtype=mx.int32)
+        self.keys = mx.slice_update(self.keys, keys, start, axes=(2,))
+        self.values = mx.slice_update(self.values, values, start, axes=(2,))
+
+    def update_and_fetch(self, keys, values):
+        self._alloc(keys, values)
+        n = keys.shape[2]
+        if n > self.window:
+            self.offset += n - self.window
+            keys, values = keys[..., -self.window :, :], values[..., -self.window :, :]
+            n = self.window
+        pos = self.offset % self.window
+        first = min(n, self.window - pos)
+        self._write(pos, keys[..., :first, :], values[..., :first, :])
+        if first < n:
+            self._write(0, keys[..., first:, :], values[..., first:, :])
+        self.offset += n
+        return None, None
+
+    def attend_kv(self, block_k, block_v):
+        """(keys, values) of the context ring plus the block's rows."""
+        b = block_k.shape[2]
+        if self.offset < self.window:
+            start, end = self.offset, self.offset + b
+        else:
+            start, end = self.window, self.window + b
+        self._write(start, block_k, block_v)
+        return self.keys[..., :end, :], self.values[..., :end, :]
