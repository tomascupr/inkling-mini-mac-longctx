diff -ruN a/mlx_vlm/models/inkling2/exact_verify.py b/mlx_vlm/models/inkling2/exact_verify.py
--- a/mlx_vlm/models/inkling2/exact_verify.py
+++ b/mlx_vlm/models/inkling2/exact_verify.py
@@ -0,0 +1,845 @@
+"""Exact k-row speculative verifier for Inkling 2 / 2-loop (track B3).
+
+Row r of a verify block (the token at position offset + r) is computed with
+exactly the operations of the compiled single-token decode step
+(fast_decode.py) for that position: the same kernels on the same inputs, so
+its logits, logprobs, K/V rows and convolution states are bitwise those of
+non-speculative decoding. The rows are evaluated layer visit by layer visit
+(phases inside a visit: attention inputs and K/V rows for all rows, then the
+attention of every row, then the attention tails and MLPs), which lets
+weight reads be shared across rows later without changing any row's
+arithmetic. Rows interact only through the caches:
+- global K/V: the block's rows are kept in a side buffer; row r's attention
+  reads the cache below `offset` plus rows 0..r (verify_kernels.global_rows);
+  the accepted rows are written into the cache at commit;
+- sliding rings: likewise with the ring slots of rows 0..r
+  (verify_kernels.sliding_rows); accepted rows are written at commit;
+- short convolutions: the decode kernels are called row after row on one
+  StepConvCache, so row r starts from the state after row r - 1; the state
+  after every row is returned for the commit.
+"""
+
+import os
+
+import mlx.core as mx
+
+from ..cache import ArraysCache, CacheList, KVCache, RotatingKVCache
+from .step_cache import StepConvCache
+
+_ENABLED = os.environ.get("MLX_VLM_INKLING2_EXACT_VERIFY", "0") == "1"
+# Global attention: rows per simdgroup of the shared-read kernel
+# (verify_kernels.global_rows_shared); 0 = one threadgroup per row.
+_GLOBAL_RPS = int(os.environ.get("MLX_VLM_INKLING2_EV_GLOBAL_RPS", "2"))
+# Lane-parallel variant (verify_kernels.global_rows_shared2) with simd_sum's
+# butterfly order ("desc" = 16..1, "asc" = 1..16); "" = global_rows_shared.
+_GLOBAL_LANE = os.environ.get("MLX_VLM_INKLING2_EV_GLOBAL_LANE", "asc")
+# "auto": by row count (below); "rows": per-row grid; "shared": as configured.
+_GLOBAL_KERNEL = os.environ.get("MLX_VLM_INKLING2_EV_GLOBAL_KERNEL", "auto")
+# Projections of all rows in one multi-row GEMV (verify_kernels.gemv_m).
+_GEMV_M = os.environ.get("MLX_VLM_INKLING2_EV_GEMV_M", "1") == "1"
+# Rows carried as (R, D) arrays through every per-position kernel (one call
+# per visit instead of one per row; far fewer graph nodes per round).
+_BATCHED = os.environ.get("MLX_VLM_INKLING2_EV_BATCHED", "1") == "1"
+# rel = r @ rel_proj for all rows in one matmul (the K = 16 GEMM per row).
+_REL_BATCHED = os.environ.get("MLX_VLM_INKLING2_EV_REL_BATCHED", "1") == "1"
+# The head GEMV of all rows in one call (kernels.head_logits, M rows).
+_HEAD_M = os.environ.get("MLX_VLM_INKLING2_EV_HEAD_M", "1") == "1"
+# o_proj tails / MoE of all rows in one call each (verify_kernels).
+_OTAIL_M = os.environ.get("MLX_VLM_INKLING2_EV_OTAIL_M", "1") == "1"
+_MOE_M = os.environ.get("MLX_VLM_INKLING2_EV_MOE_M", "1") == "1"
+
+
+def _flags_ok():
+    """The decode step's fused paths this verifier replicates."""
+    from . import language as L
+    from ..inkling2_loop import language as LL
+
+    return (
+        L._FUSED_CONV_STEP and L._OWN_CONV_STATE and L._FUSED_ATTN_RES
+        and L._FUSED_MLP_TAIL and L._FUSED_ATTN_TAIL and L._FUSED_NORM_CAST
+        and L._FUSED_ROUTER and L._FUSED_L2_CLIP and L._FUSED_MOE and L._FUSED_O_TAIL
+        and L._SLIDING_SDPA and L._GATE_IN_ATTN and not L._FUSED_CONV_HEAD
+        and L._FUSED_RES_NORM and L._FUSED_ATTN_RES_MULTI and not L._ROUTER_TOPK
+        and not L._KV_AFTER and len(L._CUSTOM_GEMV) == 3 and LL._FUSED_MSG_GATE
+    )
+
+
+class _RowConv(StepConvCache):
+    """StepConvCache that records the state after each row per index."""
+
+    def __init__(self, states):
+        super().__init__(states)
+        self.after = {i: [] for i in range(len(states))}
+
+    def record(self, *indices):
+        for i in indices:
+            self.after[i].append(self.cache[i])
+
+
+def _projections_rows(attn, parts):
+    """Attention._decode_projections for every row; parts: per row (x,
+    key_input, value_input). With _GEMV_M the rows share each weight read
+    (verify_kernels.gemv_m: per row the decode GEMV's arithmetic)."""
+    if not _GEMV_M:
+        out = []
+        for x, ki, vi in parts:
+            fused = attn._decode_projections(x, ki, vi)
+            if fused is None:
+                raise RuntimeError("exact verify: fused decode projections unavailable")
+            out.append(fused)
+        return out
+    from . import language as L
+    from .verify_kernels import gemv_m
+
+    fused = attn.__dict__.get("_fused_qrgkv")
+    if fused is None or attn.sharding_group is not None or L._CUSTOM_GEMV != (1, 8, 18):
+        raise RuntimeError("exact verify: fused decode projections unavailable")
+    widths = [attn[n].weight.shape[0] for n in ("q_proj", "r_proj", "gate_proj", "k_proj")]
+    cuts = [sum(widths[: i + 1]) for i in range(4)]
+    m = len(parts)
+    xs = mx.concatenate([p[0].reshape(1, -1) for p in parts])
+    out = []
+    if all(ki is x and vi is x for x, ki, vi in parts):
+        y = gemv_m(xs, fused)
+        for r in range(m):
+            q, rr, g, k, v = mx.split(y[r].reshape(1, 1, -1), cuts, axis=-1)
+            out.append((q, k, v, rr, g))
+        return out
+    yq = gemv_m(xs, fused[: cuts[2]])
+    yk = gemv_m(mx.concatenate([p[1].reshape(1, -1) for p in parts]), attn.k_proj.weight)
+    yv = gemv_m(mx.concatenate([p[2].reshape(1, -1) for p in parts]), attn.v_proj.weight)
+    for r in range(m):
+        q, rr, g = mx.split(yq[r].reshape(1, 1, -1), cuts[:2], axis=-1)
+        out.append((q, yk[r].reshape(1, 1, -1), yv[r].reshape(1, 1, -1), rr, g))
+    return out
+
+
+def _attn_pre(attn, x, key_input, value_input, conv, offset, fused):
+    """Attention.__call__ for one decode token up to the attention, given its
+    projections: returns (q, k, v, rel, sinks, gate) as the decode step's
+    _decode_attention_gated receives / computes them."""
+    from . import language as L
+
+    cfg = attn.config
+    q_rows, k, v, r_rows, gate_rows = fused
+    if attn.is_sliding:
+        k = attn.k_sconv(k, conv, None)
+        v = attn.v_sconv(v, conv, None)
+    else:
+        k = attn.k_sconv(k, key_input, conv, None)
+        v = attn.v_sconv(v, value_input, conv, None)
+    q = L._l2_clip(
+        q_rows.reshape(1, 1, attn.n_heads, attn.head_dim),
+        cfg.qk_l2_clip_threshold,
+        attn.q_scale,
+    )
+    k = L._l2_clip(
+        k.reshape(1, 1, attn.n_kv, attn.head_dim), cfg.qk_l2_clip_threshold
+    )
+    v = v.reshape(1, 1, attn.n_kv, attn.head_dim)
+    if cfg.use_value_norm_no_gamma:
+        if not (
+            v.dtype == x.dtype == mx.bfloat16
+            and attn.head_dim % 128 == 0
+            and attn.head_dim // 4 <= 1024
+        ):
+            raise RuntimeError("exact verify: value norm path")
+        from .kernels import rms_norm_cast
+
+        v = rms_norm_cast(v, None, cfg.rms_norm_eps, x.dtype)
+    r = L._l2_clip(
+        r_rows.reshape(1, 1, attn.n_heads, cfg.d_rel),
+        cfg.rel_l2_clip_threshold,
+        attn.rel_scale,
+    )
+    if not attn.is_sliding and cfg.log_scaling_n_floor is not None:
+        positions = L._const_arange(1) + mx.array(offset)[..., None] + 1
+        tau = 1 + cfg.log_scaling_alpha * mx.log(
+            mx.maximum(positions / cfg.log_scaling_n_floor, 1)
+        )
+        q = (q.astype(mx.float32) * tau[..., None, None]).astype(x.dtype)
+        r = (r.astype(mx.float32) * tau[..., None, None]).astype(x.dtype)
+    q, k, v = (a.transpose(0, 2, 1, 3) for a in (q, k, v))
+    rel = r[0, 0] @ attn.rel_proj.astype(x.dtype)
+    sinks = attn.sink_proj(x)[0, 0]
+    return q, k, v, rel, sinks, gate_rows
+
+
+class ExactVerifier:
+    def __init__(self, lm, block, capture_layer_ids):
+        from .fast_decode import prepare_decode
+
+        prepare_decode(lm)
+        self.lm = lm
+        self.block = int(block)
+        self.capture_layer_ids = tuple(capture_layer_ids)
+        self.kinds = None
+        self.fn = mx.compile(self._step_batched if _BATCHED else self._step)
+
+    # ------------------------------------------------------------------
+    def _visit(self, layer, rows, cache_kv, conv, kind, offset, idx, messages):
+        """One layer visit for every row. rows: list of dicts with x, blocks."""
+        from . import language as L
+        from .verify_kernels import global_rows, sliding_rows
+
+        R = len(rows)
+        attn = layer.self_attn
+        dtype = rows[0]["x"].dtype
+        # Phase A: attention inputs, projections, k/v convolutions (row order).
+        pre, ins = [], []
+        for r, row in enumerate(rows):
+            x, blocks = row["x"], row["blocks"]
+            msg = None if messages is None else messages[r]
+            if msg is None:
+                normed = (
+                    layer.attention_input.normed(blocks, x, layer.input_layernorm, dtype)
+                    if layer.is_sliding and layer.attention_input is not None
+                    else None
+                )
+                mixed = (
+                    None
+                    if normed is not None
+                    else layer.attention_input(blocks, x)
+                    if layer.attention_input is not None
+                    else x[..., None, :]
+                )
+                if layer.is_sliding:
+                    xin = (
+                        normed
+                        if normed is not None
+                        else L._norm_cast(layer.input_layernorm, mixed[..., 0, :], dtype)
+                    )
+                    parts = (xin, xin, xin)
+                else:
+                    ps = [mixed[..., min(i, mixed.shape[-2] - 1), :] for i in range(3)]
+                    parts = tuple(
+                        L._norm_cast(norm, part, dtype)
+                        for norm, part in zip(
+                            (layer.q_input_layernorm, layer.k_input_layernorm,
+                             layer.v_input_layernorm),
+                            ps,
+                        )
+                    )
+            else:
+                from ..inkling2_loop.language import _batched_qkv_gates
+
+                mixed = layer.attention_input(blocks, x)
+                q_msg, k_msg, v_msg = (msg[..., i, :] for i in range(3))
+                if layer.is_sliding:
+                    shared = mixed[..., 0, :]
+                    ps = (shared, shared, shared)
+                    norms = (layer.input_layernorm,) * 3
+                else:
+                    ps = tuple(mixed[..., i, :] for i in range(3))
+                    norms = (layer.q_input_layernorm, layer.k_input_layernorm,
+                             layer.v_input_layernorm)
+                stack = layer.__dict__.get("_qkv_gate_stack")
+                if stack is None:
+                    raise RuntimeError("exact verify: gate stack missing")
+                gated = _batched_qkv_gates(
+                    stack, layer.q_message_gate.eps, ps, (q_msg, k_msg, v_msg)
+                )
+                if layer.is_sliding:
+                    nrm = L._norm_cast(layer.input_layernorm, gated, dtype)
+                    parts = tuple(nrm[i : i + 1].reshape(x.shape) for i in range(3))
+                else:
+                    parts = tuple(
+                        L._norm_cast(norm, gated[i : i + 1].reshape(x.shape), dtype)
+                        for i, norm in enumerate(norms)
+                    )
+            if layer._tail_args(x, conv, None) is None:
+                raise RuntimeError("exact verify: fused o_proj tail unavailable")
+            ins.append(parts)
+        projs = _projections_rows(attn, ins)
+        for r in range(R):
+            parts = ins[r]
+            q, k, v, rel, sinks, gate = _attn_pre(
+                attn, parts[0], parts[1], parts[2], conv, offset + r, projs[r]
+            )
+            conv.record(attn.k_sconv.conv_idx, attn.v_sconv.conv_idx)
+            pre.append((q, k, v, rel, sinks, gate))
+        # Phase B: the attention of every row.
+        q = mx.concatenate([p[0].reshape(1, attn.n_heads, -1) for p in pre])
+        k_new = mx.concatenate([p[1].reshape(1, attn.n_kv, -1) for p in pre])
+        v_new = mx.concatenate([p[2].reshape(1, attn.n_kv, -1) for p in pre])
+        rel = mx.stack([p[3] for p in pre])
+        gate = mx.concatenate([p[5].reshape(1, -1) for p in pre])
+        scale = attn.head_dim**-0.5
+        keys, values = cache_kv
+        if kind == "g":
+            sinks = mx.stack([p[4] for p in pre])
+            # Measured at 1M (kbench_attn): lane-parallel RPS 2 is fastest for
+            # up to 4 rows (15.7 vs 18.5 ms per visit), the per-row grid for 8
+            # (36.1 vs 41.3 ms).
+            if _GLOBAL_KERNEL == "rows" or (_GLOBAL_KERNEL == "auto" and R > 4):
+                out = global_rows(q, keys, values, k_new, v_new, offset, rel, sinks, gate,
+                                  scale=scale)
+            elif _GLOBAL_RPS > 0 and _GLOBAL_LANE in ("asc", "desc"):
+                from .verify_kernels import global_rows_shared2
+
+                out = global_rows_shared2(q, keys, values, k_new, v_new, offset, rel, sinks,
+                                          gate, scale=scale, rps=_GLOBAL_RPS,
+                                          desc=_GLOBAL_LANE == "desc")
+            elif _GLOBAL_RPS > 0:
+                from .verify_kernels import global_rows_shared
+
+                out = global_rows_shared(q, keys, values, k_new, v_new, offset, rel, sinks,
+                                         gate, scale=scale, rps=_GLOBAL_RPS)
+            else:
+                out = global_rows(q, keys, values, k_new, v_new, offset, rel, sinks, gate,
+                                  scale=scale)
+        else:
+            sinks = mx.stack([p[4].astype(q.dtype) for p in pre])
+            s0 = mx.where(idx == keys.shape[2], 0, idx)
+            out = sliding_rows(q, keys, values, k_new, v_new, s0, rel, sinks, gate,
+                               scale=scale, blocks=L._SLIDING_BLOCKS)
+        new_kv = (k_new, v_new)
+        # Phase C: attention tail, MLP (row order: their convolutions chain).
+        from .gemv_kernels import o_proj_tail
+
+        ai, mi = layer.attn_sconv.conv_idx, layer.mlp_sconv.conv_idx
+        residuals = None
+        if _OTAIL_M:
+            from .verify_kernels import o_proj_tail_m
+
+            state, conv_weight, _, width = layer._tail_args(rows[0]["x"], conv, None)
+            skips = (
+                None
+                if layer.is_block_boundary
+                else mx.concatenate([row["x"].reshape(1, -1) for row in rows])
+            )
+            res_all, st_all = o_proj_tail_m(
+                out.reshape(R, -1), attn.o_proj.weight, state, conv_weight, skips, width
+            )
+            residuals = [res_all[r : r + 1].reshape(1, 1, -1) for r in range(R)]
+            conv.after[ai] = [st_all[r : r + 1] for r in range(R)]
+            conv[ai] = conv.after[ai][-1]
+        moe_inputs = []
+        for r, row in enumerate(rows):
+            x, blocks = row["x"], row["blocks"]
+            if residuals is None:
+                state, conv_weight, skip, width = layer._tail_args(x, conv, None)
+                residual, conv[ai] = o_proj_tail(
+                    out[r].reshape(1, 1, -1), None, attn.o_proj.weight, state, conv_weight,
+                    skip, width,
+                )
+                conv.record(ai)
+            else:
+                residual = residuals[r]
+            row["residual"] = residual
+            if layer.is_block_boundary:
+                blocks.append(x)
+            if messages is None:
+                moe_input = layer.mlp_input.normed(
+                    blocks, residual, layer.post_attention_layernorm, dtype
+                )
+                if moe_input is None:
+                    hidden = layer.mlp_input(blocks, residual)[..., 0, :]
+                    moe_input = L._norm_cast(layer.post_attention_layernorm, hidden, dtype)
+            else:
+                hidden = layer.mlp_input(blocks, residual)[..., 0, :]
+                hidden = layer.mlp_message_gate(hidden, messages[r][..., 3, :])
+                moe_input = L._norm_cast(layer.post_attention_layernorm, hidden, dtype)
+            moe_inputs.append(moe_input)
+        if _MOE_M:
+            from . import moe_kernels
+            from .kernels import router_scores
+            from .verify_kernels import moe_rows
+
+            moe = layer.mlp
+            if not moe_kernels.supported(moe, moe_inputs[0]):
+                raise RuntimeError("exact verify: fused MoE unavailable")
+            routed = [
+                router_scores(mi_, moe.gate_weight, moe.e_score_correction_bias)
+                for mi_ in moe_inputs
+            ]
+            sconv = layer.mlp_sconv
+            outs, st = moe_rows(
+                mx.concatenate([v.reshape(1, -1) for v in moe_inputs]),
+                mx.concatenate([nr.reshape(1, -1) for _, nr in routed]),
+                mx.concatenate([sc.reshape(1, -1) for sc, _ in routed]),
+                moe, conv[mi], sconv.conv.weight,
+                mx.concatenate([row["residual"].reshape(1, -1) for row in rows]),
+                sconv.kernel_size,
+            )
+            for r, row in enumerate(rows):
+                row["x"] = outs[r : r + 1].reshape(1, 1, -1)
+            conv.after[mi] = [st[r : r + 1] for r in range(R)]
+            conv[mi] = conv.after[mi][-1]
+        else:
+            for r, row in enumerate(rows):
+                row["x"] = layer._mlp_tail(moe_inputs[r], row["residual"], conv, None, dtype)
+                conv.record(mi)
+        for row in rows:
+            row.pop("residual", None)
+        return new_kv
+
+    # ------------------------------------------------------------------
+    # Batched rows (_BATCHED): the rows travel as (R, D) arrays and every
+    # per-position decode kernel runs once for all rows (verify_kernels' *_rows
+    # variants: the decode kernel per row, the row picked by grid z); MLX ops
+    # whose result does not depend on the row count (elementwise, rms_norm,
+    # the k=16 rel matmul) run batched; the GEMVs MLX dispatches differently
+    # for more rows (sink_proj, the dynamic conv weights) stay per row.
+    def _visit_batched(self, layer, x, blocks, kv_state, conv0, kind, offset, idx, messages):
+        from . import language as L
+        from .kernels import l2_clip_rows, rms_norm_cast
+        from .verify_kernels import (
+            attn_res_multi_rows, attn_res_q1_norm_rows, attn_res_q1_rows, conv_rows,
+            gemv_m, global_rows, global_rows_shared2, message_gates_rows, moe_rows,
+            o_proj_tail_m, router_rows, sliding_rows,
+        )
+
+        R, D = x.shape
+        attn = layer.self_attn
+        cfg = attn.config
+        dtype = x.dtype
+        res_scale = D**-0.5
+        if messages is None:
+            if layer.is_sliding:
+                if layer.attention_input is not None:
+                    xin = attn_res_q1_norm_rows(
+                        blocks + [x], layer.attention_input.query, res_scale,
+                        layer.input_layernorm.weight, layer.input_layernorm.eps, dtype,
+                    )
+                else:
+                    xin = L._norm_cast(layer.input_layernorm, x, dtype)
+                qin = kin = vin = xin
+            else:
+                mixed = attn_res_multi_rows(blocks + [x], layer.attention_input.query, res_scale)
+                qin, kin, vin = (
+                    rms_norm_cast(mx.contiguous(mixed[:, i, :]), norm.weight, norm.eps, dtype)
+                    for i, norm in enumerate(
+                        (layer.q_input_layernorm, layer.k_input_layernorm, layer.v_input_layernorm)
+                    )
+                )
+        else:
+            from ..inkling2_loop.language import _MSG_COMBINE
+
+            if layer.is_sliding:
+                shared = attn_res_q1_rows(blocks + [x], layer.attention_input.query, res_scale)
+                ps = (shared, shared, shared)
+            else:
+                mixed = attn_res_multi_rows(blocks + [x], layer.attention_input.query, res_scale)
+                ps = tuple(mx.contiguous(mixed[:, i, :]) for i in range(3))
+            down, forget_w, gain_w = layer.__dict__["_qkv_gate_stack"]
+            gated = message_gates_rows(
+                list(ps), [mx.contiguous(messages[:, i, :]) for i in range(3)],
+                down, forget_w, gain_w, layer.q_message_gate.eps, combine=_MSG_COMBINE,
+            )
+            if layer.is_sliding:
+                nrm = rms_norm_cast(gated, layer.input_layernorm.weight,
+                                    layer.input_layernorm.eps, dtype)
+                qin, kin, vin = (mx.contiguous(nrm[:, i, :]) for i in range(3))
+            else:
+                qin, kin, vin = (
+                    rms_norm_cast(mx.contiguous(gated[:, i, :]), norm.weight, norm.eps, dtype)
+                    for i, norm in enumerate(
+                        (layer.q_input_layernorm, layer.k_input_layernorm, layer.v_input_layernorm)
+                    )
+                )
+        # projections (each weight read once)
+        fused = attn.__dict__["_fused_qrgkv"]
+        widths = [attn[n].weight.shape[0] for n in ("q_proj", "r_proj", "gate_proj", "k_proj")]
+        cuts = [sum(widths[: i + 1]) for i in range(4)]
+        if qin is kin and qin is vin:
+            y = gemv_m(qin, fused)
+            q, r, g, k, v = (y[:, a:b] for a, b in zip([0] + cuts, cuts + [y.shape[1]]))
+        else:
+            y = gemv_m(qin, fused[: cuts[2]])
+            q, r, g = (y[:, a:b] for a, b in zip([0] + cuts[:2], cuts[:2] + [cuts[2]]))
+            k = gemv_m(kin, attn.k_proj.weight)
+            v = gemv_m(vin, attn.v_proj.weight)
+        # k / v short convolutions; the state after every row
+        kc, vc = attn.k_sconv.conv_idx, attn.v_sconv.conv_idx
+        after = {}
+        if attn.is_sliding:
+            k, after[kc] = conv_rows(conv0[kc], attn.k_sconv.conv.weight, k, attn.k_sconv.kernel_size)
+            v, after[vc] = conv_rows(conv0[vc], attn.v_sconv.conv.weight, v, attn.v_sconv.kernel_size)
+        else:
+            outs = []
+            for sconv, val, dyn, ci in ((attn.k_sconv, k, kin, kc), (attn.v_sconv, v, vin, vc)):
+                # DynamicShortConvolution.__call__ for the R rows (length R).
+                kk = sconv.kernel_size
+                xf = val.reshape(1, R, -1).astype(mx.float32)
+                context = mx.concatenate([conv0[ci], xf], axis=1)
+                after[ci] = mx.stack([context[0, j + 1 : j + kk] for j in range(R)])
+                dynamic = mx.concatenate(
+                    [sconv.weight_proj(dyn[j : j + 1].reshape(1, 1, -1)) for j in range(R)], axis=1
+                ).astype(mx.float32).reshape(1, R, sconv.num_heads, 1, kk)
+                weights = sconv.static_weight.T.reshape(sconv.num_heads, -1, kk) + dynamic
+                out = mx.zeros_like(xf).reshape(1, R, sconv.num_heads, -1)
+                for lag in range(kk):
+                    values = context[:, kk - 1 - lag : kk - 1 - lag + R].reshape(out.shape)
+                    out = out + values * weights[..., lag]
+                outs.append(
+                    ((out.reshape(xf.shape) + xf) / __import__("math").sqrt(2 * kk + 1)).astype(val.dtype)
+                )
+            k, v = (o.reshape(R, -1) for o in outs)
+        H, HKV, HD = attn.n_heads, attn.n_kv, attn.head_dim
+        q = l2_clip_rows(q.reshape(1, R, H, HD), cfg.qk_l2_clip_threshold, attn.q_scale)
+        k = l2_clip_rows(k.reshape(1, R, HKV, HD), cfg.qk_l2_clip_threshold)
+        v = rms_norm_cast(v.reshape(1, R, HKV, HD), None, cfg.rms_norm_eps, dtype)
+        r = l2_clip_rows(r.reshape(1, R, H, cfg.d_rel), cfg.rel_l2_clip_threshold, attn.rel_scale)
+        if not attn.is_sliding and cfg.log_scaling_n_floor is not None:
+            positions = (mx.arange(R, dtype=mx.int32) + offset).reshape(1, R) + 1
+            tau = 1 + cfg.log_scaling_alpha * mx.log(
+                mx.maximum(positions / cfg.log_scaling_n_floor, 1)
+            )
+            q = (q.astype(mx.float32) * tau[..., None, None]).astype(dtype)
+            r = (r.astype(mx.float32) * tau[..., None, None]).astype(dtype)
+        if _REL_BATCHED:
+            rel = (r.reshape(R * H, cfg.d_rel) @ attn.rel_proj.astype(dtype)).reshape(R, H, -1)
+        else:
+            rel = mx.stack([r[0, j] @ attn.rel_proj.astype(dtype) for j in range(R)])
+        sinks = mx.stack([attn.sink_proj(qin[j : j + 1].reshape(1, 1, -1))[0, 0] for j in range(R)])
+        q = q.reshape(R, H, HD)
+        k_new = k.reshape(R, HKV, HD)
+        v_new = v.reshape(R, HKV, HD)
+        keys, values = kv_state
+        scale = HD**-0.5
+        if kind == "g":
+            if _GLOBAL_KERNEL == "rows" or (_GLOBAL_KERNEL == "auto" and R > 4):
+                out = global_rows(q, keys, values, k_new, v_new, offset, rel, sinks, g,
+                                  scale=scale)
+            else:
+                out = global_rows_shared2(q, keys, values, k_new, v_new, offset, rel, sinks, g,
+                                          scale=scale, rps=_GLOBAL_RPS,
+                                          desc=_GLOBAL_LANE == "desc")
+        else:
+            s0 = mx.where(idx == keys.shape[2], 0, idx)
+            out = sliding_rows(q, keys, values, k_new, v_new, s0, rel, sinks.astype(dtype), g,
+                               scale=scale, blocks=L._SLIDING_BLOCKS)
+        # attention tails
+        ac, mc = layer.attn_sconv.conv_idx, layer.mlp_sconv.conv_idx
+        sconv = layer.attn_sconv
+        residual, after[ac] = o_proj_tail_m(
+            out.reshape(R, -1), attn.o_proj.weight, conv0[ac], sconv.conv.weight,
+            None if layer.is_block_boundary else x, sconv.kernel_size,
+        )
+        if layer.is_block_boundary:
+            blocks.append(x)
+        if messages is None:
+            moe_input = attn_res_q1_norm_rows(
+                blocks + [residual], layer.mlp_input.query, res_scale,
+                layer.post_attention_layernorm.weight, layer.post_attention_layernorm.eps, dtype,
+            )
+        else:
+            from ..inkling2_loop.language import _MSG_COMBINE
+
+            hidden = attn_res_q1_rows(blocks + [residual], layer.mlp_input.query, res_scale)
+            gate = layer.mlp_message_gate
+            hidden = message_gates_rows(
+                [hidden], [mx.contiguous(messages[:, 3, :])], gate.down_proj.weight[None],
+                gate.forget_gate_proj.weight[None], gate.message_gate_proj.weight[None],
+                gate.eps, combine=_MSG_COMBINE,
+            ).reshape(R, -1)
+            moe_input = rms_norm_cast(hidden, layer.post_attention_layernorm.weight,
+                                      layer.post_attention_layernorm.eps, dtype)
+        moe = layer.mlp
+        scores, neg = router_rows(moe_input, moe.gate_weight, moe.e_score_correction_bias)
+        msc = layer.mlp_sconv
+        x_out, after[mc] = moe_rows(
+            moe_input, neg, scores, moe, conv0[mc], msc.conv.weight, residual, msc.kernel_size
+        )
+        return x_out, (k_new, v_new), after
+
+    def _step_batched(self, tokens, offset, idx, *states):
+        lm = self.lm
+        tm = lm.model
+        cfg = tm.config
+        R = self.block
+        requested = set(self.capture_layer_ids)
+        x = tm.embed(tokens).reshape(R, -1)
+        blocks = []
+        captures = {}
+        start = cfg.loop_layer_index_start
+        pre_loop = previous = None
+        per_cache = {}
+        from .verify_kernels import attn_res_multi_rows, attn_res_q1_rows
+
+        for step, (i, cache_idx, p) in enumerate(tm.schedule()):
+            layer = tm.layers[i]
+            if i == start:
+                if p == 0:
+                    pre_loop = (x, list(blocks))
+                else:
+                    previous = (blocks[len(pre_loop[1]) + 1 :], x)
+                    x, blocks = pre_loop[0], list(pre_loop[1])
+            if step in requested:
+                captures[step] = x
+            kind = self.kinds[cache_idx]
+            keys, values, c0, c1, c2, c3 = states[6 * cache_idx : 6 * cache_idx + 6]
+            messages = None
+            if p > 0:
+                mi = tm.message_input
+                query = mi.query[i - start : i - start + 1].reshape(mi.query.shape[1:])
+                messages = attn_res_multi_rows(
+                    list(previous[0]) + [previous[1]], query, previous[1].shape[-1] ** -0.5
+                )
+            x, kv_new, after = self._visit_batched(
+                layer, x, blocks, (keys, values), (c0, c1, c2, c3), kind, offset, idx, messages
+            )
+            per_cache[cache_idx] = (kv_new, [
+                mx.concatenate([(c0, c1, c2, c3)[j], after[j].reshape(R, *after[j].shape[-2:])])
+                .reshape(R + 1, 1, *after[j].shape[-2:])
+                for j in range(4)
+            ])
+        total = cfg.total_num_hidden_layers
+        h = attn_res_q1_rows(blocks + [x], tm.final_input.query, x.shape[-1] ** -0.5)
+        if total in requested:
+            captures[total] = tm.norm(h).astype(x.dtype)
+        from .kernels import head_logits
+
+        hn = lm.model.norm(h).astype(tm.embed_norm.weight.dtype).astype(mx.float32)
+        logits = head_logits(hn, lm.lm_head.weight).reshape(R, 1, -1)
+        cap = lm.config.final_logit_softcapping
+        if cap:
+            logits = mx.tanh(logits / cap) * cap
+        logits = logits[..., : lm.config.unpadded_vocab_size][:, -1, :]
+        logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+        target = mx.argmax(logprobs, axis=-1).reshape(1, R)
+        captured = [captures[c].reshape(1, R, -1) for c in self.capture_layer_ids]
+        out = [target, logprobs, *captured]
+        for cache_idx in range(len(self.kinds)):
+            (k_new, v_new), convs = per_cache[cache_idx]
+            out += [k_new, v_new, *convs]
+        return tuple(out)
+
+    # ------------------------------------------------------------------
+    def _step(self, tokens, offset, idx, *states):
+        lm = self.lm
+        tm = lm.model
+        cfg = tm.config
+        R = self.block
+        requested = set(self.capture_layer_ids)
+        x_all = tm.embed(tokens)  # (1, R, hidden): per-row Embedding + RMSNorm
+        rows = [{"x": x_all[:, r : r + 1], "blocks": []} for r in range(R)]
+        captures = {}
+        convs, kv_out = [], []
+        n = 0
+        start = cfg.loop_layer_index_start
+        pre_loop, previous = [None] * R, [None] * R
+        for step, (i, cache_idx, p) in enumerate(tm.schedule()):
+            layer = tm.layers[i]
+            if i == start:
+                for r, row in enumerate(rows):
+                    if p == 0:
+                        pre_loop[r] = (row["x"], list(row["blocks"]))
+                    else:
+                        previous[r] = (row["blocks"][len(pre_loop[r][1]) + 1 :], row["x"])
+                        row["x"], row["blocks"] = pre_loop[r][0], list(pre_loop[r][1])
+            if step in requested:
+                captures[step] = [row["x"] for row in rows]
+            kind = self.kinds[cache_idx]
+            keys, values, c0, c1, c2, c3 = states[6 * cache_idx : 6 * cache_idx + 6]
+            conv = _RowConv((c0, c1, c2, c3))
+            messages = None
+            if p > 0:
+                messages = [
+                    tm.message_input(previous[r][0], previous[r][1], i - start)
+                    for r in range(R)
+                ]
+            new_kv = self._visit(layer, rows, (keys, values), conv, kind, offset, idx, messages)
+            convs.append((cache_idx, conv))
+            kv_out.append((cache_idx, new_kv))
+        total = cfg.total_num_hidden_layers
+        heads = []
+        normalized = []
+        for row in rows:
+            h = tm.final_input(row["blocks"], row["x"])[..., 0, :]
+            normalized.append(tm.norm(h).astype(row["x"].dtype))
+            heads.append(h)
+        if total in requested:
+            captures[total] = normalized
+        ys, lps = [], []
+        if _HEAD_M:
+            # LanguageModel._logits_from_norm with the head GEMV of all rows in
+            # one kernels.head_logits call (its rows are independent: same
+            # per-row arithmetic for any M); the rest per row as before.
+            from .kernels import head_logits
+
+            hs = [
+                lm.model.norm(h).astype(tm.embed_norm.weight.dtype).astype(mx.float32)
+                for h in heads
+            ]
+            all_logits = head_logits(
+                mx.concatenate([x.reshape(1, -1) for x in hs]), lm.lm_head.weight
+            )
+            cap = lm.config.final_logit_softcapping
+            for r in range(R):
+                logits = all_logits[r : r + 1].reshape(1, 1, -1)
+                if cap:
+                    logits = mx.tanh(logits / cap) * cap
+                logits = logits[..., : lm.config.unpadded_vocab_size][:, -1, :]
+                logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+                ys.append(mx.argmax(logprobs, axis=-1))
+                lps.append(logprobs)
+        else:
+            for h in heads:
+                # LanguageModel.__call__ (skip_final_norm) + fast_decode's step.
+                logits = lm._logits_from_norm(lm.model.norm(h))[:, -1, :]
+                logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+                ys.append(mx.argmax(logprobs, axis=-1))
+                lps.append(logprobs)
+        target = mx.concatenate(ys).reshape(1, R)
+        logprobs = mx.concatenate(lps)
+        captured = [
+            mx.concatenate(captures[c], axis=1) for c in self.capture_layer_ids
+        ]
+        # Per cache entry: K rows, V rows, then for each conv index the R + 1
+        # states (initial, after row 0, ..., after row R - 1).
+        out = [target, logprobs, *captured]
+        conv_by_idx = dict(convs)
+        kv_by_idx = dict(kv_out)
+        for cache_idx in range(len(self.kinds)):
+            k_new, v_new = kv_by_idx[cache_idx]
+            out += [k_new, v_new]
+            conv = conv_by_idx[cache_idx]
+            for j in range(4):
+                if len(conv.after[j]) != R:
+                    raise RuntimeError("exact verify: conv state records")
+                out.append(mx.stack([states[6 * cache_idx + 2 + j], *conv.after[j]]))
+        return tuple(out)
+
+    def __call__(self, tokens, cache):
+        from .fast_verify import _layout
+
+        layout = _layout(cache, self.block)
+        if layout is None or tokens.shape != (1, self.block):
+            return None
+        kinds, offset, idx = layout
+        from .language import _DECODE_KERNEL_MIN_KEYS
+
+        if offset + 1 < _DECODE_KERNEL_MIN_KEYS:
+            return None
+        if self.kinds is None:
+            self.kinds = kinds
+        elif self.kinds != kinds:
+            return None
+        states = []
+        for entry in cache:
+            kv, conv = entry.caches
+            states.extend((kv.keys, kv.values, *conv.cache))
+        outs = self.fn(
+            tokens,
+            mx.array(offset, dtype=mx.int32),
+            mx.array(idx, dtype=mx.int32),
+            *states,
+        )
+        del states
+        nc = len(self.capture_layer_ids)
+        target, logprobs = outs[0], outs[1]
+        captured = list(outs[2 : 2 + nc])
+        flat = outs[2 + nc :]
+        per = [flat[6 * i : 6 * i + 6] for i in range(len(kinds))]
+        self.last_logprobs = logprobs
+        txn = ExactVerifyTransaction(cache, self.block, kinds, per)
+        txn.logprobs = logprobs
+        return captured, txn, target
+
+
+class ExactVerifyTransaction:
+    def __init__(self, cache, block, kinds, per):
+        self.cache, self.block, self.kinds, self.per = cache, block, kinds, per
+        self.active = True
+
+    def commit(self, lengths):
+        if not self.active:
+            raise RuntimeError("exact verifier transaction is no longer active")
+        if len(lengths) != 1:
+            raise ValueError("exact Inkling2 verifier supports batch size one")
+        keep = int(lengths[0])
+        if not 1 <= keep <= self.block:
+            raise ValueError("invalid exact verifier commit length")
+        for entry, kind, part in zip(self.cache, self.kinds, self.per):
+            kv, conv = entry.caches
+            k_new, v_new = part[0][:keep], part[1][:keep]
+            # (keep, HKV, D) -> (1, HKV, keep, D)
+            k_new = k_new.transpose(1, 0, 2)[None]
+            v_new = v_new.transpose(1, 0, 2)[None]
+            if kind == "g":
+                start = mx.array([kv.offset], dtype=mx.int32)
+                keys, values = kv.keys, kv.values
+                kv.keys = kv.values = None
+                kv.keys = mx.slice_update(keys, k_new, start, axes=(2,))
+                kv.values = mx.slice_update(values, v_new, start, axes=(2,))
+                del keys, values
+                kv.offset += keep
+            else:
+                # RotatingKVCache._update_in_place on a full ring, row after
+                # row, as at most two slice writes (the same slots and state).
+                done = 0
+                while done < keep:
+                    if kv._idx == kv.max_size:
+                        kv._idx = kv.keep
+                    take = min(keep - done, kv.max_size - kv._idx)
+                    kv.keys[..., kv._idx : kv._idx + take, :] = k_new[..., done : done + take, :]
+                    kv.values[..., kv._idx : kv._idx + take, :] = v_new[..., done : done + take, :]
+                    kv.offset += take
+                    kv._idx += take
+                    done += take
+            for j in range(4):
+                conv.cache[j] = part[2 + j][keep]
+        self.active = False
+
+    def abort(self):
+        self.active = False
+
+
+class SequentialExactVerify:
+    """A verify block decoded token by token through the model's own
+    single-token decode path (exactly ar.generate_step's eager step), stopping
+    at the first token that differs from the block's next input. Used in exact
+    mode where the k-row verifier cannot serve (fewer keys than the compiled
+    decode step needs, or no reserved room). Rows not evaluated report -1."""
+
+    def __init__(self, cache, processed, logprobs):
+        self.cache, self.processed, self.logprobs = cache, processed, logprobs
+        self.active = True
+
+    def commit(self, lengths):
+        if int(lengths[0]) != self.processed:
+            raise RuntimeError("sequential exact verify: commit length mismatch")
+        self.active = False
+
+    def abort(self):
+        self.active = False
+
+
+def sequential_verify(lm, tokens, cache, capture_layer_ids):
+    k = tokens.shape[1]
+    toks = tokens.reshape(-1).tolist()
+    targets, lps, caps = [], [], []
+    for i in range(k):
+        out = lm(
+            mx.array([[toks[i]]], dtype=tokens.dtype),
+            cache=cache,
+            capture_layer_ids=list(capture_layer_ids),
+            logits_to_keep=1,
+        )
+        logits = out.logits[:, -1, :]
+        logprobs = logits - mx.logsumexp(logits, axis=-1, keepdims=True)
+        y = mx.argmax(logprobs, axis=-1)
+        caps.append(out.hidden_states)
+        lps.append(logprobs)
+        t = int(y.item())
+        targets.append(t)
+        if i + 1 >= k or t != toks[i + 1]:
+            break
+    n = len(targets)
+    target = mx.array([targets + [-1] * (k - n)], dtype=mx.int32)
+    captured = [mx.concatenate([c[j] for c in caps], axis=1) for j in range(len(caps[0]))]
+    return captured, SequentialExactVerify(cache, n, mx.concatenate(lps)), target
+
+
+def exact_verify(lm, tokens, cache, capture_layer_ids):
+    if not _ENABLED or tokens.shape[0] != 1 or not _flags_ok():
+        return None
+    key = (tokens.shape[1], tuple(capture_layer_ids))
+    verifiers = lm.__dict__.setdefault("_exact_speculative_verifiers", {})
+    verifier = verifiers.get(key)
+    if verifier is None:
+        verifier = ExactVerifier(lm, *key)
+        verifiers[key] = verifier
+    return verifier(tokens, cache)
