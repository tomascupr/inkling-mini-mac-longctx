+"""One compiled graph per single-token decode step (Inkling 2 / 2-loop).
+
+The eager decode step builds ~13k lazy nodes in Python (~5 ms) and encodes
+~7k kernels per token. Compiling the whole step removes the Python graph build
+and fuses the elementwise glue into fewer kernels. The step reads functional
+views of the caches (step_cache.py), so its shapes are constant and its trace is
+reused for every token; the caches' Python objects are updated afterwards.
+
+The step runs the model's own decode code on the same inputs, so it performs
+the same operations in the same order; it is used only where the eager path
+would take the same branches: every global cache already holds at least
+_DECODE_KERNEL_MIN_KEYS - 1 keys and has room for one more, and every sliding
+ring is full.
+"""
+
+import os
+
+import mlx.core as mx
+
+from ..cache import ArraysCache, CacheList, KVCache, RotatingKVCache
+from .step_cache import StepConvCache, StepKVCache, StepRotatingKVCache
+
+_ENABLED = os.environ.get("MLX_VLM_INKLING2_COMPILED_DECODE", "1") == "1"
+_PREP = set(
+    os.environ.get("MLX_VLM_INKLING2_DECODE_PREP", "precast,factor,catproj").split(",")
+)
+_FUSED = ("q_proj", "r_proj", "gate_proj", "k_proj", "v_proj")
+_MESSAGE_GATES = ("q_message_gate", "k_message_gate", "v_message_gate", "mlp_message_gate")
+
+
+def prepare_decode(lm):
+    """One-time weight layout for decode. Changes no value that is computed:
+    - FP32 copies of the router and loop-gate weights that every step casts
+      to FP32 anyway (the casts become no-ops);
+    - the NVFP4 experts' per-expert kernel factor, stored once;
+    - the same-input attention projections stored as one row-wise
+      concatenation, each projection's weight a view of its rows (memory is
+      unchanged; Attention._decode_projections reads them in one GEMV)."""
+    import mlx.nn as nn
+
+    if lm.__dict__.get("_decode_prepared"):
+        return
+    lm.__dict__["_decode_prepared"] = True
+    for layer in lm.model.layers:
+        attn, moe = layer.self_attn, layer.mlp
+        new = []
+        if "precast" in _PREP:
+            if moe.gate_weight.dtype != mx.float32:
+                moe.gate_weight = moe.gate_weight.astype(mx.float32)
+                new.append(moe.gate_weight)
+            for name in _MESSAGE_GATES:
+                gate = getattr(layer, name, None)
+                if gate is None:
+                    continue
+                for proj in (gate.forget_gate_proj, gate.message_gate_proj):
+                    if proj.weight.dtype != mx.float32:
+                        proj.weight = proj.weight.astype(mx.float32)
+                        new.append(proj.weight)
+        if "factor" in _PREP:
+            for name in ("gate_proj", "up_proj", "down_proj"):
+                proj = getattr(moe.switch_mlp, name)
+                if hasattr(proj, "decode_factor"):
+                    proj.decode_factor()
+        if (
+            "catproj" in _PREP
+            and attn.sharding_group is None
+            and attn.__dict__.get("_fused_qrgkv") is None
+            and all(
+                type(attn[n]) is nn.Linear and "bias" not in attn[n] for n in _FUSED
+            )
+        ):
+            weights = [attn[n].weight for n in _FUSED]
+            if len({(w.dtype, w.shape[1]) for w in weights}) == 1:
+                fused = mx.concatenate(weights, axis=0)
+                mx.eval(fused)
+                start = 0
+                for n, w in zip(_FUSED, weights):
+                    attn[n].weight = fused[start : start + w.shape[0]]
+                    new.append(attn[n].weight)
+                    start += w.shape[0]
+                attn.__dict__["_fused_qrgkv"] = fused
+                del weights
+        mx.eval(new)
