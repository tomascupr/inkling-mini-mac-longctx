+@lru_cache(maxsize=1)
+def _l2_clip_small_rows():
+    # l2_clip_rows for rows of at most 32 (one thread per row, sequential sum:
+    # MLX's order for such rows) so that many prefill rows fill the GPU.
+    return mx.fast.metal_kernel(
+        name="inkling2_l2_clip_small_rows",
+        input_names=["x", "scale", "threshold"],
+        output_names=["out"],
+        ensure_row_contiguous=True,
+        compile_options={"math_mode": "safe"},
+        source=r"""
+        const int row = int(thread_position_in_grid.x);
+        if (row >= ROWS) return;
+        const int h = row % H;
+        float xs[E];
+        float total = 0;
+        {
+            #pragma clang fp contract(off)
+            for (int i = 0; i < E; ++i) {
+                float xi = float(x[row * E + i]);
+                if (HAS_SCALE) xi = xi * float(scale[h * E + i]);
+                xs[i] = xi;
+                const float sq = xi * xi;
+                total = sq + total;
+            }
+        }
+        const float factor = metal::min(threshold / (metal::precise::sqrt(total) + 1e-6f), 1.0f);
+        for (int i = 0; i < E; ++i) out[row * E + i] = static_cast<T>(xs[i] * factor);
+        """,
+    )
+
+
+def l2_clip_small_rows(x, threshold, scale=None):
+    h, e = x.shape[-2:]
+    rows = x.size // e
+    return _l2_clip_small_rows()(
+        inputs=[x, x if scale is None else scale, mx.array(threshold, mx.float32)],
+        template=[("T", x.dtype), ("ROWS", rows), ("H", h), ("E", e),
+                  ("HAS_SCALE", scale is not None)],
+        grid=(rows, 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=[x.shape],
+        output_dtypes=[x.dtype],
+    )[0]
+
+
