+    def update_and_fetch(self, keys, values):
+        self.new_keys, self.new_values = keys, values
+        idx = mx.where(self._idx == self.max_size, 0, self._idx)
+        order = (mx.arange(self.max_size, dtype=mx.int32) + idx) % self.max_size
+        old_keys = mx.take(self.keys, order, axis=2)
+        old_values = mx.take(self.values, order, axis=2)
+        self.keys = mx.concatenate([old_keys[..., 1:, :], keys], axis=2)
+        self.values = mx.concatenate([old_values[..., 1:, :], values], axis=2)
