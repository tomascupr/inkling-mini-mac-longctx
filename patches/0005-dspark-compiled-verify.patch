diff -ruN a/mlx_vlm/models/inkling2/fast_verify.py b/mlx_vlm/models/inkling2/fast_verify.py
--- a/mlx_vlm/models/inkling2/fast_verify.py	1970-01-01 01:00:00
+++ b/mlx_vlm/models/inkling2/fast_verify.py	2026-11-22 03:36:49
@@ -0,0 +1,272 @@
+"""Fixed-k compiled exact-greedy verifier for Inkling2 DSpark."""
+
+import os
+from functools import lru_cache
+
+import mlx.core as mx
+
+from ..cache import ArraysCache, CacheList, KVCache, RotatingKVCache
+from .step_cache import VerifyConvCache, VerifyKVCache, VerifyRotatingKVCache
+
+
+_ENABLED = os.environ.get("MLX_VLM_INKLING2_COMPILED_VERIFY", "0") == "1"
+_RING_COMMIT = os.environ.get("MLX_VLM_INKLING2_RING_COMMIT", "0") == "1"
+
+
+@lru_cache(maxsize=1)
+def _commit_ring_kernel():
+    source = "uint i = thread_position_in_grid.x;\n"
+    for name in ("keys", "values"):
+        source += (
+            r"""
+        {
+            int B = OLD_shape[0], H = OLD_shape[1], S = OLD_shape[2];
+            int D = OLD_shape[3], total = B * H * S * D;
+            if (i < total) {
+                int d = i % D, t = (i / D) % S;
+                int h = (i / (D * S)) % H, b = i / (D * S * H);
+                int slot = layout[0] == S ? 0 : layout[0];
+                int keep = layout[1];
+                int rel = (t - slot + S) % S;
+                if (rel < keep)
+                    OUT[i] = NEW[b * NEW_strides[0] + h * NEW_strides[1]
+                                     + rel * NEW_strides[2] + d * NEW_strides[3]];
+                else
+                    OUT[i] = OLD[b * OLD_strides[0] + h * OLD_strides[1]
+                                     + t * OLD_strides[2] + d * OLD_strides[3]];
+            }
+        }
+        """.replace("OLD", "old_" + name)
+            .replace("NEW", "new_" + name)
+            .replace("OUT[", "out_" + name + "[")
+        )
+    return mx.fast.metal_kernel(
+        name="inkling2_commit_speculative_ring",
+        input_names=["old_keys", "old_values", "new_keys", "new_values", "layout"],
+        output_names=["out_keys", "out_values"],
+        source=source,
+        ensure_row_contiguous=False,
+    )
+
+
+def _commit_ring(cache, keys, values, keep):
+    if not _RING_COMMIT:
+        for position in range(keep):
+            cache.update_and_fetch(
+                keys[..., position : position + 1, :],
+                values[..., position : position + 1, :],
+            )
+        return
+    if not (
+        mx.metal.is_available()
+        and mx.default_device() == mx.gpu
+        and 0 < keep <= keys.shape[2]
+        and cache.keys.shape[:3] == cache.values.shape[:3]
+        and cache.keys.shape[:2] == keys.shape[:2]
+        and cache.values.shape[:2] == values.shape[:2]
+    ):
+        for position in range(keep):
+            cache.update_and_fetch(
+                keys[..., position : position + 1, :],
+                values[..., position : position + 1, :],
+            )
+        return
+    shapes = [cache.keys.shape, cache.values.shape]
+    cache.keys, cache.values = _commit_ring_kernel()(
+        inputs=[
+            cache.keys,
+            cache.values,
+            keys,
+            values,
+            mx.array([cache._idx, keep], dtype=mx.int32),
+        ],
+        grid=(max(cache.keys.size, cache.values.size), 1, 1),
+        threadgroup=(256, 1, 1),
+        output_shapes=shapes,
+        output_dtypes=[cache.keys.dtype, cache.values.dtype],
+    )
+    slot = 0 if cache._idx == cache.max_size else cache._idx
+    end = slot + keep
+    cache._idx = end - cache.max_size if end > cache.max_size else end
+    cache.offset += keep
+
+
+def _layout(cache, block):
+    kinds, offset, idx = [], None, None
+    for entry in cache:
+        if type(entry) is not CacheList or len(entry.caches) != 2:
+            return None
+        kv, conv = entry.caches
+        if type(conv) is not ArraysCache or any(
+            getattr(conv, name, None) is not None for name in ("left_padding", "lengths")
+        ):
+            return None
+        if any(state is None for state in conv.cache):
+            return None
+        if type(kv) is KVCache:
+            if kv.keys is None or kv.offset + block > kv.keys.shape[2]:
+                return None
+            offset = kv.offset if offset is None else offset
+            if kv.offset != offset:
+                return None
+            kinds.append("g")
+        elif type(kv) is RotatingKVCache:
+            if (
+                kv.keys is None
+                or kv.keep != 0
+                or kv.offset < kv.max_size
+                or kv.keys.shape[2] != kv.max_size
+            ):
+                return None
+            idx = kv._idx if idx is None else idx
+            if kv._idx != idx:
+                return None
+            kinds.append("r")
+        else:
+            return None
+    return (tuple(kinds), offset, idx) if offset is not None and idx is not None else None
+
+
+class CompiledVerifyTransaction:
+    def __init__(self, cache, block, kinds, outputs):
+        self.cache = cache
+        self.block = block
+        self.kinds = kinds
+        self.outputs = outputs
+        self.active = True
+
+    def commit(self, lengths):
+        if not self.active:
+            raise RuntimeError("compiled verifier transaction is no longer active")
+        if len(lengths) != 1:
+            raise ValueError("compiled Inkling2 verifier supports batch size one")
+        keep = int(lengths[0])
+        if not 0 <= keep <= self.block:
+            raise ValueError("invalid compiled verifier commit length")
+        for entry, kind, state in zip(self.cache, self.kinds, self.outputs):
+            kv, conv = entry.caches
+            keys, values, windows = state
+            if kind == "g":
+                # The compiled graph already wrote all k rows beyond the old
+                # offset. Rejected rows are unreachable and will be overwritten.
+                kv.keys, kv.values = keys, values
+                kv.offset += keep
+            else:
+                # Keep the serving cache as a fixed 1024-slot ring. This avoids
+                # the native block path's variable 1023+keep temporary layout.
+                _commit_ring(kv, keys, values, keep)
+            for index, (source, width) in enumerate(windows):
+                conv.cache[index] = mx.contiguous(source[:, keep : keep + width])
+        self.active = False
+
+    def abort(self):
+        # Global outputs contain the original prefix plus unreachable speculative
+        # rows. Restoring them at the old offset is a valid abort state.
+        if not self.active:
+            return
+        for entry, kind, state in zip(self.cache, self.kinds, self.outputs):
+            if kind == "g":
+                entry.caches[0].keys, entry.caches[0].values = state[:2]
+        self.active = False
+
+
+class CompiledVerifier:
+    def __init__(self, lm, block, capture_layer_ids):
+        from .fast_decode import prepare_decode
+
+        prepare_decode(lm)
+        self.lm = lm
+        self.block = int(block)
+        self.capture_layer_ids = tuple(capture_layer_ids)
+        self.kinds = None
+        self.fn = mx.compile(self._step)
+
+    def _step(self, tokens, offset, idx, *states):
+        caches, n = [], 0
+        for kind in self.kinds:
+            keys, values, c0, c1, c2, c3 = states[n : n + 6]
+            n += 6
+            kv = (
+                VerifyKVCache(keys, values, offset)
+                if kind == "g"
+                else VerifyRotatingKVCache(keys, values, idx, keys.shape[2])
+            )
+            caches.append((kv, VerifyConvCache((c0, c1, c2, c3))))
+
+        out = self.lm(
+            tokens,
+            cache=caches,
+            capture_layer_ids=self.capture_layer_ids,
+        )
+        target_tokens = mx.argmax(out.logits, axis=-1)
+        new = []
+        for kv, conv in caches:
+            keys, values = (
+                (kv.keys, kv.values)
+                if isinstance(kv, VerifyKVCache)
+                else (kv.new_keys, kv.new_values)
+            )
+            windows = []
+            for index in range(4):
+                source, width = conv.records[index]
+                if source.shape[1] - self.block != width:
+                    raise ValueError("unexpected compiled convolution window width")
+                windows.append(source)
+            new.extend((keys, values, *windows))
+        return (target_tokens, *out.hidden_states, *new)
+
+    def __call__(self, tokens, cache):
+        layout = _layout(cache, self.block)
+        if layout is None or tokens.shape != (1, self.block):
+            return None
+        kinds, offset, idx = layout
+        if self.kinds is None:
+            self.kinds = kinds
+        elif self.kinds != kinds:
+            return None
+
+        states = []
+        for entry, kind in zip(cache, kinds):
+            kv, conv = entry.caches
+            states.extend((kv.keys, kv.values, *conv.cache))
+            if kind == "g":
+                kv.keys = kv.values = None
+        outputs = self.fn(
+            tokens,
+            mx.array(offset, dtype=mx.int32),
+            mx.array(idx, dtype=mx.int32),
+            *states,
+        )
+        del states
+        capture_count = len(self.capture_layer_ids)
+        target_tokens = outputs[0]
+        captured = list(outputs[1 : 1 + capture_count])
+        flat = outputs[1 + capture_count :]
+        transaction_states = []
+        stride = 6  # K, V and four convolution window sources.
+        for entry, kind, start in zip(cache, kinds, range(0, len(flat), stride)):
+            part = flat[start : start + stride]
+            keys, values = part[:2]
+            windows = [
+                (part[2 + index], part[2 + index].shape[1] - self.block)
+                for index in range(4)
+            ]
+            transaction_states.append((keys, values, windows))
+            if kind == "g":
+                entry.caches[0].keys, entry.caches[0].values = keys, values
+        transaction = CompiledVerifyTransaction(
+            cache, self.block, kinds, transaction_states
+        )
+        return captured, transaction, target_tokens
+
+
+def compiled_verify(lm, tokens, cache, capture_layer_ids):
+    if not _ENABLED or tokens.shape[0] != 1:
+        return None
+    key = (tokens.shape[1], tuple(capture_layer_ids))
+    verifiers = lm.__dict__.setdefault("_compiled_speculative_verifiers", {})
+    verifier = verifiers.get(key)
+    if verifier is None:
+        verifier = CompiledVerifier(lm, *key)
+        verifiers[key] = verifier
+    return verifier(tokens, cache)
